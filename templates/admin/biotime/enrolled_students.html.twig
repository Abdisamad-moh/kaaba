{% extends 'admin_base2.html.twig' %}

{% block title %}Enrolled Students - BioTime{% endblock %}

{% block body %}
	<!-- Page Header -->
	<div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
		<div class="card-body px-4 py-3">
			<div class="row align-items-center">
				<div class="col-9">
					<h4 class="fw-semibold mb-8">Enrolled Students in BioTime</h4>
					<nav aria-label="breadcrumb">
						<ol class="breadcrumb">
							<li class="breadcrumb-item">
								<a class="text-muted text-decoration-none" href="#">Admin</a>
							</li>
							<li class="breadcrumb-item">
								<a class="text-muted text-decoration-none" href="{{ path('app_admin_biotime_areas') }}">BioTime</a>
							</li>
							<li class="breadcrumb-item active" aria-current="page">Enrolled Students</li>
						</ol>
					</nav>
				</div>
				<div class="col-3">
					<a href="{{ path('app_admin_biotime_enrollment') }}" class="btn btn-primary float-end">
						<i class="ti ti-user-plus me-2"></i>
						Enroll New Students
					</a>
				</div>
			</div>
		</div>
	</div>

	<!-- Statistics Cards -->
	<div class="row mb-4">
		<div class="col-md-3">
			<div class="card bg-primary-subtle">
				<div class="card-body">
					<div class="d-flex align-items-center">
						<div class="me-3">
							<i class="ti ti-users text-primary" style="font-size: 2rem;"></i>
						</div>
						<div>
							<h5 class="card-title mb-1">Total Enrolled</h5>
							<p class="card-text fs-3 mb-0">{{ statistics.total_enrolled }}</p>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="card bg-success-subtle">
				<div class="card-body">
					<div class="d-flex align-items-center">
						<div class="me-3">
							<i class="ti ti-building text-success" style="font-size: 2rem;"></i>
						</div>
						<div>
							<h5 class="card-title mb-1">Institutes</h5>
							<p class="card-text fs-3 mb-0">{{ statistics.total_institutes }}</p>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="card bg-warning-subtle">
				<div class="card-body">
					<div class="d-flex align-items-center">
						<div class="me-3">
							<i class="ti ti-book text-warning" style="font-size: 2rem;"></i>
						</div>
						<div>
							<h5 class="card-title mb-1">Courses</h5>
							<p class="card-text fs-3 mb-0">{{ statistics.total_courses }}</p>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="card bg-info-subtle">
				<div class="card-body">
					<div class="d-flex align-items-center">
						<div class="me-3">
							<i class="ti ti-id text-info" style="font-size: 2rem;"></i>
						</div>
						<div>
							<h5 class="card-title mb-1">BioTime IDs</h5>
							<p class="card-text fs-3 mb-0">{{ statistics.total_biotime_employees }}</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Filter Form -->
	<div class="card mb-4">
		<div class="card-header">
			<h5 class="card-title mb-0">
				<i class="ti ti-filter me-2"></i>
				Filter Enrolled Students
			</h5>
		</div>
		<div class="card-body">
			<form method="get" action="{{ path('app_admin_biotime_enrolled_students') }}" class="row g-3">
				<div class="col-md-3">
					<label for="institute" class="form-label">Institute</label>
					<select class="form-select" id="institute" name="institute">
						<option value="">All Institutes</option>
						{% for institute in institutes %}
							<option value="{{ institute.id }}" {% if filters.institute == institute.id %} selected {% endif %}>
								{{ institute.name }}
							</option>
						{% endfor %}
					</select>
				</div>

				<div class="col-md-3">
					<label for="course" class="form-label">Course</label>
					<select class="form-select" id="course" name="course">
						<option value="">All Courses</option>
						{% for course in courses %}
							<option value="{{ course.id }}" {% if filters.course == course.id %} selected {% endif %}>
								{{ course.name }}
							</option>
						{% endfor %}
					</select>
				</div>

				<div class="col-md-3">
					<label for="employee_code" class="form-label">Employee Code</label>
					<input type="text" class="form-control" id="employee_code" name="employee_code" placeholder="Search by code" value="{{ filters.employee_code }}">
				</div>

				<div class="col-md-3">
					<label class="form-label">Enrollment Date Range</label>
					<div class="row g-2">
						<div class="col">
							<input type="date" class="form-control" name="enrollment_date_from" value="{{ filters.enrollment_date_from }}" placeholder="From">
						</div>
						<div class="col">
							<input type="date" class="form-control" name="enrollment_date_to" value="{{ filters.enrollment_date_to }}" placeholder="To">
						</div>
					</div>
				</div>

				<div class="col-md-12">
					<div class="d-flex gap-2">
						<button type="submit" class="btn btn-primary">
							<i class="ti ti-search me-2"></i>
							Apply Filters
						</button>
						<a href="{{ path('app_admin_biotime_enrolled_students') }}" class="btn btn-secondary">
							<i class="ti ti-refresh me-2"></i>
							Clear Filters
						</a>
						<a href="{{ path('app_admin_biotime_enrolled_students_export') }}?{{ app.request.queryString }}" class="btn btn-success ms-auto">
							<i class="ti ti-download me-2"></i>
							Export CSV
						</a>
					</div>
				</div>
			</form>

			{% if filters.institute or filters.course or filters.employee_code or filters.enrollment_date_from or filters.enrollment_date_to %}
				<div class="alert alert-info mt-3 mb-0">
					<i class="ti ti-filter me-2"></i>
					<strong>Active Filters:</strong>
					{% if filters.institute %}
						<span class="badge bg-primary me-2">
							Institute: {{ institutes|filter(i => i.id == filters.institute)|first.name }}
						</span>
					{% endif %}
					{% if filters.course %}
						<span class="badge bg-success me-2">
							Course: {{ courses|filter(c => c.id == filters.course)|first.name }}
						</span>
					{% endif %}
					{% if filters.employee_code %}
						<span class="badge bg-warning me-2">
							Code: {{ filters.employee_code }}
						</span>
					{% endif %}
					{% if filters.enrollment_date_from or filters.enrollment_date_to %}
						<span class="badge bg-info me-2">
							Date: {{ filters.enrollment_date_from|default('Any') }} to {{ filters.enrollment_date_to|default('Any') }}
						</span>
					{% endif %}
					<a href="{{ path('app_admin_biotime_enrolled_students') }}" class="text-danger ms-2">
						<i class="ti ti-x"></i>
						Clear all
					</a>
				</div>
			{% endif %}
		</div>
	</div>

	<!-- Enrolled Students Table -->
	<div class="card">
		<div class="card-body">
			<div class="d-flex justify-content-between align-items-center mb-3">
				<h5 class="card-title mb-0">
					Enrolled Students ({{ statistics.total_enrolled }})
				</h5>
				<div>
					<span class="badge bg-primary me-2">
						Showing {{ studentDevices|length }} students
					</span>
				</div>
			</div>

			{% if studentDevices|length > 0 %}
				<div class="table-responsive">
					<table class="table table-striped table-hover">
						<thead class="table-light">
							<tr>
								<th width="50">#</th>
								<th width="120">Employee Code</th>
								<th>Full Name</th>
								<th width="150">Institute</th>
								<th width="150">Course</th>
								<th width="120">Phone</th>
								<th width="120">Enrollment Date</th>
								<th width="150">Device/Area</th>
								<th width="150">BioTime ID</th>
								<th width="200" class="text-center">Actions</th>
							</tr>
						</thead>
						<tbody>
							{% for studentDevice in studentDevices %}
								{% set application = studentDevice.getApplication() %}
								<tr>
									<td class="text-muted">{{ loop.index }}</td>
									<td>
										<div class="d-flex flex-column">
											<code class="text-primary">{{ application.biotimeEmployeeCode }}</code>
										</div>
									</td>
									<td>
										<strong>{{ application.fullName }}</strong>
										{% if application.email %}
											<br><small class="text-muted">{{ application.email }}</small>
										{% endif %}
									</td>
									<td>
										{% if application.institute %}
											<span class="badge bg-dark">{{ application.institute.name }}</span>
										{% else %}
											<span class="text-muted">-</span>
										{% endif %}
									</td>
									<td>
										{% if application.course %}
											<span class="badge bg-info">{{ application.course.name }}</span>
										{% else %}
											<span class="text-muted">-</span>
										{% endif %}
									</td>
									<td>
										<code>{{ application.phone }}</code>
									</td>
									<td>
										{% if studentDevice.enrollmentDate %}
											<small class="text-muted">{{ studentDevice.enrollmentDate|date('Y-m-d') }}</small>
											<br><small class="text-muted">{{ studentDevice.enrollmentDate|date('H:i') }}</small>
										{% else %}
											<span class="text-muted">-</span>
										{% endif %}
									</td>
									<td>
										{% if studentDevice.device and studentDevice.device.area %}
											<div class="d-flex flex-column">
												<small class="text-muted">
													<i class="ti ti-map-pin me-1"></i>
													{{ studentDevice.device.area.areaName }}
												</small>
												<small class="text-muted">
													<i class="ti ti-device-desktop me-1"></i>
													{{ studentDevice.device.deviceName }}
												</small>
											</div>
										{% else %}
											<span class="badge bg-warning">No device assigned</span>
										{% endif %}
									</td>
									<td>
										{% if studentDevice.biotimeEmployeeId %}
											<code class="text-success">{{ studentDevice.biotimeEmployeeId|slice(0, 12) }}...</code>
										{% else %}
											<span class="badge bg-danger">No BioTime ID</span>
										{% endif %}
									</td>
									<td class="text-nowrap">
										<div class="btn-group btn-group-sm" role="group">
											{% if studentDevice.device and studentDevice.device.area %}
												<a href="{{ path('app_admin_biotime_enrollment') }}?area={{ studentDevice.device.area.id }}&enroll={{ application.id }}" 
												   class="btn btn-primary"
												   title="Re-enroll/Update"
												   onclick="return confirm('Re-enroll/Update {{ application.fullName }} in {{ studentDevice.device.area.areaName }}?')">
													<i class="ti ti-refresh"></i>
												</a>
											{% endif %}
											
											<button type="button" 
													class="btn btn-info"
													data-bs-toggle="modal" 
													data-bs-target="#studentDetailsModal"
													data-student-id="{{ application.id }}"
													data-student-name="{{ application.fullName }}"
													title="View Details">
												<i class="ti ti-eye"></i>
											</button>
											
											<button type="button" 
													class="btn btn-danger"
													onclick="return confirm('Remove {{ application.fullName }} from BioTime? This will delete their BioTime employee record and student device.')"
													title="Remove from BioTime">
												<i class="ti ti-trash"></i>
											</button>
										</div>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				<!-- Summary Statistics -->
				<div class="row mt-4">
					<div class="col-md-6">
						<div class="card">
							<div class="card-body">
								<h6 class="card-title mb-3">Enrollment Summary</h6>
								<div class="row">
									<div class="col-md-6 mb-3">
										<small class="text-muted d-block">By Institute</small>
										{% for institute, count in instituteGroups %}
											<div class="d-flex justify-content-between align-items-center mb-2">
												<span class="text-truncate" style="max-width: 150px;">{{ institute }}</span>
												<span class="badge bg-primary">{{ count }}</span>
											</div>
										{% else %}
											<div class="text-muted">No data available</div>
										{% endfor %}
									</div>
									<div class="col-md-6">
										<small class="text-muted d-block">By Course</small>
										{% for course, count in courseGroups %}
											<div class="d-flex justify-content-between align-items-center mb-2">
												<span class="text-truncate" style="max-width: 150px;">{{ course }}</span>
												<span class="badge bg-success">{{ count }}</span>
											</div>
										{% else %}
											<div class="text-muted">No data available</div>
										{% endfor %}
									</div>
								</div>
								
								{% if enrollmentByMonth|length > 0 %}
									<hr>
									<small class="text-muted d-block mb-2">Enrollment by Month</small>
									{% for month, count in enrollmentByMonth|slice(-6) %}
										<div class="d-flex justify-content-between align-items-center mb-1">
											<span>{{ month }}</span>
											<span class="badge bg-info">{{ count }}</span>
										</div>
									{% endfor %}
								{% endif %}
							</div>
						</div>
					</div>
					<div class="col-md-6">
						<div class="card">
							<div class="card-body">
								<h6 class="card-title mb-3">Quick Actions</h6>
								<div class="d-grid gap-2">
									<a href="{{ path('app_admin_biotime_enrollment') }}" class="btn btn-primary">
										<i class="ti ti-user-plus me-2"></i>
										Enroll New Students
									</a>
									<a href="{{ path('app_admin_biotime_attendance_sync') }}" class="btn btn-info">
										<i class="ti ti-refresh me-2"></i>
										Sync Attendance for All
									</a>
									<a href="{{ path('app_admin_biotime_enrolled_students_export') }}?{{ app.request.queryString }}" class="btn btn-success">
										<i class="ti ti-download me-2"></i>
										Export Current View
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>

			{% else %}
				<div class="alert alert-info text-center py-5">
					<div class="mb-3">
						<i class="ti ti-users text-primary" style="font-size: 3rem;"></i>
					</div>
					<h5 class="alert-heading">No Enrolled Students Found</h5>
					<p class="mb-3">
						{% if filters.institute or filters.course or filters.employee_code %}
							No students match your filter criteria. Try changing your filters.
						{% else %}
							No students have been enrolled in BioTime yet.
						{% endif %}
					</p>
					<div class="d-flex justify-content-center gap-3">
						<a href="{{ path('app_admin_biotime_enrollment') }}" class="btn btn-primary">
							<i class="ti ti-user-plus me-2"></i>
							Enroll Students
						</a>
						<a href="{{ path('app_admin_biotime_enrolled_students') }}" class="btn btn-secondary">
							<i class="ti ti-refresh me-2"></i>
							Clear Filters
						</a>
					</div>
				</div>
			{% endif %}
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	<script>
		// Student details modal
		const studentDetailsModal = document.getElementById('studentDetailsModal');
		if (studentDetailsModal) {
			studentDetailsModal.addEventListener('show.bs.modal', function(event) {
				const button = event.relatedTarget;
				const studentId = button.getAttribute('data-student-id');
				const studentName = button.getAttribute('data-student-name');
				
				const modalTitle = studentDetailsModal.querySelector('.modal-title');
				const modalBody = studentDetailsModal.querySelector('.modal-body');
				
				modalTitle.textContent = `Student Details: ${studentName}`;
				modalBody.innerHTML = `
					<div class="text-center py-4">
						<i class="ti ti-user-check text-primary" style="font-size: 4rem;"></i>
						<h5 class="mt-3">${studentName}</h5>
						<p class="text-muted">Loading details...</p>
					</div>
				`;
				
				// AJAX call to fetch detailed student info
				fetch(`/admin/biotime/ajax/student-details/${studentId}`)
					.then(response => response.json())
					.then(data => {
						if (data.success) {
							modalBody.innerHTML = `
								<div class="row">
									<div class="col-md-6">
										<h6>Personal Information</h6>
										<p><strong>Student ID:</strong> <code>${data.student.uuid}</code></p>
										<p><strong>BioTime Employee Code:</strong> <code class="text-primary">${data.student.employee_code}</code></p>
										<p><strong>BioTime Employee ID:</strong> <code>${data.student.employee_id || 'N/A'}</code></p>
										<p><strong>Phone:</strong> ${data.student.phone || 'N/A'}</p>
										<p><strong>Email:</strong> ${data.student.email || 'N/A'}</p>
									</div>
									<div class="col-md-6">
										<h6>Academic Information</h6>
										<p><strong>Institute:</strong> ${data.student.institute || 'N/A'}</p>
										<p><strong>Course:</strong> ${data.student.course || 'N/A'}</p>
										<p><strong>Enrollment Date:</strong> ${data.student.enrollment_date || 'N/A'}</p>
										<p><strong>Enrollment Status:</strong> <span class="badge bg-success">${data.student.enrollment_status || 'N/A'}</span></p>
									</div>
								</div>
								${data.student.device_info ? `
								<div class="alert alert-dark mt-3">
									<h6>Device Information</h6>
									<p><strong>Device:</strong> ${data.student.device_info.device_name || 'N/A'}</p>
									<p><strong>Device Type:</strong> ${data.student.device_info.device_type || 'N/A'}</p>
									<p><strong>Area:</strong> ${data.student.device_info.area_name || 'N/A'}</p>
								</div>
								` : ''}
							`;
						} else {
							modalBody.innerHTML = `
								<div class="alert alert-danger">
									<i class="ti ti-alert-circle me-2"></i>
									Failed to load student details: ${data.message}
								</div>
							`;
						}
					})
					.catch(error => {
						modalBody.innerHTML = `
							<div class="alert alert-danger">
								<i class="ti ti-alert-circle me-2"></i>
								Error loading student details: ${error.message}
							</div>
						`;
					});
			});
		}
		
		const instituteSelect = document.getElementById('institute');
		if (instituteSelect) {
			instituteSelect.addEventListener('change', function () {
				this.closest('form').submit();
			});
		}
		
		const courseSelect = document.getElementById('course');
		if (courseSelect) {
			courseSelect.addEventListener('change', function () {
				this.closest('form').submit();
			});
		}
	</script>
{% endblock %}

{% block modals %}
	<!-- Student Details Modal -->
	<div class="modal fade" id="studentDetailsModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-lg">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Student Details</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<!-- Content will be loaded dynamically -->
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
				</div>
			</div>
		</div>
	</div>
{% endblock %}