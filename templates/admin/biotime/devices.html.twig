{% extends 'admin_base2.html.twig' %}

{% block title %}BioTime Devices{% endblock %}

{% block body %}
    <!-- Page Header -->
    <div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
        <div class="card-body px-4 py-3">
            <div class="row align-items-center">
                <div class="col-9">
                    <h4 class="fw-semibold mb-8">BioTime Devices Management</h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a class="text-muted text-decoration-none" href="#">Admin</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-muted text-decoration-none" href="{{ path('app_admin_biotime_areas') }}">BioTime</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">Devices</li>
                        </ol>
                    </nav>
                </div>
                <div class="col-3">
                    <a href="{{ path('app_admin_biotime_devices', { create: 1 }) }}" class="btn btn-primary float-end">
                        <i class="ti ti-plus me-2"></i>
                        Add New Device
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-success-subtle">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="ti ti-device-desktop text-success" style="font-size: 2rem;"></i>
                        </div>
                        <div>
                            <h5 class="card-title mb-1">Active Devices</h5>
                            <p class="card-text fs-3 mb-0">
                                {{ devices|filter(d => d.status == 'active')|length }}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning-subtle">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="ti ti-tool text-warning" style="font-size: 2rem;"></i>
                        </div>
                        <div>
                            <h5 class="card-title mb-1">Maintenance</h5>
                            <p class="card-text fs-3 mb-0">
                                {{ devices|filter(d => d.status == 'maintenance')|length }}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-secondary-subtle">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="ti ti-device-off text-secondary" style="font-size: 2rem;"></i>
                        </div>
                        <div>
                            <h5 class="card-title mb-1">Inactive</h5>
                            <p class="card-text fs-3 mb-0">
                                {{ devices|filter(d => d.status == 'inactive')|length }}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-primary-subtle">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="ti ti-sum text-primary" style="font-size: 2rem;"></i>
                        </div>
                        <div>
                            <h5 class="card-title mb-1">Total Devices</h5>
                            <p class="card-text fs-3 mb-0">{{ devices|length }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Form for Creating/Editing -->
    {% if showForm %}
    <div class="card mb-4">
        <div class="card-header text-bg-primary">
            <h5 class="mb-0 text-white">
                <i class="ti ti-{{ editId ? 'edit' : 'plus' }} me-2"></i>
                {{ editId ? 'Edit Device' : 'Add New Device' }}
            </h5>
        </div>
        <div class="form-horizontal">
            <div class="form-body">
                <div class="card-body">
                    <h5 class="card-title mb-0">Device Information</h5>
                </div>
                <hr class="m-0">
                <div class="card-body">
                    {{ form_start(form) }}
                    
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3 col-form-label">
                                    {{ form_label(form.device_id) }}
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="col-md-9">
                                    {{ form_widget(form.device_id, { 
                                        'attr': { 
                                            'class': 'form-control',
                                            'placeholder': 'Unique device identifier'
                                        } 
                                    }) }}
                                    {{ form_errors(form.device_id) }}
                                    <small class="form-text text-muted">
                                        BioTime device ID (must match BioTime system)
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3 col-form-label">
                                    {{ form_label(form.device_name) }}
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="col-md-9">
                                    {{ form_widget(form.device_name, { 
                                        'attr': { 
                                            'class': 'form-control',
                                            'placeholder': 'Descriptive device name'
                                        } 
                                    }) }}
                                    {{ form_errors(form.device_name) }}
                                    <small class="form-text text-muted">
                                        Display name for this device
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3 col-form-label">
                                    {{ form_label(form.device_type) }}
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="col-md-9">
                                    {{ form_widget(form.device_type, { 
                                        'attr': { 
                                            'class': 'form-select'
                                        } 
                                    }) }}
                                    {{ form_errors(form.device_type) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3 col-form-label">
                                    {{ form_label(form.area) }}
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="col-md-9">
                                    {{ form_widget(form.area, { 
                                        'attr': { 
                                            'class': 'form-select'
                                        } 
                                    }) }}
                                    {{ form_errors(form.area) }}
                                    <small class="form-text text-muted">
                                        Select the area where this device is located
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3 col-form-label">
                                    {{ form_label(form.status) }}
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="col-md-9">
                                    {{ form_widget(form.status, { 
                                        'attr': { 
                                            'class': 'form-select'
                                        } 
                                    }) }}
                                    {{ form_errors(form.status) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3 col-form-label">
                                    {{ form_label(form.serial_number) }}
                                </label>
                                <div class="col-md-9">
                                    {{ form_widget(form.serial_number, { 
                                        'attr': { 
                                            'class': 'form-control',
                                            'placeholder': 'Device serial number'
                                        } 
                                    }) }}
                                    {{ form_errors(form.serial_number) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3 col-form-label">
                                    {{ form_label(form.ip_address) }}
                                </label>
                                <div class="col-md-9">
                                    <div class="input-group">
                                        {{ form_widget(form.ip_address, { 
                                            'attr': { 
                                                'class': 'form-control',
                                                'placeholder': 'e.g., 192.168.1.100'
                                            } 
                                        }) }}
                                        {{ form_widget(form.port, { 
                                            'attr': { 
                                                'class': 'form-control',
                                                'placeholder': 'Port',
                                                'style': 'max-width: 100px;'
                                            } 
                                        }) }}
                                    </div>
                                    {{ form_errors(form.ip_address) }}
                                    {{ form_errors(form.port) }}
                                    <small class="form-text text-muted">
                                        IP address and port for device communication
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3 col-form-label">
                                    {{ form_label(form.location) }}
                                </label>
                                <div class="col-md-9">
                                    {{ form_widget(form.location, { 
                                        'attr': { 
                                            'class': 'form-control',
                                            'placeholder': 'e.g., Main Entrance, Room 101'
                                        } 
                                    }) }}
                                    {{ form_errors(form.location) }}
                                    <small class="form-text text-muted">
                                        Physical location description
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3 col-form-label">
                                    {{ form_label(form.notes) }}
                                </label>
                                <div class="col-md-9">
                                    {{ form_widget(form.notes, { 
                                        'attr': { 
                                            'class': 'form-control',
                                            'rows': 3,
                                            'placeholder': 'Additional notes, maintenance history, etc.'
                                        } 
                                    }) }}
                                    {{ form_errors(form.notes) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="m-0">
                    <div class="form-actions border-top">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="row">
                                        <div class="col-md-offset-3 col-md-9">
                                            <button type="submit" class="btn btn-primary">
                                                <i class="ti ti-{{ editId ? 'check' : 'plus' }} fs-5 me-2"></i>
                                                {{ editId ? 'Update Device' : 'Create Device' }}
                                            </button>
                                            <a href="{{ path('app_admin_biotime_devices') }}" class="btn bg-danger-subtle text-danger ms-6">
                                                <i class="ti ti-x me-2"></i>
                                                Cancel
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6"></div>
                            </div>
                        </div>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Device Management Actions -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="card-title mb-0">Device Management</h5>
                <div>
                    <a href="{{ path('app_admin_biotime_devices', { sync: 1 }) }}" 
                       class="btn btn-info" 
                       onclick="return confirm('Sync devices from BioTime? This will create devices based on configured areas.')">
                        <i class="ti ti-refresh-dot me-2"></i>
                        Sync from BioTime
                    </a>
                </div>
            </div>
            
            <div class="alert alert-info">
                <i class="ti ti-info-circle me-2"></i>
                <strong>Note:</strong> Devices are automatically synced from BioTime areas. You can also manually add devices here.
            </div>
        </div>
    </div>

    <!-- Table of Existing Devices -->
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="card-title mb-0">Registered BioTime Devices</h5>
                <div>
                    <span class="badge bg-primary">Total: {{ devices|length }}</span>
                </div>
            </div>
            
            {% if devices|length > 0 %}
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th width="50">#</th>
                            <th width="120">Device ID</th>
                            <th>Device Name</th>
                            <th width="120">Type</th>
                            <th width="120">Area</th>
                            <th width="120">Status</th>
                            <th width="150">IP Address</th>
                            <th width="150">Last Sync</th>
                            <th width="250" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for device in devices %}
                            <tr>
                                <td class="text-muted">{{ loop.index }}</td>
                                <td>
                                    <code class="text-primary">{{ device.deviceId }}</code>
                                </td>
                                <td>
                                    <strong>{{ device.deviceName }}</strong>
                                    {% if device.location %}
                                        <br><small class="text-muted">{{ device.location }}</small>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge 
                                        {% if device.deviceType == 'biometric' %}bg-primary
                                        {% elseif device.deviceType == 'card' %}bg-info
                                        {% elseif device.deviceType == 'facial' %}bg-purple
                                        {% else %}bg-secondary{% endif %}">
                                        <i class="ti ti-{{ 
                                            device.deviceType == 'biometric' ? 'fingerprint' :
                                            device.deviceType == 'card' ? 'credit-card' :
                                            device.deviceType == 'facial' ? 'face-id' : 'device-desktop'
                                        }} me-1"></i>
                                        {{ device.deviceType|title }}
                                    </span>
                                </td>
                                <td>
                                    {% if device.area %}
                                        <span class="badge bg-dark">
                                            {{ device.area.areaName }}
                                        </span>
                                        <br>
                                        <small class="text-muted">{{ device.area.areaId }}</small>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge 
                                        {% if device.status == 'active' %}bg-success
                                        {% elseif device.status == 'maintenance' %}bg-warning
                                        {% else %}bg-secondary{% endif %}">
                                        <i class="ti ti-{{ 
                                            device.status == 'active' ? 'check' :
                                            device.status == 'maintenance' ? 'tool' : 'x'
                                        }} me-1"></i>
                                        {{ device.status|title }}
                                    </span>
                                </td>
                                <td>
                                    {% if device.ipAddress %}
                                        <code>{{ device.ipAddress }}{% if device.port %}:{{ device.port }}{% endif %}</code>
                                        {% if device.serialNumber %}
                                            <br><small class="text-muted">SN: {{ device.serialNumber }}</small>
                                        {% endif %}
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if device.lastSyncDate %}
                                        <small class="text-muted">{{ device.lastSyncDate|date('Y-m-d H:i') }}</small>
                                    {% else %}
                                        <span class="text-muted">Never</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="{{ path('app_admin_biotime_devices', { edit: device.id }) }}" 
                                           class="btn btn-warning" 
                                           title="Edit device">
                                            <i class="ti ti-edit me-1"></i> Edit
                                        </a>
                                        
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="ti ti-settings me-1"></i> Status
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a class="dropdown-item {% if device.status == 'active' %}active{% endif %}" 
                                                       href="?toggle_status={{ device.id }}&status=active">
                                                        <i class="ti ti-check me-2"></i> Active
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item {% if device.status == 'inactive' %}active{% endif %}" 
                                                       href="?toggle_status={{ device.id }}&status=inactive">
                                                        <i class="ti ti-x me-2"></i> Inactive
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item {% if device.status == 'maintenance' %}active{% endif %}" 
                                                       href="?toggle_status={{ device.id }}&status=maintenance">
                                                        <i class="ti ti-tool me-2"></i> Maintenance
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                        
                                        <a href="{{ path('app_admin_biotime_devices', { delete: device.id }) }}" 
                                           class="btn btn-danger" 
                                           onclick="return confirm('Are you sure you want to delete device \"{{ device.deviceName }}\"? This action cannot be undone.')"
                                           title="Delete device">
                                            <i class="ti ti-trash me-1"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            
            <div class="mt-4">
                <div class="row">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-title mb-3">Device Types Summary</h6>
                                <ul class="list-unstyled">
                                    {% set biometricCount = devices|filter(d => d.deviceType == 'biometric')|length %}
                                    {% set cardCount = devices|filter(d => d.deviceType == 'card')|length %}
                                    {% set facialCount = devices|filter(d => d.deviceType == 'facial')|length %}
                                    {% set otherCount = devices|length - biometricCount - cardCount - facialCount %}
                                    
                                    <li class="mb-2">
                                        <i class="ti ti-fingerprint text-primary me-2"></i>
                                        <strong>Biometric:</strong> {{ biometricCount }} devices
                                    </li>
                                    <li class="mb-2">
                                        <i class="ti ti-credit-card text-info me-2"></i>
                                        <strong>Card Readers:</strong> {{ cardCount }} devices
                                    </li>
                                    <li class="mb-2">
                                        <i class="ti ti-face-id text-purple me-2"></i>
                                        <strong>Facial Recognition:</strong> {{ facialCount }} devices
                                    </li>
                                    {% if otherCount > 0 %}
                                    <li class="mb-2">
                                        <i class="ti ti-device-desktop text-secondary me-2"></i>
                                        <strong>Other Types:</strong> {{ otherCount }} devices
                                    </li>
                                    {% endif %}
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-title mb-3">Maintenance Tips</h6>
                                <ul class="list-unstyled">
                                    <li class="mb-2">
                                        <i class="ti ti-circle-check text-success me-2"></i>
                                        Keep device firmware updated
                                    </li>
                                    <li class="mb-2">
                                        <i class="ti ti-circle-check text-success me-2"></i>
                                        Regular network connectivity checks
                                    </li>
                                    <li class="mb-2">
                                        <i class="ti ti-circle-check text-success me-2"></i>
                                        Monitor battery status for wireless devices
                                    </li>
                                    <li class="mb-2">
                                        <i class="ti ti-circle-check text-success me-2"></i>
                                        Clean biometric sensors regularly
                                    </li>
                                    <li>
                                        <i class="ti ti-circle-check text-success me-2"></i>
                                        Log maintenance activities in notes
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            {% else %}
            <div class="alert alert-info text-center py-4">
                <div class="mb-3">
                    <i class="ti ti-device-desktop text-primary" style="font-size: 3rem;"></i>
                </div>
                <h5 class="alert-heading">No Devices Found</h5>
                <p class="mb-3">There are no BioTime devices configured in the system.</p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="{{ path('app_admin_biotime_devices', { create: 1 }) }}" class="btn btn-primary">
                        <i class="ti ti-plus me-2"></i>Add First Device
                    </a>
                    <a href="{{ path('app_admin_biotime_devices', { sync: 1 }) }}" class="btn btn-info">
                        <i class="ti ti-refresh-dot me-2"></i>Sync from BioTime
                    </a>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<script>
// Handle status toggle confirmation
document.querySelectorAll('a[href*="toggle_status"]').forEach(link => {
    link.addEventListener('click', function(e) {
        const deviceName = this.closest('tr').querySelector('strong').textContent;
        const newStatus = this.textContent.trim();
        if (!confirm(`Change device "${deviceName}" status to "${newStatus}"?`)) {
            e.preventDefault();
        }
    });
});

// Auto-refresh last sync dates every 5 minutes
setInterval(function() {
    // This would ideally make an AJAX call to refresh sync status
    // For now, we'll just reload the page
    // location.reload();
}, 300000); // 5 minutes
</script>
{% endblock %}