{# templates/admin/attendance/monthly_report.html.twig #}
{% extends 'admin_base2.html.twig' %}

{% block title %}Monthly Attendance Report - Admin{% endblock %}

{% block body %}
    <!-- Page Header -->
    <div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
        <div class="card-body px-4 py-3">
            <div class="row align-items-center">
                <div class="col-9">
                    <h4 class="fw-semibold mb-8">Monthly Attendance Report</h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a class="text-muted text-decoration-none" href="#">Admin</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-muted text-decoration-none" href="#">Attendance</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">Monthly Report</li>
                        </ol>
                    </nav>
                </div>
                <div class="col-3">
                    <div class="text-end">
                        <a href="{{ path('app_admin_attendance_index') }}" class="btn btn-outline-info me-2">
                            <i class="ti ti-calendar me-2"></i>
                            Daily View
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if no_institutes %}
        <div class="alert alert-warning" role="alert">
            <i class="ti ti-alert-circle me-2"></i>
            You do not manage any institutes to view attendance reports. Please contact the administrator.
        </div>
    {% else %}
        <!-- Filters Card -->
        <div class="card mb-4">
            <div class="card-body">
                <form method="get" action="{{ path('app_admin_attendance_monthly_report') }}" class="row g-3">
                    <div class="col-md-3">
                        <label for="monthYear" class="form-label">Month & Year</label>
                        <input type="month" 
                               class="form-control" 
                               id="monthYear" 
                               name="monthYear" 
                               value="{{ selectedYear }}-{{ selectedMonth|format('%02d') }}"
                               max="{{ 'now'|date('Y-m') }}">
                    </div>
                    <div class="col-md-3">
                        {{ form_label(searchForm.applicant, 'Applicant') }}
                        {{ form_widget(searchForm.applicant, {'attr': {
                            'class': 'form-control'
                        }}) }}
                    </div>
                    <div class="col-md-3">
                        <label for="institute" class="form-label">Institute</label>
                        <select class="form-control" id="institute" name="institute">
                            <option value="">All Institutes</option>
                            {% for institute in managedInstitutes %}
                                <option value="{{ institute.id }}" {{ institute_filter == institute.id ? 'selected' : '' }}>
                                    {{ institute.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-filter me-2"></i>Generate Report
                            </button>
                            <a href="{{ path('app_admin_attendance_monthly_report') }}" class="btn btn-outline-secondary">
                                <i class="ti ti-refresh me-2"></i>Reset
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-start border-primary border-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted fw-semibold mb-1">Total Students</h6>
                        <h4 class="fw-semibold mb-0">{{ stats.total_students }}</h4>
                    </div>
                    <div class="bg-primary text-white rounded-circle p-3">
                        <i class="ti ti-users fs-6"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-start border-success border-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted fw-semibold mb-1">Required Working Days</h6>
                        <h4 class="fw-semibold mb-0">{{ stats.total_required_days }}</h4>
                        <small class="text-muted">{{ months[selectedMonth] }} {{ selectedYear }}</small>
                    </div>
                    <div class="bg-success text-white rounded-circle p-3">
                        <i class="ti ti-calendar-event fs-6"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-start border-info border-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted fw-semibold mb-1">Holidays</h6>
                        <h4 class="fw-semibold mb-0">{{ stats.holiday_count }}</h4>
                        <small class="text-muted">Excluded from working days</small>
                    </div>
                    <div class="bg-info text-white rounded-circle p-3">
                        <i class="ti ti-beach fs-6"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


        <!-- Monthly Report Table -->
        <div class="card">
            <div class="card-body">
              <!-- In the table header section -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="card-title mb-0">
        Monthly Report - {{ months[selectedMonth] }} {{ selectedYear }}
        {% if stats.future_dates_count > 0 %}
            <small class="text-muted ms-2">({{ stats.future_dates_count }} future date(s) excluded)</small>
        {% endif %}
    </h5>
    <div>
        <span class="badge bg-primary">Students: {{ stats.total_students }}</span>
        <span class="badge bg-success ms-2">Working Days: {{ stats.total_required_days }}</span>
        <span class="badge bg-info ms-2">Holidays: {{ stats.holiday_count }}</span>
        {% if stats.future_dates_count > 0 %}
            <span class="badge bg-warning ms-2">Future Dates: {{ stats.future_dates_count }}</span>
        {% endif %}
    </div>
</div>

                {% if monthlyData|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover" id="monthlyReportTable">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Application ID</th>
                                    <th>Full Name</th>
                                    <th>Institute</th>
                                    <th>Days Present</th>
                                    <th>Required Days</th>
                                    <th>Hrs Worked</th>
                                    <th>Required Hrs Total</th>
                                    <th>Details</th>
                                </tr>
                            </thead>
                          <!-- In the monthly table -->
<tbody>
    {% for data in monthlyData %}
        <tr>
            <td>{{ loop.index }}</td>
            <td>
                <a href="{{ path('app_admin_kaaba_application_view', {'uuid': data.application_id}) }}" class="text-primary text-decoration-none">
                    #{{ data.application_id }}
                </a>
            </td>
            <td>
                <div class="d-flex align-items-center">
                    <div>
                        <h6 class="mb-0">{{ data.full_name }}</h6>
                        <small class="text-muted">{{ data.phone }}</small>
                    </div>
                </div>
            </td>
            <td>
                <span class="badge bg-info">{{ data.institute_name ?: 'No Institute' }}</span>
                {% if data.min_hours_per_day > 0 %}
                    <br><small class="text-muted">Min: {{ data.min_hours_per_day }} hrs/day</small>
                {% endif %}
            </td>
            <td>
                <span class="badge {{ data.days_present >= data.required_days ? 'bg-success' : 'bg-warning' }}">
                    {{ data.days_present }}
                </span>
                {% set working_days_up_to_today = data.required_days - data.future_working_days|default(0) %}
                {% if working_days_up_to_today < data.required_days %}
                    <br><small class="text-muted">of {{ working_days_up_to_today }} days so far</small>
                {% endif %}
            </td>
            <td>
                <span class="badge bg-secondary">{{ data.required_days }}</span>
                {% if data.future_working_days|default(0) > 0 %}
                    <br><small class="text-muted">({{ data.future_working_days }} future)</small>
                {% endif %}
            </td>
            <td>
                <span class="badge bg-info">
                    {{ data.total_hours|number_format(1) }} hrs
                </span>
            </td>
            <td>
                {% if data.required_hours_total > 0 %}
                    <span class="badge {{ data.total_hours >= data.required_hours_total ? 'bg-success' : 'bg-warning' }}">
                        {{ data.required_hours_total|number_format(1) }} hrs
                    </span>
                    {% if data.future_working_days|default(0) > 0 and data.min_hours_per_day > 0 %}
                        {% set future_hours = data.future_working_days * data.min_hours_per_day %}
                        <br><small class="text-muted">({{ future_hours|number_format(1) }} hrs future)</small>
                    {% endif %}
                {% else %}
                    <span class="badge bg-secondary">
                        N/A
                    </span>
                {% endif %}
            </td>
            <td>
             <button type="button" class="btn btn-sm btn-outline-primary" 
    data-bs-toggle="modal" 
    data-bs-target="#detailsModal{{ data.application_id }}"
    onclick="loadMonthlyDetails({{ data.application_id }}, {{ selectedYear }}, {{ selectedMonth }})">
    <i class="ti ti-eye me-1"></i>View
</button>
            </td>
        </tr>
    {% endfor %}
</tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="text-center py-5">
                        <div class="mb-3">
                            <i class="ti ti-calendar-off fs-1 text-muted"></i>
                        </div>
                        <h5 class="text-muted">No attendance data found for {{ months[selectedMonth] }} {{ selectedYear }}</h5>
                        <p class="text-muted mb-0">
                            {% if applicant_filter or institute_filter %}
                                Try adjusting your filters
                            {% else %}
                                No attendance data has been recorded for this period
                            {% endif %}
                        </p>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Details Modals (One for each student) -->
        {% for data in monthlyData %}
            <div class="modal fade" id="detailsModal{{ data.application_id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                Monthly Details - {{ data.full_name }} ({{ months[selectedMonth] }} {{ selectedYear }})
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body" id="detailsContent{{ data.application_id }}">
                            <div class="text-center">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mt-2">Loading details...</p>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <div class="me-auto">
                                <small class="text-muted">
                                    <i class="ti ti-info-circle me-1"></i>
                                    Weekends and holidays are excluded from working days calculation
                                </small>
                            </div>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    
    <script>
        document.getElementById('monthYear').addEventListener('change', function() {
            this.form.submit();
        });

function loadMonthlyDetails(applicationId, year, month) {
    const modalContent = document.getElementById(`detailsContent${applicationId}`);
    
    // Show loading spinner
    modalContent.innerHTML = `
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading detailed attendance...</p>
        </div>
    `;
    
    // Make AJAX request
    fetch(`/admin/attendance/monthly-details/${applicationId}?year=${year}&month=${month}`)
        .then(response => response.json())
        .then(data => {
            // Extract data from the response
            const minHoursPerDay = data.min_hours_per_day || 0;
            const instituteName = data.institute_name || 'No Institute';
            const requiredHoursTotal = data.required_hours_total || 0;
            const workingDays = data.working_days || 0;
            const workingDaysUpToToday = data.working_days_up_to_today || 0;
            const presentDays = data.present_days || 0;
            const absentDays = data.absent_days || 0;
            const totalHours = data.total_hours || 0;
            const fullName = data.full_name || '';
            const monthSummary = data.month_summary || { month_name: '', year: '' };
            const dailyDetails = data.daily_details || [];
            
            let html = `
                <div class="row mb-4">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-title">Student Info</h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <p class="mb-1"><strong>Name:</strong> ${fullName}</p>
                                        <p class="mb-1"><strong>Institute:</strong> ${instituteName}</p>
                                        <p class="mb-0"><strong>Min Hours/Day:</strong> ${minHoursPerDay > 0 ? minHoursPerDay + ' hrs' : 'Not set'}</p>
                                    </div>
                                    <div class="col-md-6">
                                        <p class="mb-1"><strong>Month:</strong> ${monthSummary.month_name} ${monthSummary.year}</p>
                                        <p class="mb-1"><strong>Total Working Days:</strong> ${workingDays}</p>
                                        ${workingDays - workingDaysUpToToday > 0 ? 
                                            `<p class="mb-0"><strong>Future Working Days:</strong> ${workingDays - workingDaysUpToToday}</p>` : 
                                            ''
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card border-start border-success border-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted fw-semibold mb-1">Days Present</h6>
                                        <h4 class="fw-semibold mb-0">${presentDays}</h4>
                                    </div>
                                    <div class="bg-success text-white rounded-circle p-3">
                                        <i class="ti ti-calendar fs-6"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-start border-secondary border-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted fw-semibold mb-1">Required Days</h6>
                                        <h4 class="fw-semibold mb-0">${workingDays}</h4>
                                        ${workingDays - workingDaysUpToToday > 0 ? 
                                            `<small class="text-muted">(${workingDays - workingDaysUpToToday} future)</small>` : 
                                            '<small class="text-muted">Full month</small>'
                                        }
                                    </div>
                                    <div class="bg-secondary text-white rounded-circle p-3">
                                        <i class="ti ti-calendar-event fs-6"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-start border-info border-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted fw-semibold mb-1">Hrs Worked</h6>
                                        <h4 class="fw-semibold mb-0">${totalHours.toFixed(1)}</h4>
                                        <small class="text-muted">hours</small>
                                    </div>
                                    <div class="bg-info text-white rounded-circle p-3">
                                        <i class="ti ti-clock fs-6"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-start border-warning border-3">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="text-muted fw-semibold mb-1">Required Hrs Total</h6>
                                        <h4 class="fw-semibold mb-0">${requiredHoursTotal.toFixed(1)}</h4>
                                        <small class="text-muted">${minHoursPerDay > 0 ? `${workingDays} × ${minHoursPerDay} hrs` : 'Not set'}</small>
                                    </div>
                                    <div class="bg-warning text-white rounded-circle p-3">
                                        <i class="ti ti-clock-hour-4 fs-6"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            // Monthly Hours Requirement section
            if (minHoursPerDay > 0 && requiredHoursTotal > 0) {
                const percentage = totalHours > 0 ? Math.round((totalHours / requiredHoursTotal) * 100) : 0;
                html += `
                    <div class="alert ${totalHours >= requiredHoursTotal ? 'alert-success' : 'alert-warning'} mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="alert-heading mb-1">Monthly Hours Requirement Status</h6>
                                <p class="mb-0">
                                    ${totalHours.toFixed(1)} / ${requiredHoursTotal.toFixed(1)} hours
                                    (${percentage}% of monthly requirement)
                                </p>
                            </div>
                            <div class="text-end">
                                ${totalHours >= requiredHoursTotal ? 
                                    '<span class="badge bg-success fs-6">REQUIREMENT MET</span>' : 
                                    '<span class="badge bg-warning fs-6">REQUIREMENT NOT MET</span>'
                                }
                            </div>
                        </div>
                    </div>
                `;
            }
            
            html += `<h6 class="mb-3">Daily Attendance - ${monthSummary.month_name} ${monthSummary.year}</h6>`;
            
            if (dailyDetails.length > 0) {
                html += `
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Day</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Check In</th>
                                    <th>Check Out</th>
                                    <th>Hours</th>
                                </tr>
                            </thead>
                            <tbody>
                `;
                
                // Count statuses
                const statusCounts = {
                    present: 0,
                    absent: 0,
                    future: 0,
                    holiday: 0,
                    weekend: 0
                };
                
                dailyDetails.forEach(detail => {
                    // Determine status for counting
                    const status = detail.status.toLowerCase();
                    if (detail.is_future_date) {
                        statusCounts.future++;
                    } else if (detail.is_holiday) {
                        statusCounts.holiday++;
                    } else if (detail.is_weekend) {
                        statusCounts.weekend++;
                    } else if (status === 'present' || status === 'late' || status === 'half-day') {
                        statusCounts.present++;
                    } else if (status === 'absent') {
                        statusCounts.absent++;
                    }
                    
                    // Determine row class
                    let rowClass = detail.row_class || '';
                    let typeIcon = '';
                    let typeText = '';
                    
                    if (detail.is_future_date) {
                        rowClass = 'table-light text-muted';
                        typeIcon = '⏳';
                        typeText = 'Future';
                    } else if (detail.is_holiday) {
                        typeIcon = '🏖️';
                        typeText = 'Holiday';
                    } else if (detail.is_weekend) {
                        typeIcon = '📅';
                        typeText = 'Weekend';
                    } else {
                        typeIcon = '📚';
                        typeText = 'Working Day';
                    }
                    
                    // Determine if hours meet minimum requirement
                    let hoursStatus = '';
                    if (!detail.is_future_date && !detail.is_holiday && !detail.is_weekend && 
                        detail.status !== 'Weekend' && detail.status !== 'Holiday' && 
                        minHoursPerDay > 0 && detail.hours > 0) {
                        const meetsRequirement = detail.hours >= minHoursPerDay;
                        hoursStatus = meetsRequirement ? 
                            `<span class="badge bg-success ms-1">✓</span>` : 
                            `<span class="badge bg-danger ms-1">✗ ${minHoursPerDay}hrs</span>`;
                    }
                    
                    html += `
                        <tr class="${rowClass}">
                            <td>${detail.date}</td>
                            <td>${detail.day}</td>
                            <td>${typeIcon} ${typeText}</td>
                            <td><span class="badge ${detail.status_class}">${detail.status}</span></td>
                            <td>${detail.check_in}</td>
                            <td>${detail.check_out}</td>
                            <td>
                                ${detail.hours > 0 ? detail.hours.toFixed(1) + ' hrs' : '--'}
                                ${hoursStatus}
                            </td>
                        </tr>
                    `;
                });
                
                html += `
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <h6 class="card-title">Status Summary</h6>
                                    <div class="d-flex flex-wrap gap-2">
                                        ${statusCounts.present > 0 ? `<span class="badge bg-success">Present: ${statusCounts.present}</span>` : ''}
                                        ${statusCounts.absent > 0 ? `<span class="badge bg-danger">Absent: ${statusCounts.absent}</span>` : ''}
                                        ${statusCounts.future > 0 ? `<span class="badge bg-light text-dark">⏳ Future: ${statusCounts.future}</span>` : ''}
                                        ${statusCounts.holiday > 0 ? `<span class="badge bg-info">🏖️ Holiday: ${statusCounts.holiday}</span>` : ''}
                                        ${statusCounts.weekend > 0 ? `<span class="badge bg-secondary">📅 Weekend: ${statusCounts.weekend}</span>` : ''}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <h6 class="card-title">Month Overview</h6>
                                    <div class="row small">
                                        <div class="col-6 mb-2">
                                            <span class="text-muted">Total Days:</span> ${dailyDetails.length}
                                        </div>
                                        <div class="col-6 mb-2">
                                            <span class="text-muted">Working Days:</span> ${workingDays}
                                        </div>
                                        <div class="col-6 mb-2">
                                            <span class="text-muted">Present:</span> ${statusCounts.present}
                                        </div>
                                        <div class="col-6 mb-2">
                                            <span class="text-muted">Absent:</span> ${statusCounts.absent}
                                        </div>
                                        <div class="col-6 mb-2">
                                            <span class="text-muted">Holidays:</span> ${statusCounts.holiday}
                                        </div>
                                        <div class="col-6 mb-2">
                                            <span class="text-muted">Weekends:</span> ${statusCounts.weekend}
                                        </div>
                                        <div class="col-6 mb-2">
                                            <span class="text-muted">Future Dates:</span> ${statusCounts.future}
                                        </div>
                                        <div class="col-12 mt-2">
                                            <span class="text-muted">Hours Worked:</span> <strong>${totalHours.toFixed(1)} hrs</strong>
                                        </div>
                                        ${minHoursPerDay > 0 ? `
                                            <div class="col-12 mt-2">
                                                <span class="text-muted">Required Hours:</span> <strong>${requiredHoursTotal.toFixed(1)} hrs</strong>
                                            </div>
                                        ` : ''}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            } else {
                html += `
                    <div class="alert alert-info">
                        <i class="ti ti-info-circle me-2"></i>
                        No attendance data available for this period.
                    </div>
                `;
            }
            
            modalContent.innerHTML = html;
        })
        .catch(error => {
            console.error('Error loading details:', error);
            modalContent.innerHTML = `
                <div class="alert alert-danger">
                    <i class="ti ti-alert-circle me-2"></i>
                    Error loading details. Please try again.
                </div>
            `;
        });
}
    </script>
{% endblock %}