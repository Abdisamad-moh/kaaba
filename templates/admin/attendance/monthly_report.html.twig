{# templates/admin/attendance/monthly_report.html.twig #}
{% extends 'admin_base2.html.twig' %}

{% block title %}Monthly Attendance Report - Admin{% endblock %}

{% block body %}
    <!-- Page Header -->
    <div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
        <div class="card-body px-4 py-3">
            <div class="row align-items-center">
                <div class="col-9">
                    <h4 class="fw-semibold mb-8">Monthly Attendance Report</h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a class="text-muted text-decoration-none" href="#">Admin</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-muted text-decoration-none" href="#">Attendance</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">Monthly Report</li>
                        </ol>
                    </nav>
                </div>
                <div class="col-3">
                    <div class="text-end">
                        <a href="{{ path('app_admin_attendance_index') }}" class="btn btn-outline-info me-2">
                            <i class="ti ti-calendar me-2"></i>
                            Daily View
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if no_institutes %}
        <div class="alert alert-warning" role="alert">
            <i class="ti ti-alert-circle me-2"></i>
            You do not manage any institutes to view attendance reports. Please contact the administrator.
        </div>
    {% else %}
        <!-- Filters Card -->
        <div class="card mb-4">
            <div class="card-body">
                <form method="get" action="{{ path('app_admin_attendance_monthly_report') }}" class="row g-3">

     <div class="col-md-3">
    <label for="monthYear" class="form-label">Month & Year</label>
    <input type="month" 
           class="form-control" 
           id="monthYear" 
           name="monthYear" 
           value="{{ selectedYear }}-{{ selectedMonth|format('%02d') }}"
           max="{{ 'now'|date('Y-m') }}">
</div>
                  <div class="col-md-3">
    {{ form_label(searchForm.applicant, 'Applicant') }}
    {{ form_widget(searchForm.applicant, {'attr': {
        'class': 'form-control'
    }}) }}
</div>
                    <div class="col-md-3">
                        <label for="institute" class="form-label">Institute</label>
                        <select class="form-control" id="institute" name="institute">
                            <option value="">All Institutes</option>
                            {% for institute in managedInstitutes %}
                                <option value="{{ institute.id }}" {{ institute_filter == institute.id ? 'selected' : '' }}>
                                    {{ institute.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-12">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="ti ti-filter me-2"></i>Generate Report
                        </button>
                        <a href="{{ path('app_admin_attendance_monthly_report') }}" class="btn btn-outline-secondary">
                            <i class="ti ti-refresh me-2"></i>Reset
                        </a>
                       
                    </div>
                </form>
            </div>
        </div>

       <!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-start border-primary border-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted fw-semibold mb-1">Total Students</h6>
                        <h4 class="fw-semibold mb-0">{{ stats.total_students }}</h4>
                        {% if stats.students_with_hours_config > 0 %}
                            <small class="text-muted">{{ stats.students_with_hours_config }} with hours config</small>
                        {% endif %}
                    </div>
                    <div class="bg-primary text-white rounded-circle p-3">
                        <i class="ti ti-users fs-6"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-start border-success border-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted fw-semibold mb-1">Required Working Days</h6>
                        <h4 class="fw-semibold mb-0">{{ stats.total_required_days }}</h4>
                        <small class="text-muted">{{ months[selectedMonth] }} {{ selectedYear }}</small>
                    </div>
                    <div class="bg-success text-white rounded-circle p-3">
                        <i class="ti ti-calendar-event fs-6"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-start border-info border-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted fw-semibold mb-1">Hours Compliance</h6>
                        <h4 class="fw-semibold mb-0">{{ stats.hours_compliance_rate }}%</h4>
                        <small class="text-muted">{{ stats.total_days_with_sufficient_hours }}/{{ stats.total_days_present }} days</small>
                    </div>
                    <div class="bg-info text-white rounded-circle p-3">
                        <i class="ti ti-clock-check fs-6"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-start border-warning border-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted fw-semibold mb-1">Total Hours</h6>
                        <h4 class="fw-semibold mb-0">{{ stats.total_hours|number_format(0) }}</h4>
                        <small class="text-muted">{{ stats.average_hours|round(1) }} hrs avg</small>
                    </div>
                    <div class="bg-warning text-white rounded-circle p-3">
                        <i class="ti ti-clock fs-6"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


        <!-- Monthly Report Table -->
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="card-title mb-0">
                        Monthly Report - {{ months[selectedMonth] }} {{ selectedYear }}
                    </h5>
                    <div>
                        <span class="badge bg-primary">Total Students: {{ stats.total_students }}</span>
                        <span class="badge bg-success ms-2">Working Days: {{ stats.total_required_days }}</span>
                    </div>
                </div>

                {% if monthlyData|length > 0 %}
                    <div class="table-responsive">
                      <table class="table table-hover" id="monthlyReportTable">
    <thead>
        <tr>
            <th>#</th>
            <th>Application ID</th>
            <th>Full Name</th>
            <th>Institute</th>
            <th>Days Present</th>
            <th>Required Days</th>
            <th>Attendance %</th>
            <th>Hours Compliance</th>
            <th>Total Hours</th>
            <th>Avg Hours/Day</th>
            <th>Status</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        {% for data in monthlyData %}
            <tr>
                <td>{{ loop.index }}</td>
                <td>
                    <a href="{{ path('app_admin_kaaba_application_view', {'uuid': data.application_id}) }}" class="text-primary text-decoration-none">
                        #{{ data.application_id }}
                    </a>
                </td>
                <td>
                    <div class="d-flex align-items-center">
                        <div>
                            <h6 class="mb-0">{{ data.full_name }}</h6>
                            <small class="text-muted">{{ data.phone }}</small>
                        </div>
                    </div>
                </td>
                <td>
                    <span class="badge bg-info">{{ data.institute_name ?: 'No Institute' }}</span>
                    {% if data.min_hours_per_day > 0 %}
                        <br><small class="text-muted">Min: {{ data.min_hours_per_day }} hrs/day</small>
                    {% endif %}
                </td>
                <td>
                    <span class="badge bg-success">{{ data.days_present }}</span>
                </td>
                <td>
                    <span class="badge bg-secondary">{{ data.required_days }}</span>
                </td>
                <td>
                    {% set percentage = data.attendance_percentage %}
                    {% if percentage >= 80 %}
                        {% set badge_class = 'bg-success' %}
                    {% elseif percentage >= 60 %}
                        {% set badge_class = 'bg-warning' %}
                    {% else %}
                        {% set badge_class = 'bg-danger' %}
                    {% endif %}
                    <span class="badge {{ badge_class }}">
                        {{ percentage }}%
                    </span>
                </td>
                <td>
                    {% if data.min_hours_per_day > 0 %}
                        {% set hours_compliance = data.sufficient_hours_percentage %}
                        {% if hours_compliance >= 80 %}
                            {% set badge_class = 'bg-success' %}
                        {% elseif hours_compliance >= 60 %}
                            {% set badge_class = 'bg-warning' %}
                        {% else %}
                            {% set badge_class = 'bg-danger' %}
                        {% endif %}
                        <span class="badge {{ badge_class }}" title="{{ data.days_with_sufficient_hours }}/{{ data.days_present }} days with sufficient hours">
                            {{ hours_compliance }}%
                        </span>
                    {% else %}
                        <span class="badge bg-secondary" title="No minimum hours configured">
                            N/A
                        </span>
                    {% endif %}
                </td>
                <td>
                    <span class="badge bg-info">
                        {{ data.total_hours|number_format(1) }} hrs
                    </span>
                </td>
                <td>
                    <span class="badge bg-light text-dark">
                        {{ data.average_hours_per_day|number_format(1) }} hrs
                    </span>
                </td>
            <td>
    {% set present_rate = data.required_days > 0 ? (data.days_present / data.required_days * 100) : 0 %}
    {% set hours_ok = data.min_hours_per_day == 0 or data.sufficient_hours_percentage >= 80 %}
    
    {% if present_rate >= 80 and hours_ok %}
        <span class="badge bg-success">Good</span>
    {% elseif present_rate >= 60 and hours_ok %}
        <span class="badge bg-warning">Average</span>
    {% elseif present_rate > 0 %}
        <span class="badge bg-danger">Poor</span>
    {% else %}
        <span class="badge bg-secondary">No Data</span>
    {% endif %}
</td>
                <td>
                    <button type="button" class="btn btn-sm btn-outline-primary" 
                            data-bs-toggle="modal" 
                            data-bs-target="#detailsModal{{ data.application_id }}"
                            onclick="loadMonthlyDetails({{ data.application_id }}, {{ selectedYear }}, {{ selectedMonth }})">
                        <i class="ti ti-eye me-1"></i>View
                    </button>
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>

                    </div>
                {% else %}
                    <div class="text-center py-5">
                        <div class="mb-3">
                            <i class="ti ti-calendar-off fs-1 text-muted"></i>
                        </div>
                        <h5 class="text-muted">No attendance data found for {{ months[selectedMonth] }} {{ selectedYear }}</h5>
                        <p class="text-muted mb-0">
                            {% if applicant_filter or institute_filter %}
                                Try adjusting your filters
                            {% else %}
                                No attendance data has been recorded for this period
                            {% endif %}
                        </p>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Details Modals (One for each student) -->
        {% for data in monthlyData %}
            <div class="modal fade" id="detailsModal{{ data.application_id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                Monthly Details - {{ data.full_name }} ({{ months[selectedMonth] }} {{ selectedYear }})
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body" id="detailsContent{{ data.application_id }}">
                            <div class="text-center">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mt-2">Loading details...</p>
                            </div>
                        </div>
                       {# In your modal footer in monthly_report.html.twig, add this: #}
<div class="modal-footer">
    <div class="me-auto">
        <small class="text-muted">
            <i class="ti ti-info-circle me-1"></i>
            Weekends and holidays are excluded from working days calculation
        </small>
    </div>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    
    <script>
   document.getElementById('monthYear').addEventListener('change', function() {
    this.form.submit();
});
        // Export to Excel functionality
        document.getElementById('exportBtn').addEventListener('click', function() {
            const table = document.getElementById('monthlyReportTable');
            const rows = table.querySelectorAll('tr');
            let csv = [];
            
            // Add headers
            const headers = [];
            table.querySelectorAll('th').forEach(th => {
                headers.push(th.innerText);
            });
            csv.push(headers.join(','));
            
            // Add data rows
            rows.forEach(row => {
                const cols = row.querySelectorAll('td');
                if (cols.length > 0) {
                    let rowData = [];
                    cols.forEach(col => {
                        // Remove HTML tags and get text content
                        let text = col.innerText.replace(/,/g, ';');
                        rowData.push(text);
                    });
                    csv.push(rowData.join(','));
                }
            });
            
            // Create and download CSV file
            const csvContent = csv.join('\n');
            const blob = new Blob([csvContent], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.setAttribute('hidden', '');
            a.setAttribute('href', url);
            a.setAttribute('download', `attendance_report_${document.getElementById('year').value}_${document.getElementById('month').value}.csv`);
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        });

     function loadMonthlyDetails(applicationId, year, month) {
    const modalContent = document.getElementById(`detailsContent${applicationId}`);
    
    // Show loading spinner
    modalContent.innerHTML = `
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading detailed attendance...</p>
        </div>
    `;
    
    // Make AJAX request
    fetch(`/admin/attendance/monthly-details/${applicationId}?year=${year}&month=${month}`)
        .then(response => response.json())
        .then(data => {
            let html = `
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-title">Student Info</h6>
                                <p class="mb-1"><strong>Name:</strong> ${data.full_name}</p>
                                <p class="mb-1"><strong>Institute:</strong> ${data.institute_name}</p>
                                <p class="mb-0"><strong>Min Hours/Day:</strong> ${data.min_hours_per_day > 0 ? data.min_hours_per_day + ' hrs' : 'Not set'}</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-title">Attendance Summary</h6>
                                <div class="row">
                                    <div class="col-6">
                                        <small class="text-muted">Working Days</small>
                                        <h5>${data.working_days}</h5>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Present Days</small>
                                        <h5>${data.present_days}</h5>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Absent Days</small>
                                        <h5>${data.absent_days}</h5>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Attendance %</small>
                                        <h5 class="${data.attendance_percentage >= 80 ? 'text-success' : data.attendance_percentage >= 60 ? 'text-warning' : 'text-danger'}">
                                            ${data.attendance_percentage}%
                                        </h5>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <h6 class="card-title">Hours Summary</h6>
                                <div class="row">
                                    <div class="col-6">
                                        <small class="text-muted">Total Hours</small>
                                        <h5>${data.total_hours}</h5>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Required Hours</small>
                                        <h5>${data.total_required_hours}</h5>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Avg Hours/Day</small>
                                        <h5>${data.average_hours_per_day}</h5>
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Hours Compliance</small>
                                        <h5 class="${data.hours_compliance_percentage >= 80 ? 'text-success' : data.hours_compliance_percentage >= 60 ? 'text-warning' : 'text-danger'}">
                                            ${data.hours_compliance_percentage}%
                                        </h5>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Hours Requirement Summary -->
                <div class="alert ${data.total_hours >= data.total_required_hours ? 'alert-success' : 'alert-warning'} mb-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="alert-heading mb-1">Monthly Hours Requirement</h6>
                            <p class="mb-0">
                                ${data.min_hours_per_day > 0 ? 
                                    `Required: ${data.total_required_hours} hours (${data.working_days} days × ${data.min_hours_per_day} hrs)` :
                                    'No minimum hours requirement configured'
                                }
                            </p>
                        </div>
                        <div class="text-end">
                            <h4 class="mb-0">${data.total_hours}/${data.total_required_hours} hrs</h4>
                            <small>${Math.round((data.total_hours / data.total_required_hours) * 100)}% of requirement</small>
                        </div>
                    </div>
                </div>
                
                <h6 class="mb-3">Daily Attendance - ${data.month_summary.month_name} ${data.month_summary.year}</h6>
            `;
            
            if (data.daily_details && data.daily_details.length > 0) {
                html += `
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Day</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th>Check In</th>
                                    <th>Check Out</th>
                                    <th>Hours</th>
                                    <th>Hours Status</th>
                                </tr>
                            </thead>
                            <tbody>
                `;
                
                data.daily_details.forEach(detail => {
                    // Determine row class based on status
                    let rowClass = detail.row_class;
                    if (detail.is_future_date) {
                        rowClass = 'table-light text-muted';
                    }
                    
                    // Determine if this is a working day that needs hours check
                    const needsHoursCheck = !detail.is_future_date && detail.is_working_day && !detail.is_holiday && detail.status !== 'Holiday' && detail.status !== 'Weekend';
                    
                    html += `
                        <tr class="${rowClass}">
                            <td>${detail.date} ${detail.is_future_date ? '⏳' : ''}</td>
                            <td>${detail.day}</td>
                            <td>
                                ${detail.is_future_date ? '⏳ Future' : 
                                  detail.is_holiday ? '🏖️ Holiday' : 
                                  detail.is_weekend ? '📅 Weekend' : 
                                  '📚 Working Day'}
                            </td>
                            <td><span class="badge ${detail.status_class}">${detail.status}</span></td>
                            <td>${detail.check_in}</td>
                            <td>${detail.check_out}</td>
                            <td>
                                ${detail.hours > 0 ? detail.hours + ' hrs' : '--'}
                                ${needsHoursCheck && data.min_hours_per_day > 0 ? 
                                    `<br><small class="text-muted">Min: ${data.min_hours_per_day} hrs</small>` : 
                                    ''
                                }
                            </td>
                            <td>
                                ${detail.hours_status ? 
                                    `<span class="badge ${detail.has_sufficient_hours ? 'bg-success' : detail.is_future_date ? 'bg-secondary' : 'bg-danger'}">
                                        ${detail.hours_status}
                                    </span>` : 
                                    '<span class="badge bg-secondary">N/A</span>'
                                }
                            </td>
                        </tr>
                    `;
                });
                
                html += `
                            </tbody>
                            <tfoot>
                                <tr class="table-light">
                                    <td colspan="6" class="text-end"><strong>Monthly Totals:</strong></td>
                                    <td><strong>${data.total_hours} hrs</strong></td>
                                    <td><strong>${data.days_with_sufficient_hours}/${data.present_days} days compliant</strong></td>
                                </tr>
                                <tr class="table-light">
                                    <td colspan="6" class="text-end"><strong>Required Monthly Total:</strong></td>
                                    <td colspan="2"><strong>${data.total_required_hours} hrs (${data.working_days} days × ${data.min_hours_per_day} hrs)</strong></td>
                                </tr>
                                <tr class="${data.total_hours >= data.total_required_hours ? 'table-success' : 'table-warning'}">
                                    <td colspan="6" class="text-end"><strong>Monthly Requirement Status:</strong></td>
                                    <td colspan="2">
                                        <strong>
                                            ${data.total_hours >= data.total_required_hours ? '✅ MET' : '❌ NOT MET'} 
                                            (${data.total_hours}/${data.total_required_hours} hrs)
                                        </strong>
                                        <br>
                                        <small>${Math.round((data.total_hours / data.total_required_hours) * 100)}% of monthly requirement</small>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    
                    <div class="row mt-3">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <h6 class="card-title">Statuses</h6>
                                    <div class="d-flex flex-wrap gap-2">
                                        <span class="badge bg-success">Present</span>
                                        <span class="badge bg-danger">Absent</span>
                                        <span class="badge bg-warning">Late</span>
                                        <span class="badge bg-info">Half-day/Holiday</span>
                                        <span class="badge bg-secondary">Weekend</span>
                                        <span class="badge bg-light text-dark">⏳ Future Date</span>
                                        <span class="badge bg-light text-dark">✅ Sufficient hours</span>
                                        <span class="badge bg-light text-dark">❌ Insufficient hours</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <h6 class="card-title">Key Statistics</h6>
                                    <div class="row small">
                                        <div class="col-6">
                                            <span class="text-muted">Working Days:</span> ${data.working_days}
                                        </div>
                                        <div class="col-6">
                                            <span class="text-muted">Weekends:</span> ${data.daily_details.filter(d => d.is_weekend).length}
                                        </div>
                                        <div class="col-6">
                                            <span class="text-muted">Holidays:</span> ${data.daily_details.filter(d => d.is_holiday).length}
                                        </div>
                                        <div class="col-6">
                                            <span class="text-muted">Future Dates:</span> ${data.daily_details.filter(d => d.is_future_date).length}
                                        </div>
                                        <div class="col-6">
                                            <span class="text-muted">Attendance Rate:</span> ${data.attendance_percentage}%
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            } else {
                html += `
                    <div class="alert alert-info">
                        <i class="ti ti-info-circle me-2"></i>
                        No attendance data available for this period.
                    </div>
                `;
            }
            
            modalContent.innerHTML = html;
        })
        .catch(error => {
            console.error('Error loading details:', error);
            modalContent.innerHTML = `
                <div class="alert alert-danger">
                    <i class="ti ti-alert-circle me-2"></i>
                    Error loading details. Please try again.
                </div>
            `;
        });
}

    </script>
{% endblock %}