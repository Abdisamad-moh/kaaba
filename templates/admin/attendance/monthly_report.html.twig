{# templates/admin/attendance/monthly_report.html.twig #}
{% extends 'admin_base2.html.twig' %}

{% block title %}Monthly Attendance Report - Admin{% endblock %}

{% block body %}
    <!-- Page Header -->
    <div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
        <div class="card-body px-4 py-3">
            <div class="row align-items-center">
                <div class="col-9">
                    <h4 class="fw-semibold mb-8">Monthly Attendance Report</h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a class="text-muted text-decoration-none" href="#">Admin</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a class="text-muted text-decoration-none" href="#">Attendance</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">Monthly Report</li>
                        </ol>
                    </nav>
                </div>
                <div class="col-3">
                    <div class="text-end">
                        <a href="{{ path('app_admin_attendance_index') }}" class="btn btn-outline-info me-2">
                            <i class="ti ti-calendar me-2"></i>
                            Daily View
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if no_institutes %}
        <div class="alert alert-warning" role="alert">
            <i class="ti ti-alert-circle me-2"></i>
            You do not manage any institutes to view attendance reports. Please contact the administrator.
        </div>
    {% else %}
      <!-- Update the Filters Card section -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="{{ path('app_admin_attendance_monthly_report') }}" class="row g-3" id="monthlyReportForm">
            <div class="col-md-2">
                <label for="monthYear" class="form-label">Month & Year</label>
                {% set currentMonthYear = "now"|date("Y-m") %}
                {% set selectedMonthYear = selectedYear ~ "-" ~ (selectedMonth < 10 ? "0" ~ selectedMonth : selectedMonth) %}
                <input type="month" 
                       class="form-control" 
                       id="monthYear" 
                       name="monthYear" 
                       value="{{ selectedMonthYear|default(currentMonthYear) }}"
                       max="{{ 'now'|date('Y-m') }}">
            </div>
            <div class="col-md-3">
                {{ form_label(searchForm.applicant, 'Applicant') }}
                {{ form_widget(searchForm.applicant, {'attr': {
                    'class': 'form-control'
                }}) }}
            </div>
            <div class="col-md-2">
                <label for="institute" class="form-label">Institute</label>
                <select class="form-control institute-select" id="institute" name="institute">
                    <option value="">All Institutes</option>
                    {% for institute in managedInstitutes %}
                        <option value="{{ institute.id }}" {{ institute_filter == institute.id ? 'selected' : '' }}>
                            {{ institute.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
     <div class="col-md-2">
    <label for="course" class="form-label">Course</label>
    <select class="form-control course-select" id="course" name="course" {{ not institute_filter ? 'disabled' : '' }}>
        <option value="">Select institute first</option>
        {% if institute_filter and courses %}
            {% for course in courses %}
                <option value="{{ course.id }}" {{ course_filter == course.id ? 'selected' : '' }}>
                    {{ course.name }}
                </option>
            {% endfor %}
        {% endif %}
    </select>
</div>
            <div class="col-md-2">
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-filter me-2"></i>Generate Report
                    </button>
                    <a href="{{ path('app_admin_attendance_monthly_report') }}" class="btn btn-outline-secondary">
                        <i class="ti ti-refresh me-2"></i>Reset
                    </a>
                </div>
            </div>
            <!-- Hidden pagination field -->
            <input type="hidden" name="page" id="pageInput" value="{{ current_page }}">
        </form>
    </div>
</div>


        <!-- Statistics Cards -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card border-start border-primary border-3">
                    <div class="card-body mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted fw-semibold mb-1">Total Students</h6>
                                <h4 class="fw-semibold mb-0">{{ total_items }}</h4>
                            </div>
                            <div class="bg-primary text-white rounded-circle p-3">
                                <i class="ti ti-users fs-6"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-start border-success border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted fw-semibold mb-1">Required Working Days</h6>
                                <h4 class="fw-semibold mb-0">{{ stats.total_required_days }}</h4>
                                <small class="text-muted">{{ months[selectedMonth] }} {{ selectedYear }}</small>
                            </div>
                            <div class="bg-success text-white rounded-circle p-3">
                                <i class="ti ti-calendar-event fs-6"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-start border-info border-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted fw-semibold mb-1">Holidays</h6>
                                <h4 class="fw-semibold mb-0">{{ stats.holiday_count }}</h4>
                                <small class="text-muted">Excluded from working days</small>
                            </div>
                            <div class="bg-info text-white rounded-circle p-3">
                                <i class="ti ti-beach fs-6"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Monthly Report Table -->
        <div class="card">
            <div class="card-body">
                <!-- Table header section -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="card-title mb-0">
                        Monthly Report - {{ months[selectedMonth] }} {{ selectedYear }}
                        {% if stats.future_dates_count > 0 %}
                            <small class="text-muted ms-2">({{ stats.future_dates_count }} future date(s) excluded)</small>
                        {% endif %}
                    </h5>
                    <div>
                        <span class="badge bg-primary">Students: {{ total_items }}</span>
                        <span class="badge bg-success ms-2">Working Days: {{ stats.total_required_days }}</span>
                        <span class="badge bg-info ms-2">Holidays: {{ stats.holiday_count }}</span>
                        {% if stats.future_dates_count > 0 %}
                            <span class="badge bg-warning ms-2">Future Dates: {{ stats.future_dates_count }}</span>
                        {% endif %}
                    </div>
                </div>

                {% if monthlyData|length > 0 %}
                 <div class="table-responsive">
    <table class="table table-hover" id="monthlyReportTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Application ID</th>
                <th>Full Name</th>
                <th>Institute</th>
                <th>Course</th> <!-- NEW COLUMN -->
                <th>Days Present</th>
                <th>Required Days</th>
                <th>Hrs Worked</th>
                <th>Required Hrs Total</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            {% for data in monthlyData %}
                <tr>
                    <td>{{ offset + loop.index }}</td>
                    <td>
                        <a href="{{ path('app_admin_kaaba_application_view', {'uuid': data.application_id}) }}" class="text-primary text-decoration-none">
                            #{{ data.application_id }}
                        </a>
                    </td>
                    <td>
                        <div class="d-flex align-items-center">
                            <div>
                                <h6 class="mb-0">{{ data.full_name }}</h6>
                                <small class="text-muted">{{ data.phone }}</small>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="badge bg-info">{{ data.institute_name ?: 'No Institute' }}</span>
                        {% if data.min_hours_per_day > 0 %}
                            <br><small class="text-muted">Min: {{ data.min_hours_per_day }} hrs/day</small>
                        {% endif %}
                    </td>
                    <td>
                        <!-- NEW COLUMN: Course -->
                        {% if data.course_name %}
                            <span class="badge bg-secondary">{{ data.course_name }}</span>
                        {% else %}
                            <span class="badge bg-light text-dark">No Course</span>
                        {% endif %}
                    </td>
                    <td>
                        <span class="badge {{ data.days_present >= data.required_days ? 'bg-success' : 'bg-warning' }}">
                            {{ data.days_present }}
                        </span>
                        {% set working_days_up_to_today = data.required_days - data.future_working_days|default(0) %}
                        {% if working_days_up_to_today < data.required_days %}
                            <br><small class="text-muted">of {{ working_days_up_to_today }} days so far</small>
                        {% endif %}
                    </td>
                    <td>
                        <span class="badge bg-secondary">{{ data.required_days }}</span>
                        {% if data.future_working_days|default(0) > 0 %}
                            <br><small class="text-muted">({{ data.future_working_days }} future)</small>
                        {% endif %}
                    </td>
                  <td>
    {% set totalMinutes = (data.total_hours * 60)|round(0, 'floor') %}
    {% set hours = (totalMinutes / 60)|round(0, 'floor') %}
    {% set minutes = totalMinutes - (hours * 60) %}

    <span class="badge bg-info">
        {% if hours < 1 %}
            {{ minutes }}min
        {% else %}
            {{ hours }}hr{% if minutes > 0 %} {{ minutes }}min{% endif %}
        {% endif %}
    </span>
</td>

                    <td>
                        {% if data.required_hours_total > 0 %}
                            <span class="badge {{ data.total_hours >= data.required_hours_total ? 'bg-success' : 'bg-warning' }}">
                                {{ data.required_hours_total|number_format(1) }} hrs
                            </span>
                            {% if data.future_working_days|default(0) > 0 and data.min_hours_per_day > 0 %}
                                {% set future_hours = data.future_working_days * data.min_hours_per_day %}
                                <br><small class="text-muted">({{ future_hours|number_format(1) }} hrs future)</small>
                            {% endif %}
                        {% else %}
                            <span class="badge bg-secondary">
                                N/A
                            </span>
                        {% endif %}
                    </td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary" 
                            data-bs-toggle="modal" 
                            data-bs-target="#detailsModal{{ data.application_id }}"
                            onclick="loadMonthlyDetails({{ data.application_id }}, {{ selectedYear }}, {{ selectedMonth }})">
                            <i class="ti ti-eye me-1"></i>View
                        </button>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>


                    <!-- Pagination -->
                    {% if total_pages > 1 %}
                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <div class="text-muted">
                                Showing {{ offset + 1 }} to {{ min(offset + per_page, total_items) }} of {{ total_items }} entries
                            </div>
                            <nav aria-label="Page navigation">
                                <ul class="pagination mb-0">
                                    <!-- Previous button -->
                                    <li class="page-item {{ not has_prev_page ? 'disabled' : '' }}">
                                        <a class="page-link" href="{{ path('app_admin_attendance_monthly_report', app.request.query.all|merge({page: prev_page})) }}" aria-label="Previous">
                                            <i class="ti ti-chevron-left"></i>
                                        </a>
                                    </li>
                                    
                                    <!-- Page numbers -->
                                    {% set start_page = max(1, current_page - 2) %}
                                    {% set end_page = min(total_pages, start_page + 4) %}
                                    
                                    {% if start_page > 1 %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ path('app_admin_attendance_monthly_report', app.request.query.all|merge({page: 1})) }}">1</a>
                                        </li>
                                        {% if start_page > 2 %}
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        {% endif %}
                                    {% endif %}
                                    
                                    {% for i in start_page..end_page %}
                                        <li class="page-item {{ i == current_page ? 'active' : '' }}">
                                            <a class="page-link" href="{{ path('app_admin_attendance_monthly_report', app.request.query.all|merge({page: i})) }}">{{ i }}</a>
                                        </li>
                                    {% endfor %}
                                    
                                    {% if end_page < total_pages %}
                                        {% if end_page < total_pages - 1 %}
                                            <li class="page-item disabled">
                                                <span class="page-link">...</span>
                                            </li>
                                        {% endif %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ path('app_admin_attendance_monthly_report', app.request.query.all|merge({page: total_pages})) }}">{{ total_pages }}</a>
                                        </li>
                                    {% endif %}
                                    
                                    <!-- Next button -->
                                    <li class="page-item {{ not has_next_page ? 'disabled' : '' }}">
                                        <a class="page-link" href="{{ path('app_admin_attendance_monthly_report', app.request.query.all|merge({page: next_page})) }}" aria-label="Next">
                                            <i class="ti ti-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                            
                            <!-- Items per page selector -->
                            <div class="d-flex align-items-center">
                                <span class="text-muted me-2">Items per page:</span>
                                <select class="form-select form-select-sm w-auto" id="perPageSelect">
                                    <option value="10" {{ per_page == 10 ? 'selected' : '' }}>10</option>
                                    <option value="20" {{ per_page == 20 ? 'selected' : '' }}>20</option>
                                    <option value="50" {{ per_page == 50 ? 'selected' : '' }}>50</option>
                                    <option value="100" {{ per_page == 100 ? 'selected' : '' }}>100</option>
                                </select>
                            </div>
                        </div>
                    {% endif %}
                    
                {% else %}
                    <div class="text-center py-5">
                        <div class="mb-3">
                            <i class="ti ti-calendar-off fs-1 text-muted"></i>
                        </div>
                        <h5 class="text-muted">No attendance data found for {{ months[selectedMonth] }} {{ selectedYear }}</h5>
                        <p class="text-muted mb-0">
                            {% if applicant_filter or institute_filter %}
                                Try adjusting your filters
                            {% else %}
                                No attendance data has been recorded for this period
                            {% endif %}
                        </p>
                    </div>
                {% endif %}
            </div>
        </div>

     <!-- Month Navigation -->
<div class="card mt-4">
    <div class="card-body">
        <div class="d-flex justify-content-center gap-2">
            {% set prevMonthDate = (selectedYear ~ '-' ~ selectedMonth ~ '-01')|date_modify('-1 month') %}
            {% set nextMonthDate = (selectedYear ~ '-' ~ selectedMonth ~ '-01')|date_modify('+1 month') %}
            
            <a href="{{ path('app_admin_attendance_monthly_report', app.request.query.all|merge({
                monthYear: prevMonthDate|date('Y-m'),
                page: 1
            })) }}" class="btn btn-outline-primary">
                <i class="ti ti-chevron-left me-2"></i>Previous Month
            </a>
            
            <a href="{{ path('app_admin_attendance_monthly_report', {
                monthYear: "now"|date("Y-m"),
                page: 1
            }) }}" class="btn btn-primary">
                <i class="ti ti-calendar me-2"></i>Current Month
            </a>
            
            <a href="{{ path('app_admin_attendance_monthly_report', app.request.query.all|merge({
                monthYear: nextMonthDate|date('Y-m'),
                page: 1
            })) }}" class="btn btn-outline-primary">
                Next Month<i class="ti ti-chevron-right ms-2"></i>
            </a>
        </div>
    </div>
</div>

        <!-- Details Modals (One for each student) -->
        {% for data in monthlyData %}
            <div class="modal fade" id="detailsModal{{ data.application_id }}" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                Monthly Details - {{ data.full_name }} ({{ months[selectedMonth] }} {{ selectedYear }})
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body" id="detailsContent{{ data.application_id }}">
                            <div class="text-center">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mt-2">Loading details...</p>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <div class="me-auto">
                                <small class="text-muted">
                                    <i class="ti ti-info-circle me-1"></i>
                                    Weekends and holidays are excluded from working days calculation
                                </small>
                            </div>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    
    <script>
        // Auto-submit month picker changes - FIXED SELECTOR
        const monthYearInput = document.querySelector('#monthYear');
        if (monthYearInput) {
            monthYearInput.addEventListener('change', function() {
                document.getElementById('pageInput').value = 1; // Reset to page 1
                document.getElementById('monthlyReportForm').submit();
            });
        }

        // Items per page selector - FIXED SELECTOR
        const perPageSelect = document.querySelector('#perPageSelect');
        if (perPageSelect) {
            perPageSelect.addEventListener('change', function() {
                document.getElementById('pageInput').value = 1; // Reset to page 1
                // Add per_page parameter to form
                const form = document.getElementById('monthlyReportForm');
                let perPageInput = document.querySelector('input[name="per_page"]');
                if (!perPageInput) {
                    perPageInput = document.createElement('input');
                    perPageInput.type = 'hidden';
                    perPageInput.name = 'per_page';
                    form.appendChild(perPageInput);
                }
                perPageInput.value = this.value;
                form.submit();
            });
        }

        // Dynamic institute/course handling for monthly report
        document.addEventListener('DOMContentLoaded', function() {
            const instituteSelect = document.getElementById('institute');
            const courseSelect = document.getElementById('course');
            
            if (instituteSelect && courseSelect) {
                console.log('Institute and course selects found');
                
                // Store initial course options
                const initialCourseHtml = courseSelect.innerHTML;
                
                instituteSelect.addEventListener('change', function() {
                    console.log('Institute changed to:', this.value);
                    const instituteId = this.value;
                    
                    // Clear and disable course select
                    courseSelect.innerHTML = '<option value="">Loading courses...</option>';
                    courseSelect.disabled = true;
                    
                    if (!instituteId) {
                        // Reset to initial state
                        courseSelect.innerHTML = initialCourseHtml;
                        courseSelect.disabled = true;
                        return;
                    }
                    
                    // Get current selected course from URL parameters
                    const urlParams = new URLSearchParams(window.location.search);
                    const selectedCourseId = urlParams.get('course');
                    
                    // Fetch courses for the selected institute
                    fetch(`{{ path('app_admin_attendance_courses_by_institute', {'instituteId': '__INSTITUTE_ID__'}) }}`.replace('__INSTITUTE_ID__', instituteId))
                        .then(response => {
                            if (!response.ok) {
                                throw new Error(`HTTP ${response.status}`);
                            }
                            return response.json();
                        })
                        .then(data => {
                            console.log('Courses data received:', data);
                            
                            // Clear existing options
                            courseSelect.innerHTML = '';
                            
                            // Add default option
                            const defaultOption = document.createElement('option');
                            defaultOption.value = '';
                            defaultOption.textContent = data.courses && data.courses.length > 0 
                                ? 'Select course' 
                                : 'No courses available';
                            courseSelect.appendChild(defaultOption);
                            
                            // Add course options
                            if (data.courses && data.courses.length > 0) {
                                data.courses.forEach(course => {
                                    const option = document.createElement('option');
                                    option.value = course.id;
                                    option.textContent = course.name;
                                    
                                    // Preselect if this was the selected course
                                    if (selectedCourseId && course.id == selectedCourseId) {
                                        option.selected = true;
                                    }
                                    
                                    courseSelect.appendChild(option);
                                });
                            }
                            
                            // Re-enable select
                            courseSelect.disabled = false;
                            
                            console.log('Courses loaded successfully for institute:', instituteId);
                        })
                        .catch(error => {
                            console.error('Error loading courses:', error);
                            courseSelect.innerHTML = '<option value="">Error loading courses</option>';
                            courseSelect.disabled = false;
                        });
                });
                
                // If institute is already selected on page load, load its courses
                if (instituteSelect.value) {
                    console.log('Initial institute value:', instituteSelect.value);
                    instituteSelect.dispatchEvent(new Event('change'));
                } else {
                    // If no institute selected, disable course select
                    courseSelect.disabled = true;
                }
            } else {
                console.log('Institute or course select not found');
                if (!instituteSelect) console.log('Institute select missing');
                if (!courseSelect) console.log('Course select missing');
            }
        });


        function loadMonthlyDetails(applicationId, year, month) {
            const modalContent = document.getElementById(`detailsContent${applicationId}`);
            
            // Show loading spinner
            modalContent.innerHTML = `
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading detailed attendance...</p>
                </div>
            `;
            
            // Make AJAX request
            fetch(`/admin/attendance/monthly-details/${applicationId}?year=${year}&month=${month}`)
                .then(response => response.json())
                .then(data => {
                    // Extract data from the response
                    const minHoursPerDay = data.min_hours_per_day || 0;
                    const instituteName = data.institute_name || 'No Institute';
                    const requiredHoursTotal = data.required_hours_total || 0;
                    const workingDays = data.working_days || 0;
                    const workingDaysUpToToday = data.working_days_up_to_today || 0;
                    const presentDays = data.present_days || 0;
                    const absentDays = data.absent_days || 0;
                    const totalHours = data.total_hours || 0;
                    const fullName = data.full_name || '';
                    const monthSummary = data.month_summary || { month_name: '', year: '' };
                    const dailyDetails = data.daily_details || [];
                    
                    let html = `
                        <div class="row mb-4">
                            <div class="col-md-12">
                                <div class="card">
                                    <div class="card-body">
                                        <h6 class="card-title">Student Info</h6>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <p class="mb-1"><strong>Name:</strong> ${fullName}</p>
                                                <p class="mb-1"><strong>Institute:</strong> ${instituteName}</p>
                                                <p class="mb-0"><strong>Min Hours/Day:</strong> ${minHoursPerDay > 0 ? minHoursPerDay + ' hrs' : 'Not set'}</p>
                                            </div>
                                        
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mb-4">
                            <div class="col-md-4">
                                <div class="card border-start border-success border-3">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h5 class="text-muted fw-semibold mb-1">Days Present</h6>
                                                <h4 class="fw-semibold mb-2">${presentDays}</h4>
                                            </div>
                                            <div class="bg-success text-white rounded-circle p-3">
                                                <i class="ti ti-calendar fs-6"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-start border-secondary border-3">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h5 class="text-muted fw-semibold mb-1">Required Days</h6>
                                                <h4 class="fw-semibold mb-0">${workingDays}</h4>
                                                ${workingDays - workingDaysUpToToday > 0 ? 
                                                    `<small class="text-muted">(${workingDays - workingDaysUpToToday} future)</small>` : 
                                                    '<small class="text-muted">Full month</small>'
                                                }
                                            </div>
                                            <div class="bg-secondary text-white rounded-circle p-3">
                                                <i class="ti ti-calendar-event fs-6"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card border-start border-info border-3">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h5 class="text-muted fw-semibold mb-1">Hrs Worked</h6>
                                                <h4 class="fw-semibold mb-0">${totalHours.toFixed(1)}</h4>
                                                <small class="text-muted">hours</small>
                                            </div>
                                            <div class="bg-info text-white rounded-circle p-3">
                                                <i class="ti ti-clock fs-6"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                      
                        </div>
                    `;
                    
                    // Monthly Hours Requirement section
                    if (minHoursPerDay > 0 && requiredHoursTotal > 0) {
                        const percentage = totalHours > 0 ? Math.round((totalHours / requiredHoursTotal) * 100) : 0;
                        html += `
                            <div class="alert ${totalHours >= requiredHoursTotal ? 'alert-success' : 'alert-warning'} mb-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="alert-heading mb-1">Monthly Hours Requirement Status</h6>
                                        <p class="mb-0">
                                            ${totalHours.toFixed(1)} / ${requiredHoursTotal.toFixed(1)} hours
                                            (${percentage}% of monthly requirement)
                                        </p>
                                    </div>
                                    <div class="text-end">
                                        ${totalHours >= requiredHoursTotal ? 
                                            '<span class="badge bg-success fs-6">REQUIREMENT MET</span>' : 
                                            '<span class="badge bg-warning fs-6">REQUIREMENT NOT MET</span>'
                                        }
                                    </div>
                                </div>
                            </div>
                        `;
                    }
                    
                    html += `<h6 class="mb-3">Daily Attendance - ${monthSummary.month_name} ${monthSummary.year}</h6>`;
                    
                    if (dailyDetails.length > 0) {
                        html += `
                            <div class="table-responsive">
                                <table class="table table-sm table-hover">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Day</th>
                                            <th>Type</th>
                                            <th>Status</th>
                                            <th>Check In</th>
                                            <th>Check Out</th>
                                            <th>Hours</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;
                        
                        // Count statuses
                        const statusCounts = {
                            present: 0,
                            absent: 0,
                            future: 0,
                            holiday: 0,
                            weekend: 0
                        };
                        
                        dailyDetails.forEach(detail => {
                            // Determine status for counting
                            const status = detail.status.toLowerCase();
                            if (detail.is_future_date) {
                                statusCounts.future++;
                            } else if (detail.is_holiday) {
                                statusCounts.holiday++;
                            } else if (detail.is_weekend) {
                                statusCounts.weekend++;
                            } else if (status === 'present' || status === 'late' || status === 'half-day') {
                                statusCounts.present++;
                            } else if (status === 'absent') {
                                statusCounts.absent++;
                            }
                            
                            // Determine row class
                            let rowClass = detail.row_class || '';
                            let typeIcon = '';
                            let typeText = '';
                            
                            if (detail.is_future_date) {
                                rowClass = 'table-light text-muted';
                                typeIcon = '⏳';
                                typeText = 'Future';
                            } else if (detail.is_holiday) {
                                typeIcon = '🏖️';
                                typeText = 'Holiday';
                            } else if (detail.is_weekend) {
                                typeIcon = '📅';
                                typeText = 'Weekend';
                            } else {
                                typeIcon = '📚';
                                typeText = 'Working Day';
                            }
                            
                            // Determine if hours meet minimum requirement
                            let hoursStatus = '';
                            if (!detail.is_future_date && !detail.is_holiday && !detail.is_weekend && 
                                detail.status !== 'Weekend' && detail.status !== 'Holiday' && 
                                minHoursPerDay > 0 && detail.hours > 0) {
                                const meetsRequirement = detail.hours >= minHoursPerDay;
                                hoursStatus = meetsRequirement ? 
                                    `<span class="badge bg-success ms-1">✓</span>` : 
                                    `<span class="badge bg-danger ms-1">✗ ${minHoursPerDay}hrs</span>`;
                            }
                            
                            html += `
                                <tr class="${rowClass}">
                                    <td>${detail.date}</td>
                                    <td>${detail.day}</td>
                                    <td>${typeIcon} ${typeText}</td>
                                    <td><span class="badge ${detail.status_class}">${detail.status}</span></td>
                                    <td>${detail.check_in}</td>
                                    <td>${detail.check_out}</td>
                                    <td>
                                        ${detail.hours > 0 ? detail.hours.toFixed(1) + ' hrs' : '--'}
                                        ${hoursStatus}
                                    </td>
                                </tr>
                            `;
                        });
                        
                        html += `
                                </tbody>
                            </table>
                        </div>
                        
                        <div class="row mt-4">
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-body">
                                        <h6 class="card-title">Status Summary</h6>
                                        <div class="d-flex flex-wrap gap-2">
                                            ${statusCounts.present > 0 ? `<span class="badge bg-success">Present: ${statusCounts.present}</span>` : ''}
                                            ${statusCounts.absent > 0 ? `<span class="badge bg-danger">Absent: ${statusCounts.absent}</span>` : ''}
                                            ${statusCounts.future > 0 ? `<span class="badge bg-light text-dark">⏳ Future: ${statusCounts.future}</span>` : ''}
                                            ${statusCounts.holiday > 0 ? `<span class="badge bg-info">🏖️ Holiday: ${statusCounts.holiday}</span>` : ''}
                                            ${statusCounts.weekend > 0 ? `<span class="badge bg-secondary">📅 Weekend: ${statusCounts.weekend}</span>` : ''}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card">
                                    <div class="card-body">
                                        <h6 class="card-title">Month Overview</h6>
                                        <div class="row small">
                                            <div class="col-6 mb-2">
                                                <span class="text-muted">Total Days:</span> ${dailyDetails.length}
                                            </div>
                                            <div class="col-6 mb-2">
                                                <span class="text-muted">Working Days:</span> ${workingDays}
                                            </div>
                                            <div class="col-6 mb-2">
                                                <span class="text-muted">Present:</span> ${statusCounts.present}
                                            </div>
                                            <div class="col-6 mb-2">
                                                <span class="text-muted">Absent:</span> ${statusCounts.absent}
                                            </div>
                                            <div class="col-6 mb-2">
                                                <span class="text-muted">Holidays:</span> ${statusCounts.holiday}
                                            </div>
                                            <div class="col-6 mb-2">
                                                <span class="text-muted">Weekends:</span> ${statusCounts.weekend}
                                            </div>
                                            <div class="col-6 mb-2">
                                                <span class="text-muted">Future Dates:</span> ${statusCounts.future}
                                            </div>
                                            <div class="col-12 mt-2">
                                                <span class="text-muted">Hours Worked:</span> <strong>${totalHours.toFixed(1)} hrs</strong>
                                            </div>
                                            ${minHoursPerDay > 0 ? `
                                                <div class="col-12 mt-2">
                                                    <span class="text-muted">Required Hours:</span> <strong>${requiredHoursTotal.toFixed(1)} hrs</strong>
                                                </div>
                                            ` : ''}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    } else {
                        html += `
                            <div class="alert alert-info">
                                <i class="ti ti-info-circle me-2"></i>
                                No attendance data available for this period.
                            </div>
                        `;
                    }
                    
                    modalContent.innerHTML = html;
                })
                .catch(error => {
                    console.error('Error loading details:', error);
                    modalContent.innerHTML = `
                        <div class="alert alert-danger">
                            <i class="ti ti-alert-circle me-2"></i>
                            Error loading details. Please try again.
                        </div>
                    `;
                });
        }
    </script>
{% endblock %}