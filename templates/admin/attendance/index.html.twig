{% extends 'admin_base2.html.twig' %}
{% block title %}Daily Attendance - Admin
{% endblock %}

{% block body %}
	<!-- Page Header -->
	<div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
		<div class="card-body px-4 py-3">
			<div class="row align-items-center">
				<div class="col-9">
					<h4 class="fw-semibold mb-8">Daily Attendance</h4>
					<nav aria-label="breadcrumb">
						<ol class="breadcrumb">
							<li class="breadcrumb-item">
								<a class="text-muted text-decoration-none" href="#">Admin</a>
							</li>
							<li class="breadcrumb-item">
								<a class="text-muted text-decoration-none" href="#">Dashboard</a>
							</li>
							<li class="breadcrumb-item active" aria-current="page">Daily Attendance</li>
						</ol>
					</nav>
				</div>
				<div class="col-3">
					<div class="text-end">
						<a href="{{ path('app_admin_attendance_monthly_report') }}" class="btn btn-outline-info me-2">
    <i class="ti ti-calendar-stats me-2"></i>
    Monthly Report
</a>
					</div>
				</div>
			</div>
		</div>
	</div>

	{% if no_institutes %}
		<div class="alert alert-warning" role="alert">
			<i class="ti ti-alert-circle me-2"></i>
			You do not manage any institutes to view attendance. Please contact the administrator.
		</div>
	{% else %}
		<!-- Day Type Indicator -->
		{% if isHoliday %}
			<div class="alert alert-info mb-4" role="alert">
				<i class="ti ti-calendar-event me-2"></i>
				<strong>Today is a Holiday:</strong> {{ selectedDate|date('F j, Y') }} - No attendance required
			</div>
		{% elseif not isSchoolDay %}
			<div class="alert alert-secondary mb-4" role="alert">
				<i class="ti ti-calendar-off me-2"></i>
				<strong>Weekend:</strong> {{ selectedDate|date('F j, Y') }} - No school today
			</div>
		{% endif %}

		<!-- Filters Card -->
		<div class="card mb-4">
			<div class="card-body">
				{{ form_start(searchForm, {'attr': {'class': 'row g-3'}}) }}
					<div class="col-md-3">
						{{ form_label(searchForm.date) }}
						{{ form_widget(searchForm.date, {'attr': {'class': 'form-control'}}) }}
					</div>
					<div class="col-md-3">
						{{ form_label(searchForm.applicant) }}
						{{ form_widget(searchForm.applicant, {'attr': {'class': 'form-control'}}) }}
					</div>
					<div class="col-md-3">
						{{ form_label(searchForm.institute) }}
						{{ form_widget(searchForm.institute, {'attr': {'class': 'form-control'}}) }}
					</div>
					<div class="col-md-3">
						{{ form_label(searchForm.status) }}
						{{ form_widget(searchForm.status, {'attr': {'class': 'form-control'}}) }}
					</div>
					<div class="col-md-12">
						<button type="submit" class="btn btn-primary me-2">
							<i class="ti ti-filter me-2"></i>Filter
						</button>
						<a href="{{ path('app_admin_attendance_index') }}" class="btn btn-outline-secondary">
							<i class="ti ti-refresh me-2"></i>Reset
						</a>
					</div>
				{{ form_end(searchForm) }}
			</div>
		</div>

		<!-- Statistics Cards - Only show for school days -->
		{% if isSchoolDay and not isHoliday %}
			<div class="row mb-4">
				<div class="col-md-3">
					<div class="card border-start border-primary border-3">
						<div class="card-body">
							<div class="d-flex justify-content-between align-items-center">
								<div>
									<h6 class="text-muted fw-semibold mb-1">Total Students</h6>
									<h4 class="fw-semibold mb-0">{{ stats.total_employees }}</h4>
								</div>
								<div class="bg-primary text-white rounded-circle p-3">
									<i class="ti ti-users fs-6"></i>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="col-md-3">
					<div class="card border-start border-success border-3">
						<div class="card-body">
							<div class="d-flex justify-content-between align-items-center">
								<div>
									<h6 class="text-muted fw-semibold mb-1">Present Today</h6>
									<h4 class="fw-semibold mb-0">{{ stats.present }}</h4>
									<small class="text-muted">{{ stats.present }}
										Present</small>
								</div>
								<div class="bg-success text-white rounded-circle p-3">
									<i class="ti ti-check fs-6"></i>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="col-md-3">
					<div class="card border-start border-danger border-3">
						<div class="card-body">
							<div class="d-flex justify-content-between align-items-center">
								<div>
									<h6 class="text-muted fw-semibold mb-1">Absent Today</h6>
									<h4 class="fw-semibold mb-0">{{ stats.absent }}</h4>
								</div>
								<div class="bg-danger text-white rounded-circle p-3">
									<i class="ti ti-x fs-6"></i>
								</div>
							</div>
						</div>
					</div>
				</div>
			
			</div>
		{% endif %}

		<!-- Attendance Table -->
		<div class="card">
			<div class="card-body">
				<div class="d-flex justify-content-between align-items-center mb-4">
					<h5 class="card-title mb-0">
						{% if isHoliday %}
							Holiday: {{ selectedDate|date('F j, Y') }}
						{% elseif not isSchoolDay %}
							Weekend: {{ selectedDate|date('F j, Y') }}
						{% else %}
							Attendance for {{ selectedDate|date('F j, Y') }}
						{% endif %}
					</h5>
					{% if isSchoolDay and not isHoliday %}
						<div>
							<span class="badge bg-primary">Total Hours:
								{{ stats.total_hours|number_format(2) }}</span>
						</div>
					{% endif %}
				</div>

				{% if attendanceData|length > 0 %}
					<div class="table-responsive">
						<table class="table table-hover">
							<thead>
								<tr>
									<th>#</th>
									<th>Application ID</th>
									<th>Full Name</th>
									<th>Institute</th>
									<th>Check In</th>
									<th>Check Out</th>
									<th>Total Hours</th>
									<th>Status</th>
									<!-- <th>Records</th> -->
									<!-- <th>Actions</th> -->
								</tr>
							</thead>
							<tbody>
								{% for data in attendanceData %}
									{% set app = data.application %}
									<tr>
										<td>{{ loop.index }}</td>
										<td>
											<a href="{{ path('app_admin_kaaba_application_view', {'uuid': app.uuid}) }}" class="text-primary text-decoration-none">
												#{{ app.id }}
											</a>
										</td>
										<td>
											<div class="d-flex align-items-center">
												<div>
													<h6 class="mb-0">{{ app.fullName }}</h6>
													<small class="text-muted">{{ app.phone }}</small>
												</div>
											</div>
										</td>
										<td>
											{% if data.institute %}
												<span class="badge bg-info">{{ data.institute.name }}</span>
											{% else %}
												<span class="badge bg-secondary">No Institute</span>
											{% endif %}
										</td>
										<td>
											{% if data.check_in %}
												<span class="badge bg-light text-dark">
													{{ data.check_in|date('h:i A') }}
												</span>
											{% else %}
												<span class="badge bg-danger">No Check-in</span>
											{% endif %}
										</td>
										<td>
											{% if data.check_out %}
												<span class="badge bg-light text-dark">
													{{ data.check_out|date('h:i A') }}
												</span>
											{% else %}
												<span class="badge bg-warning">No Check-out</span>
											{% endif %}
										</td>
										<td>
											<span class="badge bg-info">
												{{ data.total_hours|default(0)|number_format(2) }}
												hrs
											</span>
										</td>
										<td>
											{% if isHoliday %}
												<span class="badge bg-info">Holiday</span>
											{% elseif not isSchoolDay %}
												<span class="badge bg-secondary">Weekend</span>
											{% else %}
												{% if data.status == 'present' %}
													<span class="badge bg-success">Present</span>
												{% elseif data.status == 'absent' %}
													<span class="badge bg-danger">Absent</span>
												{% else %}
													<span class="badge bg-warning">{{ data.status|title }}</span>
												{% endif %}
											{% endif %}
										</td>
										<!-- <td>
											<button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#recordsModal{{ app.id }}">
												{{ data.records_count }}
												records
											</button>
										</td> -->
										<!-- <td>
											<div class="dropdown">
												<button class="btn btn-sm btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
													Actions
												</button>
												<ul class="dropdown-menu">
													<li>
														<a class="dropdown-item" href="{{ path('app_admin_attendance_application', {'id': app.id}) }}">
															<i class="ti ti-calendar me-2"></i>View History
														</a>
													</li>
													{% if isSchoolDay and not isHoliday %}
														<li>
															<button class="dropdown-item" data-bs-toggle="modal" data-bs-target="#verifyModal{{ data.attendance_id }}">
																<i class="ti ti-shield-check me-2"></i>
																{% if data.is_verified %}Update Verification{% else %}Verify
																{% endif %}
															</button>
														</li>
													{% endif %}
												</ul>
											</div>
										</td> -->
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				{% else %}
					<div class="text-center py-5">
						<div class="mb-3">
							{% if isHoliday %}
								<i class="ti ti-calendar-event fs-1 text-info"></i>
							{% elseif not isSchoolDay %}
								<i class="ti ti-calendar-off fs-1 text-secondary"></i>
							{% else %}
								<i class="ti ti-calendar-off fs-1 text-muted"></i>
							{% endif %}
						</div>
						<h5 class="text-muted">
							{% if isHoliday %}
								No attendance required - Holiday
							{% elseif not isSchoolDay %}
								No attendance required - Weekend
							{% else %}
								No attendance records found for {{ selectedDate|date('F j, Y') }}
							{% endif %}
						</h5>
						<p class="text-muted mb-0">
							{% if searchForm.applicant.vars.value or searchForm.institute.vars.value or searchForm.status.vars.value %}
								Try adjusting your filters
							{% elseif isSchoolDay and not isHoliday %}
								No attendance data has been recorded for this date
							{% endif %}
						</p>
					</div>
				{% endif %}
			</div>
		</div>

		<!-- Quick Date Navigation -->
		<div class="card mt-4">
			<div class="card-body">
				<div class="d-flex justify-content-center gap-2">
					<a href="{{ path('app_admin_attendance_index', {'date': selectedDate|date_modify('-1 day')|date('Y-m-d')}) }}" class="btn btn-outline-primary">
						<i class="ti ti-chevron-left me-2"></i>Previous Day
					</a>
					<a href="{{ path('app_admin_attendance_index') }}" class="btn btn-primary">
						<i class="ti ti-calendar me-2"></i>Today
					</a>
					<a href="{{ path('app_admin_attendance_index', {'date': selectedDate|date_modify('+1 day')|date('Y-m-d')}) }}" class="btn btn-outline-primary">
						Next Day<i class="ti ti-chevron-right ms-2"></i>
					</a>
				</div>
			</div>
		</div>
	{% endif %}
{% endblock %}

{% block javascripts %}
	{{ parent() }}

	<script>
		// Auto-submit date changes
		document.getElementById('date').addEventListener('change', function() {
			this.form.submit();
		});

		// Quick date navigation
		document.addEventListener('DOMContentLoaded', function() {
			// Today button
			document.querySelectorAll('[data-date-today]').forEach(btn => {
				btn.addEventListener('click', function() {
					const today = new Date().toISOString().split('T')[0];
					document.getElementById('date').value = today;
					document.getElementById('date').form.submit();
				});
			});
		});
	</script>
{% endblock %}