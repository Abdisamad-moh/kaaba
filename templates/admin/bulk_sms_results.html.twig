{% extends 'admin_base2.html.twig' %}

{% block title %}SMS Results{% endblock %}

{% block body %}
<div class="container mt-4">

    <div class="alert alert-info">
        <strong>{{ count }}</strong> applications matched the filters.
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">SMS Sending Results</h5>
        </div>

        <div class="card-body p-0">
            <table class="table table-bordered table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Gateway Response</th>
                    </tr>
                </thead>
                <tbody>
                    {% for r in results %}
                        <tr>
    <td>{{ loop.index }}</td>
    <td>{{ r.receiverName }}</td>
    <td>{{ r.phoneNumber ?: 'N/A' }}</td>

    <td>
        {% if r.messageStatus == 'success' %}
            <span class="badge bg-success">Sent</span>
        {% elseif r.messageStatus == 'skipped' %}
            <span class="badge bg-secondary">Skipped</span>
        {% elseif r.messageStatus == 'timeout' %}
            <span class="badge bg-warning text-dark">Timeout</span>
        {% elseif r.messageStatus == 'error' %}
            <span class="badge bg-danger">Error</span>
        {% else %}
            <span class="badge bg-dark">Unknown</span>
        {% endif %}
    </td>

    <td><code>{{ r.gatewayResponse }}</code></td>
</tr>

                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>

    <div class="mt-3">
        <a href="{{ path('app_admin_bulk_sms') }}" class="btn btn-primary">Back</a>
    </div>

</div>
{% endblock %}
