{# templates/admin/sms/jobs.html.twig #}

{% extends 'admin_base2.html.twig' %}

{% block body %}
<div class="container mt-4">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">SMS Jobs</h5>
            <a href="{{ path('app_admin_bulk_sms') }}" class="btn btn-primary btn-sm">
                New Bulk SMS
            </a>
        </div>
        <div class="card-body">
            {% if jobs|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Job ID</th>
                                <th>Created</th>
                                <th>Status</th>
                                <th>Recipients</th>
                                <th>Sent/Failed</th>
                                <th>Completed</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for job in jobs %}
                                <tr>
                                    <td>
                                        <code>{{ job.id|slice(0, 8) }}...</code>
                                    </td>
                                    <td>{{ job.createdAt|date('Y-m-d H:i') }}</td>
                                    <td>
                                        <span class="badge bg-{{ 
                                            job.status == 'completed' ? 'success' : 
                                            job.status == 'failed' ? 'danger' : 
                                            job.status == 'processing' ? 'warning' : 
                                            'secondary'
                                        }}">
                                            {{ job.status|upper }}
                                        </span>
                                    </td>
                                    <td>{{ job.totalRecipients ?? '—' }}</td>
                                    <td>
                                        {% if job.sentCount is not null %}
                                            {{ job.sentCount }} / {{ job.failedCount }}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td>{{ job.completedAt ? job.completedAt|date('Y-m-d H:i') : '—' }}</td>
                                    <td>
                                        <a href="{{ path('app_admin_sms_job_detail', {id: job.id}) }}" 
                                           class="btn btn-sm btn-info">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="alert alert-info">
                    No SMS jobs found. <a href="{{ path('app_admin_bulk_sms') }}">Send your first bulk SMS</a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}