{% extends 'admin_base2.html.twig' %}

{% block title %}Exam Result - {{ application.fullName }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="card shadow p-4">

        <h3 class="fw-bold mb-4">Exam Result – {{ application.fullName }}</h3>

        {{ form_start(form, { 'attr': { 'enctype': 'multipart/form-data' } }) }}

        <div class="row g-3">

            <div class="col-md-4">
    <label class="form-label">Exam Result</label>
    {{ form_widget(form.examResult, {'attr': {'class': 'form-control'}}) }}
</div>

            <div class="col-md-8">
                <label class="form-label">Attachment (Optional)</label>
                {{ form_widget(form.attachment, {'attr': {'class': 'form-control'}}) }}

                {% if application.exam and application.exam.attachment %}
                    <a href="{{ path('app_application_attachments', {
                        filename: application.exam.attachment
                    }) }}"
                       target="_blank"
                       class="mt-2 btn btn-outline-primary btn-sm">
                        <i class="ti ti-file"></i> View Existing File
                    </a>
                {% endif %}
            </div>

            <div class="col-12">
                <label class="form-label">Description</label>
                {{ form_widget(form.description, {
                    'attr': { 'class': 'form-control', 'rows': 4 }
                }) }}
            </div>

        </div>

        <div class="d-flex justify-content-between mt-4">
            <a href="{{ path('app_admin_kaaba_applications') }}"
               class="btn btn-outline-secondary">Back</a>

            <button type="submit" class="btn btn-primary px-4">
                Save Exam Result
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
