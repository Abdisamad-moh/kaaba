{% extends 'admin_base2.html.twig' %}
{% import 'macros/_form_macros.html.twig' as macros %}

{% block title %}
	Scholarship Applications
{% endblock %}

{% block body %}
	<div class="" data-controller="employer">
		<div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
			<div class="card-body px-4 py-3">
				<div class="row align-items-center">
					<div class="col-9">
						<h4 class="fw-semibold mb-8">
							<i class="ti ti-users fs-8"></i>
							Scholarship Applications
						</h4>
						<span class="badge bg-primary">Total:
							{{ total_count }}</span>
					</div>
					<div
						class="col-3">
						<!-- User role indicator -->
						{% if is_granted('ROLE_SUPER_ADMIN') %}
							<span class="badge bg-success">Admin View</span>
						{% elseif is_granted('ROLE_USER') %}
							<span class="badge bg-info">User View</span>
						{% endif %}
					</div>
				</div>
			</div>
		</div>

		<div class="row">
			<div class="col-12">
				<div class="datatables">
					<div class="card">
						<div class="card-body">
							{{ macros.render_search_form(searchForm, 'Filter Applications') }}

<div class="mb-3 text-end">
								<a href="{{ path('app_admin_kaaba_applications_export', app.request.query.all) }}" class="btn btn-success">
									<i class="ti ti-download"></i>
									Export Excel
								</a>
							</div>
							<div class="table-responsive">
								<table id="file_exports" class="table w-100 table-striped table-bordered display text-nowrap" width="100%" data-controller="general">
									<thead>
										<tr>
											<th>#</th>
											<th>Applicant Details</th>
											<th>Scholarship</th>
											
											<th>Institute & Course</th>

											{# 🔄 SWITCHED COLUMN ORDER #}
											<th>Status</th>
											<th>Assessment</th>
											<th>Exam Result</th>

											<th>Actions</th>
										</tr>
									</thead>

									<tbody>
										{% for application in applications %}
											{% set assessment = application.assessment %}

											<tr
												id="application-{{ application.id }}">

												<!-- ID -->
												<td class="text-muted">
													<a href="{{ path('app_admin_kaaba_application_view', {'uuid': application.uuid}) }}" class="btn btn-secondary btn-sm" title="View Application Details">
														{{ '%05d'|format(application.id) }}
													</a>
												</td>

												<!-- Applicant Details -->
												<td>
													<div class="d-flex justify-content-between align-items-start">
														<a href="{{ path('app_admin_kaaba_application_view', {'uuid': application.uuid}) }}">
															<strong>{{ application.fullname }}</strong>
														</a>

														{% if application.gender %}
															<span class="badge bg-dark ms-2">{{ application.gender.name }}</span>
														{% endif %}
													</div>

													{% if application.dateofbirth %}
														<div class="text-muted small">DOB:
															{{ application.dateofbirth|date('d-m-Y') }}</div>
													{% endif %}

													<div class="text-primary small mt-1">
														<i class="ti ti-phone"></i>
														{{ application.phone }}
													</div>
												</td>

												<!-- Scholarship -->
												<td>
													{% if application.scholarship %}
														<div class="fw-bold text-purple">
															{{ application.scholarship.title|length > 30 ? application.scholarship.title|slice(0, 30) ~ '...' : application.scholarship.title }}
														</div>
														{% if not application.scholarship.status %}
															<small class="text-danger">(Inactive)</small>
														{% endif %}
													{% else %}
														<span class="text-muted">N/A</span>
													{% endif %}
													<div>From:</div>
													{% if application.region %}
														<div class="fw-medium">{{ application.region.name }}</div>
													{% else %}
														<span class="text-muted">N/A</span>
													{% endif %}

													{% if application.district %}
														<div class="text-muted small">{{ application.district.name }}</div>
													{% endif %}
												</td>

												<!-- Region & District -->
												


												<!-- Institute & Course -->
												<td>
													{% if application.institute %}
														<div class="fw-medium text-primary">{{ application.institute.name }}</div>
													{% else %}
														<span class="text-muted">N/A</span>
													{% endif %}

													{% if application.course %}
														<div class="text-info small mt-1">
															<strong>Course:</strong>
															{{ application.course.name }}
														</div>
													{% endif %}
												</td>

												<!-- 🔄 Status (Moved up) -->
												<td id="status-{{ application.id }}">
													{% if application.status %}
														<span class="badge
																																																                            {% if application.status.name in ['applied','Applied'] %}bg-primary
																																																                            {% elseif application.status.name in ['rejected','Rejected'] %}bg-danger
																																																                            {% elseif application.status.name in ['shortlisted','Shortlisted'] %}bg-info text-white
																																																                            {% elseif application.status.name in ['accepted','Accepted','approved','Approved'] %}bg-success
																																																                            {% elseif application.status.name in ['waitlisted','Waitlisted'] %}bg-warning text-dark
																																																                            {% else %}bg-secondary{% endif %}
																																																                        ">
															{{ application.status.name == 'accepted' ? 'Approved' : application.status.name }}
														</span>
													{% else %}
														<span class="badge bg-primary">applied</span>
													{% endif %}
												</td>

												<!-- ⭐ NEW: Assessment Column -->
												<td>
													{% set result = application.interviewResult %}

													{% if result.score is null %}
														<span class="badge bg-danger">No Assessment</span>

													{% else %}
														<div>
															<span class="badge {{ result.class }}">
																{{ result.score }}/100
															</span>
														</div>

														<div class="mt-1">
															<span class="badge {{ result.class }}">
																{{ result.label }}
															</span>
														</div>
													{% endif %}
												</td>
												<td>
													{% if application.exam %}
														<span class="badge
																            {% if application.exam.examResult == 'passed' %}
																                bg-success
																            {% elseif application.exam.examResult == 'failed' %}
																                bg-danger
																            {% else %}
																                bg-secondary
																            {% endif %}
																        ">
															{{ application.exam.examResult ? application.exam.examResult|capitalize : 'Unknown' }}
														</span>
													{% else %}
														<span class="badge bg-warning text-dark">No Exam</span>
													{% endif %}
												</td>


												<!-- ACTION BUTTONS (ALL RESTORED EXACTLY AS BEFORE) -->
												<td>
													{% if is_granted('ROLE_USER') and not is_granted('ROLE_SUPER_ADMIN') and not app.user.status %}
														<span class="text-muted small">User Disabled</span>
													{% else %}
														<div class="btn-toolbar" role="toolbar">
															<div
																class="btn-group me-2 mb-2">

																<!-- View -->
																<a href="{{ path('app_admin_kaaba_application_view', {'uuid': application.uuid}) }}" class="btn btn-secondary btn-sm">
																	<i class="ti ti-eye fs-4"></i>
																	View
																</a>

																{% set statusName = application.status ? application.status.name|lower : '' %}
																{% set statusId = application.status ? application.status.id : 1 %}

																{# All your existing Update Status logic preserved #}

																{% if is_granted('ROLE_USER') and not is_granted('ROLE_SUPER_ADMIN') %}
																	{% if statusId == 1 %}
																		<div class="btn-group dropend">
																			<button class="btn btn-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown">
																				<i class="ti ti-edit fs-4"></i>
																				Update Status
																			</button>
																			<ul class="dropdown-menu">
																				<li class="bg-info">
																					<a class="dropdown-item update-status bg-info text-white" href="#" data-application-id="{{ application.id }}" data-status-action="shortlisted">
																						<i class="ti ti-check me-2"></i>
																						Shortlist
																					</a>
																				</li>

																				<li class="bg-warning">
																					<a class="dropdown-item update-status bg-warning text-dark" href="#" data-application-id="{{ application.id }}" data-status-action="waitlisted">
																						<i class="ti ti-clock me-2"></i>
																						Waitlist
																					</a>
																				</li>

																				<li><hr class="dropdown-divider"></li>

																				<li class="bg-danger">
																					<a class="dropdown-item reject-with-reason bg-danger text-white" href="#" data-application-id="{{ application.id }}">
																						<i class="ti ti-x me-2"></i>
																						Reject
																					</a>
																				</li>
																			</ul>
																		</div>
																	{% endif %}
																{% elseif is_granted('ROLE_SUPER_ADMIN') %}
																	{% if statusName not in ['rejected','accepted','approved'] %}
																		<div class="btn-group dropend">
																			<button class="btn btn-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown">
																				<i class="ti ti-edit fs-4"></i>
																				Update Status
																			</button>
																			<ul class="dropdown-menu">
																				{% if statusName in ['shortlisted','waitlisted'] %}
																					<li class="bg-success">
																						<a class="dropdown-item update-status bg-success text-white" href="#" data-application-id="{{ application.id }}" data-status-action="approved">
																							<i class="ti ti-check me-2"></i>
																							Approve
																						</a>
																					</li>
																					<li><hr class="dropdown-divider"></li>
																				{% endif %}

																				<li class="bg-danger">
																					<a class="dropdown-item reject-with-reason bg-danger text-white" href="#" data-application-id="{{ application.id }}">
																						<i class="ti ti-x me-2"></i>
																						Reject
																					</a>
																				</li>
																			</ul>
																		</div>
																	{% endif %}
																{% endif %}

																{# Revert Actions preserved #}
																{% if is_granted('ROLE_SUPER_ADMIN') and statusName in ['accepted','approved'] %}
																	<button class="btn btn-dark btn-sm revert-status" data-application-id="{{ application.id }}">
																		<i class="ti ti-arrow-back-up fs-4"></i>
																		Revert
																	</button>
																{% endif %}

																{% if statusName in ['shortlisted','waitlisted'] %}
																	<button class="btn btn-dark btn-sm revert-status" data-application-id="{{ application.id }}">
																		<i class="ti ti-arrow-back-up fs-4"></i>
																		Revert
																	</button>
																{% endif %}

																{% if statusName == 'rejected' %}
																	<button class="btn btn-dark btn-sm revert-rejected" data-application-id="{{ application.id }}">
																		<i class="ti ti-arrow-back-up fs-4"></i>
																		Revert
																	</button>
																{% endif %}

																<!-- View Logs -->
																<button class="btn text-white btn-sm" style="background: gray;" data-action="click->general#operations" data-type="get logs" data-item="{{ application.uuid }}" data-url="{{ path('app_admin_kaaba_application_logs', {'uuid': application.uuid}) }}" data-utility-modal-param="fullModal">
																	<i class="ti ti-history me-2"></i>
																	Logs
																</button>

																<!-- Interview Form -->
																<a href="{{ path('app_assessment', { uuid: application.uuid }) }}" class="btn btn-warning btn-sm text-dark">
																	<i class="ti ti-clipboard-text fs-4"></i>
																	Interview Form
																</a>
																<!-- Exam Form -->
																<a href="{{ path('app_application_exam', { uuid: application.uuid }) }}" class="btn btn-warning btn-sm text-dark">
																	<i class="ti ti-clipboard-text fs-4"></i>
																	Exam Form
																</a>

															</div>
														</div>
													{% endif %}
												</td>

											</tr>
										{% endfor %}
									</tbody>
								</table>
							</div>


							<!-- Pagination -->
							<div class="navigation mt-4">
								{% do applications.setPageRange(2) %}
								{{ knp_pagination_render(applications, 'pagination.html.twig', {
        'limit': current_limit
    }) }}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Modal and styles remain the same -->
	<div class="modal fade" id="fullModal" tabindex="-1" aria-labelledby="fullModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-lg modal-dialog-scrollable">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="fullModalLabel">Loading...</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body" id="fullModalBody">
					<div class="text-center py-5">
						<div class="spinner-border" role="status"></div>
					</div>
				</div>
				<div class="modal-footer" id="fullModalFooter">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
				</div>
			</div>
		</div>
	</div>

	<style>
		.bg-danger {
			background-color: red !important;
		}
		.fs-20 {
			font-size: 20px;
		}
		.bg-purple {
			background-color: #6f42c1 !important;
		}
		.text-purple {
			color: #6f42c1 !important;
		}

		.btn-loading {
			position: relative;
			color: transparent !important;
		}

		.btn-loading::after {
			content: '';
			position: absolute;
			width: 16px;
			height: 16px;
			top: 50%;
			left: 50%;
			margin-left: -8px;
			margin-top: -8px;
			border: 2px solid #ffffff;
			border-radius: 50%;
			border-right-color: transparent;
			animation: spin 1s linear infinite;
		}

		@keyframes spin {
			to {
				transform: rotate(360deg);
			}
		}

		.table-responsive .dropdown-menu {
			position: absolute;
			z-index: 1060;
		}

		.table td {
			vertical-align: top;
			padding: 12px 8px;
		}

		/* SweetAlert custom styles */
		.swal2-popup .form-control {
			border: 1px solid #ddd;
			border-radius: 4px;
			padding: 8px 12px;
			font-size: 14px;
		}

		.swal2-popup .form-label {
			font-weight: 600;
			margin-bottom: 8px;
			display: block;
		}
	</style>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
 <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	 <script>
						    document.addEventListener('DOMContentLoaded', function() {
					
					            const instituteSelect = document.querySelector('select[name$="[institute]"]');
					
					    if (instituteSelect) {
					        instituteSelect.addEventListener('change', function() {
					            // submit closest form
					            const form = this.closest('form');
					            if (form) {
					                form.submit();
					            }
					        });
					    }

 // Helper function to get applicant name from table row
            function getApplicantName(button) {
                const row = button.closest('tr');
                if (row) {
                    // Look for the applicant name in the second column (Applicant Details)
                    const applicantCell = row.querySelector('td:nth-child(2)');
                    if (applicantCell) {
                        const strongTag = applicantCell.querySelector('strong');
                        if (strongTag) {
                            return strongTag.textContent.trim();
                        }
                        // Fallback: get text from first anchor tag
                        const anchor = applicantCell.querySelector('a');
                        if (anchor) {
                            return anchor.textContent.trim();
                        }
                    }
                }
                return 'the applicant';
            }
						
						        // Update Status functionality with shortlist reason
						        document.querySelectorAll('.update-status').forEach(button => {
						            button.addEventListener('click', function(e) {
						                e.preventDefault();
						                
						                const applicationId = this.getAttribute('data-application-id');
						                const statusAction = this.getAttribute('data-status-action');
						                  const applicantName = getApplicantName(this);
                    
						                
						                // Set confirmation message based on status
						                                   let actionText = '';
                    let title = '';
                    let icon = 'question';
                    let showReasonInput = false;
                    let reasonFieldName = '';
                    let reasonPlaceholder = '';

						                switch(statusAction) {
						                  case 'shortlisted':
                            actionText = 'shortlist';
                            title = 'Shortlist Application';
                            icon = 'info';
                            showReasonInput = true;
                            reasonFieldName = 'shortlistReason';
                            reasonPlaceholder = 'Enter reason for shortlisting...';
						                        break;
						                    case 'waitlisted':
						                        actionText = 'waitlist';
						                        title = 'Waitlist Application';
						                        icon = 'warning';
						                        break;
						                    case 'approved':
                            actionText = 'approve';
                            title = 'Approve Application';
                            icon = 'success';
                            showReasonInput = true;
                            reasonFieldName = 'approveReason';
                            reasonPlaceholder = 'Enter reason for approval...';
                            break;
						                    default:
						                        actionText = statusAction;
						                        title = `Update Application Status to ${statusAction.charAt(0).toUpperCase() + statusAction.slice(1)}`;
						                }
						                
						                let htmlContent = `<p>Are you sure you want to ${actionText} the application for <strong>${applicantName}</strong>?</p>`;
						                
						                // Add reason textarea for shortlisting or approval
                    if (showReasonInput) {
                        htmlContent += `
                            <div class="mt-3">
                                <label for="${reasonFieldName}" class="form-label">
                                    ${statusAction.charAt(0).toUpperCase() + statusAction.slice(1)} Reason (Optional):
                                </label>
                                <textarea id="${reasonFieldName}" class="form-control" rows="3" 
                                    placeholder="${reasonPlaceholder}"></textarea>
                            </div>
                        `;
                    }
						                
						               // Show SweetAlert confirmation
                    Swal.fire({
                        title: title,
                        html: htmlContent,
                        icon: icon,
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: `Yes, ${actionText} application!`,
                        cancelButtonText: 'Cancel',
                        showLoaderOnConfirm: true,
                        preConfirm: () => {
                            // Get reason if applicable
                            let reason = null;
                            if (showReasonInput) {
                                reason = document.getElementById(reasonFieldName).value;
                            }
                            
                            return fetch('{{ path("app_admin_kaaba_application_update_status") }}', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-Requested-With': 'XMLHttpRequest'
                                },
                                body: JSON.stringify({
                                    applicationId: applicationId,
                                    statusAction: statusAction,
                                    shortlistReason: statusAction === 'shortlisted' ? reason : null,
                                    approveReason: statusAction === 'approved' ? reason : null,
                                    _token: '{{ csrf_token("update_application_status") }}',
                                }),
                            })
                            .then(response => {
                                const contentType = response.headers.get('content-type');
                                if (contentType && contentType.includes('text/html')) {
                                    return response.text().then(html => {
                                        throw new Error('Server returned HTML instead of JSON. This might be an authentication or server error.');
                                    });
                                }
                                
                                if (!response.ok) {
                                    throw new Error(`HTTP error! status: ${response.status}`);
                                }
                                return response.json();
                            })
                            .then(data => {
                                if (data.success) {
                                    // Update status badge
                                    const statusBadge = document.getElementById(`status-${applicationId}`);
                                    if (statusBadge) {
                                        statusBadge.innerHTML = data.newStatusBadge;
                                    }
                                    
                                    return data;
                                } else {
                                    throw new Error(data.message || 'Failed to update status');
                                }
                            })
                            .catch(error => {
                                console.error('Update status error:', error);
                                Swal.showValidationMessage(`Request failed: ${error.message}`);
                            });
                        },
                        allowOutsideClick: () => !Swal.isLoading()
                    }).then((result) => {
                        if (result.isConfirmed && result.value) {
                            Swal.fire({
                                title: 'Success!',
                                text: result.value.message,
                                icon: 'success',
                                confirmButtonText: 'OK'
                            }).then(() => {
                                window.location.reload();
                            });
                        }
                    });
                });
            });
						
						        // Reject with reason functionality
            document.querySelectorAll('.reject-with-reason').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    const applicationId = this.getAttribute('data-application-id');
                    const applicantName = getApplicantName(this);
                    
                    // Show SweetAlert with textarea for rejection reason
                    Swal.fire({
                        title: 'Reject Application',
                        html: `
                            <p>Are you sure you want to reject the application for <strong>${applicantName}</strong>?</p>
                            <div class="mt-3">
                                <label for="rejectionReason" class="form-label">Rejection Reason (Optional):</label>
                                <textarea id="rejectionReason" class="form-control" rows="3" 
                                    placeholder="Enter reason for rejection..."></textarea>
                            </div>
                        `,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Yes, reject application!',
                        cancelButtonText: 'Cancel',
                        showLoaderOnConfirm: true,
                        preConfirm: () => {
                            const rejectionReason = document.getElementById('rejectionReason').value;
                            
                            const formData = new URLSearchParams();
                            formData.append('rejectionreason', rejectionReason);
                            formData.append('_token', '{{ csrf_token("reject_application_with_reason") }}');
                            
                            return fetch(`/admin/kaaba-applications/reject-with-reason/${applicationId}`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded',
                                    'X-Requested-With': 'XMLHttpRequest'
                                },
                                body: formData
                            })
                            .then(response => {
                                const contentType = response.headers.get('content-type');
                                if (contentType && contentType.includes('text/html')) {
                                    return response.text().then(html => {
                                        throw new Error('Server returned HTML instead of JSON. This might be an authentication or server error.');
                                    });
                                }
                                
                                if (!response.ok) {
                                    return response.text().then(errorText => {
                                        try {
                                            const errorData = JSON.parse(errorText);
                                            throw new Error(errorData.message || `HTTP error! status: ${response.status}`);
                                        } catch (e) {
                                            throw new Error(`HTTP error! status: ${response.status}`);
                                        }
                                    });
                                }
                                return response.json();
                            })
                            .then(data => {
                                if (data.success) {
                                    const statusBadge = document.getElementById(`status-${applicationId}`);
                                    if (statusBadge) {
                                        statusBadge.innerHTML = data.newStatusBadge;
                                    }
                                    
                                    return data;
                                } else {
                                    throw new Error(data.message || 'Failed to reject application');
                                }
                            })
                            .catch(error => {
                                console.error('Reject application error:', error);
                                Swal.showValidationMessage(`Request failed: ${error.message}`);
                            });
                        },
                        allowOutsideClick: () => !Swal.isLoading()
                    }).then((result) => {
                        if (result.isConfirmed && result.value) {
                            Swal.fire({
                                title: 'Success!',
                                text: result.value.message,
                                icon: 'success',
                                confirmButtonText: 'OK'
                            }).then(() => {
                                window.location.reload();
                            });
                        }
                    });
                });
