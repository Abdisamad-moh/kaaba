{% extends 'admin_base2.html.twig' %}

{% block title %}School Days Configuration{% endblock %}

{% block body %}
    <!-- Page Header -->
    <div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
        <div class="card-body px-4 py-3">
            <div class="row align-items-center">
                <div class="col-9">
                    <h4 class="fw-semibold mb-8">School Days Configuration</h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a class="text-muted text-decoration-none" href="#">Admin</a>
                            </li>
                            <li class="breadcrumb-item" aria-current="page">Configuration</li>
                            <li class="breadcrumb-item active" aria-current="page">School Days</li>
                        </ol>
                    </nav>
                </div>
                <div class="col-3">
                    {% if not allDaysExist %}
                        <a href="{{ path('app_admin_kaaba_school_days', { create: 1 }) }}" class="btn btn-primary float-end">
                            <i class="ti ti-plus me-2"></i>
                            Add New Day
                        </a>
                    {% else %}
                        <button class="btn btn-secondary float-end" disabled title="All 7 days are already configured">
                            <i class="ti ti-check me-2"></i>
                            All Days Configured
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Form for Creating/Editing -->
    {% if showForm %}
    <div class="card">
        <div class="card-header text-bg-primary">
            <h5 class="mb-0 text-white">
                <i class="ti ti-{{ editId ? 'edit' : 'plus' }} me-2"></i>
                {{ editId ? 'Edit School Day' : 'Add School Day Configuration' }}
            </h5>
        </div>
        <div class="form-horizontal">
            <div class="form-body">
                <div class="card-body">
                    <h5 class="card-title mb-0">School Day Information</h5>
                </div>
                <hr class="m-0">
                <div class="card-body">
                    {{ form_start(form) }}
                    
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3 col-form-label">
                                    {{ form_label(form.dayOfWeek) }}
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="col-md-9">
                                    {{ form_widget(form.dayOfWeek, { 
                                        'attr': { 
                                            'class': 'form-select',
                                        } 
                                    }) }}
                                    {{ form_errors(form.dayOfWeek) }}
                                    {% if not editId %}
                                        <small class="form-text text-muted">
                                            Only unconfigured days are available. {{ availableDaysCount }} day(s) remaining.
                                        </small>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <div class="col-md-3"></div>
                                <div class="col-md-9">
                                    <div class="form-check form-switch mb-2">
                                        {{ form_widget(form.isSchoolDay, { 
                                            'attr': { 
                                                'class': 'form-check-input',
                                                'role': 'switch'
                                            } 
                                        }) }}
                                        <label class="form-check-label" for="{{ form.isSchoolDay.vars.id }}">
                                            {{ form_label(form.isSchoolDay) }}
                                        </label>
                                    </div>
                                    <div class="form-check form-switch">
                                        {{ form_widget(form.isHalfDay, { 
                                            'attr': { 
                                                'class': 'form-check-input',
                                                'role': 'switch'
                                            } 
                                        }) }}
                                        <label class="form-check-label" for="{{ form.isHalfDay.vars.id }}">
                                            {{ form_label(form.isHalfDay) }}
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3 col-form-label">
                                    {{ form_label(form.dayType) }}
                                </label>
                                <div class="col-md-9">
                                    {{ form_widget(form.dayType, { 
                                        'attr': { 
                                            'class': 'form-select',
                                        } 
                                    }) }}
                                    {{ form_errors(form.dayType) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    {% if editId %}
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3 col-form-label">
                                    {{ form_label(form.orderIndex) }}
                                </label>
                                <div class="col-md-9">
                                    {{ form_widget(form.orderIndex, { 
                                        'attr': { 
                                            'class': 'form-control',
                                            'placeholder': 'Optional order index'
                                        } 
                                    }) }}
                                    {{ form_errors(form.orderIndex) }}
                                    <small class="form-text text-muted">
                                        Used for custom sorting (1=Monday, 2=Tuesday, etc.)
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% else %}
                    <div class="alert alert-info">
                        <i class="ti ti-info-circle me-2"></i>
                        Order index will be automatically set based on the day of the week.
                    </div>
                    {% endif %}

                    <hr class="m-0">
                    <div class="form-actions border-top">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="row">
                                        <div class="col-md-offset-3 col-md-9">
                                            <button type="submit" class="btn btn-primary">
                                                <i class="ti ti-{{ editId ? 'check' : 'plus' }} fs-5 me-2"></i>
                                                {{ editId ? 'Update Day' : 'Create Day' }}
                                            </button>
                                            <a href="{{ path('app_admin_kaaba_school_days') }}" class="btn bg-danger-subtle text-danger ms-6">
                                                <i class="ti ti-x me-2"></i>
                                                Cancel
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6"></div>
                            </div>
                        </div>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Table of Existing Configurations -->
    <div class="card mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="card-title mb-0">School Week Configuration ({{ schoolDays|length }}/7 days)</h5>
                <div>
                    <span class="badge bg-success me-2">School Days: {{ schoolDays|filter(d => d.isSchoolDay)|length }}</span>
                    <span class="badge bg-warning me-2">Half Days: {{ schoolDays|filter(d => d.isHalfDay)|length }}</span>
                    <span class="badge bg-secondary">Off Days: {{ schoolDays|filter(d => not d.isSchoolDay)|length }}</span>
                </div>
            </div>
            
            {% if schoolDays|length > 0 %}
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th width="50">#</th>
                            <th width="120">Day of Week</th>
                            <th width="120">Status</th>
                            <th width="120">Half Day</th>
                            <th width="120">Day Type</th>
                            <th width="100">Order</th>
                            <th width="300" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for day in schoolDays %}
                            <tr>
                                <td class="text-muted">{{ loop.index }}</td>
                                <td>
                                    <strong>{{ day.dayOfWeek }}</strong>
                                </td>
                                <td>
                                    <span class="badge {% if day.isSchoolDay %}bg-success{% else %}bg-secondary{% endif %}">
                                        <i class="ti ti-{{ day.isSchoolDay ? 'check' : 'x' }} me-1"></i>
                                        {{ day.isSchoolDay ? 'School Day' : 'Off Day' }}
                                    </span>
                                </td>
                                <td>
                                    {% if day.isSchoolDay %}
                                        <span class="badge {% if day.isHalfDay %}bg-warning{% else %}bg-info{% endif %}">
                                            <i class="ti ti-{{ day.isHalfDay ? 'clock' : 'calendar' }} me-1"></i>
                                            {{ day.isHalfDay ? 'Half Day' : 'Full Day' }}
                                        </span>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if day.dayType %}
                                        <span class="badge bg-primary">{{ day.dayType|title }}</span>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if day.orderIndex %}
                                        <span class="badge bg-dark">{{ day.orderIndex }}</span>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="{{ path('app_admin_kaaba_school_days', { edit: day.id }) }}" 
                                           class="btn btn-warning" 
                                           title="Edit day">
                                            <i class="ti ti-edit me-1"></i> Edit
                                        </a>
                                        <a href="{{ path('app_admin_kaaba_school_days', { toggleSchoolDay: day.id }) }}" 
                                           class="btn {% if day.isSchoolDay %}btn-secondary{% else %}btn-success{% endif %}" 
                                           onclick="return confirm('Are you sure you want to toggle school day status for {{ day.dayOfWeek }}?')"
                                           title="Toggle school day">
                                            <i class="ti ti-{{ day.isSchoolDay ? 'x' : 'check' }} me-1"></i> 
                                            {{ day.isSchoolDay ? 'Make Off' : 'Make School' }}
                                        </a>
                                        {% if day.isSchoolDay %}
                                        <a href="{{ path('app_admin_kaaba_school_days', { toggleHalfDay: day.id }) }}" 
                                           class="btn {% if day.isHalfDay %}btn-info{% else %}btn-warning{% endif %}" 
                                           onclick="return confirm('Are you sure you want to toggle half day status for {{ day.dayOfWeek }}?')"
                                           title="Toggle half day">
                                            <i class="ti ti-{{ day.isHalfDay ? 'calendar' : 'clock' }} me-1"></i> 
                                            {{ day.isHalfDay ? 'Full Day' : 'Half Day' }}
                                        </a>
                                        {% endif %}
                                        <a href="{{ path('app_admin_kaaba_school_days', { delete: day.id }) }}" 
                                           class="btn btn-danger" 
                                           onclick="return confirm('Are you sure you want to delete configuration for {{ day.dayOfWeek }}?')"
                                           title="Delete configuration">
                                            <i class="ti ti-trash me-1"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            
            {% if schoolDays|length < 7 %}
                <div class="alert alert-warning mt-3">
                    <i class="ti ti-alert-circle me-2"></i>
                    <strong>{{ 7 - schoolDays|length }} day(s) remaining</strong> to configure all 7 days of the week.
                </div>
            {% else %}
                <div class="alert alert-success mt-3">
                    <i class="ti ti-check me-2"></i>
                    <strong>All 7 days of the week are configured!</strong> You can edit existing days but cannot add new ones.
                </div>
            {% endif %}
            
            {% else %}
            <div class="alert alert-info text-center py-4">
                <div class="mb-3">
                    <i class="ti ti-calendar text-primary" style="font-size: 3rem;"></i>
                </div>
                <h5 class="alert-heading">No School Days Configured</h5>
                <p class="mb-3">Configure the days of the week (7 days maximum).</p>
                <a href="{{ path('app_admin_kaaba_school_days', { create: 1 }) }}" class="btn btn-primary">
                    <i class="ti ti-plus me-2"></i>Configure School Days
                </a>
            </div>
            {% endif %}
        </div>
    </div>
{% endblock %}