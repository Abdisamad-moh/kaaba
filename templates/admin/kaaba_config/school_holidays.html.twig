{% extends 'admin_base2.html.twig' %}

{% block title %}School Holidays Configuration{% endblock %}

{% block body %}
    <!-- Page Header -->
    <div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
        <div class="card-body px-4 py-3">
            <div class="row align-items-center">
                <div class="col-9">
                    <h4 class="fw-semibold mb-8">School Holidays Configuration</h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a class="text-muted text-decoration-none" href="#">Admin</a>
                            </li>
                            <li class="breadcrumb-item" aria-current="page">Configuration</li>
                            <li class="breadcrumb-item active" aria-current="page">Holidays</li>
                        </ol>
                    </nav>
                </div>
                <div class="col-3">
                    <a href="{{ path('app_admin_kaaba_school_holidays', { create: 1 }) }}" class="btn btn-primary float-end">
                        <i class="ti ti-plus me-2"></i>
                        Add New Holiday
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Form for Creating/Editing -->
    {% if showForm %}
    <div class="card">
        <div class="card-header text-bg-primary">
            <h5 class="mb-0 text-white">
                <i class="ti ti-{{ editId ? 'edit' : 'plus' }} me-2"></i>
                {{ editId ? 'Edit Holiday' : 'Add New Holiday' }}
            </h5>
        </div>
        <div class="form-horizontal">
            <div class="form-body">
                <div class="card-body">
                    <h5 class="card-title mb-0">Holiday Information</h5>
                </div>
                <hr class="m-0">
                <div class="card-body">
                    {{ form_start(form) }}
                    
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3 col-form-label">
                                    {{ form_label(form.name) }}
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="col-md-9">
                                    {{ form_widget(form.name, { 
                                        'attr': { 
                                            'class': 'form-control',
                                            'placeholder': 'e.g., Summer Vacation, Eid Holiday, etc.'
                                        } 
                                    }) }}
                                    {{ form_errors(form.name) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3 col-form-label">
                                    {{ form_label(form.description) }}
                                </label>
                                <div class="col-md-9">
                                    {{ form_widget(form.description, { 
                                        'attr': { 
                                            'class': 'form-control',
                                            'placeholder': 'Optional description or notes',
                                            'rows': 3
                                        } 
                                    }) }}
                                    {{ form_errors(form.description) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3 col-form-label">
                                    {{ form_label(form.holidayType) }}
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="col-md-9">
                                    {{ form_widget(form.holidayType, { 
                                        'attr': { 
                                            'class': 'form-select',
                                        } 
                                    }) }}
                                    {{ form_errors(form.holidayType) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3 col-form-label">
                                    {{ form_label(form.date) }}
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="col-md-9">
                                    {{ form_widget(form.date, { 
                                        'attr': { 
                                            'class': 'form-control'
                                        } 
                                    }) }}
                                    {{ form_errors(form.date) }}
                                    <small class="form-text text-muted">
                                        Start date of the holiday
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3 col-form-label">
                                    {{ form_label(form.endDate) }}
                                </label>
                                <div class="col-md-9">
                                    {{ form_widget(form.endDate, { 
                                        'attr': { 
                                            'class': 'form-control'
                                        } 
                                    }) }}
                                    {{ form_errors(form.endDate) }}
                                    <small class="form-text text-muted">
                                        End date for multi-day holidays (leave empty for single day)
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="form-group row">
                                <div class="col-md-3"></div>
                                <div class="col-md-9">
                                    <div class="form-check form-switch">
                                        {{ form_widget(form.isRecurring, { 
                                            'attr': { 
                                                'class': 'form-check-input',
                                                'role': 'switch'
                                            } 
                                        }) }}
                                        <label class="form-check-label" for="{{ form.isRecurring.vars.id }}">
                                            {{ form_label(form.isRecurring) }}
                                        </label>
                                        <small class="form-text text-muted d-block">
                                            If checked, this holiday will repeat every year automatically
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="m-0">
                    <div class="form-actions border-top">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="row">
                                        <div class="col-md-offset-3 col-md-9">
                                            <button type="submit" class="btn btn-primary">
                                                <i class="ti ti-{{ editId ? 'check' : 'plus' }} fs-5 me-2"></i>
                                                {{ editId ? 'Update Holiday' : 'Create Holiday' }}
                                            </button>
                                            <a href="{{ path('app_admin_kaaba_school_holidays') }}" class="btn bg-danger-subtle text-danger ms-6">
                                                <i class="ti ti-x me-2"></i>
                                                Cancel
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6"></div>
                            </div>
                        </div>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Table of Existing Holidays -->
    <div class="card mt-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="card-title mb-0">School Holidays</h5>
                <div>
                    {% set currentDate = date() %}
                    {% set upcomingHolidays = holidays|filter(h => h.date >= currentDate) %}
                    <span class="badge bg-primary me-2">Total: {{ holidays|length }}</span>
                    <span class="badge bg-success">Upcoming: {{ upcomingHolidays|length }}</span>
                </div>
            </div>
            
            {% if holidays|length > 0 %}
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th width="50">#</th>
                            <th>Holiday Name</th>
                            <th width="120">Type</th>
                            <th width="120">Date</th>
                            <th width="120">Duration</th>
                            <th width="100">Recurring</th>
                            <th width="300" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for holiday in holidays %}
                            {% set isPast = holiday.date < date() %}
                            <tr class="{% if isPast %}table-secondary{% endif %}">
                                <td class="text-muted">{{ loop.index }}</td>
                                <td>
                                    <strong>{{ holiday.name }}</strong>
                                    {% if holiday.description %}
                                        <br><small class="text-muted">{{ holiday.description|slice(0, 50) }}{% if holiday.description|length > 50 %}...{% endif %}</small>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge 
                                        {% if holiday.holidayType == 'public' %}bg-danger
                                        {% elseif holiday.holidayType == 'religious' %}bg-purple
                                        {% elseif holiday.holidayType == 'academic' %}bg-success
                                        {% elseif holiday.holidayType == 'national' %}bg-warning
                                        {% else %}bg-info{% endif %}">
                                        {{ holiday.holidayType|title }}
                                    </span>
                                </td>
                                <td>
                                    <span class="{% if isPast %}text-muted{% endif %}">
                                        {{ holiday.date|date('Y-m-d') }}
                                    </span>
                                    {% if isPast %}
                                        <br><small class="text-danger">Past</small>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if holiday.endDate %}
                                        {% set daysDiff = date(holiday.endDate).diff(date(holiday.date)).days + 1 %}
                                        <span class="badge bg-primary">{{ daysDiff }} day{% if daysDiff > 1 %}s{% endif %}</span>
                                        <br><small class="text-muted">to {{ holiday.endDate|date('m/d') }}</small>
                                    {% else %}
                                        <span class="badge bg-secondary">1 day</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge {% if holiday.isRecurring %}bg-success{% else %}bg-secondary{% endif %}">
                                        <i class="ti ti-{{ holiday.isRecurring ? 'repeat' : 'x' }} me-1"></i>
                                        {{ holiday.isRecurring ? 'Yes' : 'No' }}
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="{{ path('app_admin_kaaba_school_holidays', { edit: holiday.id }) }}" 
                                           class="btn btn-warning" 
                                           title="Edit holiday">
                                            <i class="ti ti-edit me-1"></i> Edit
                                        </a>
                                        <a href="{{ path('app_admin_kaaba_school_holidays', { toggleRecurring: holiday.id }) }}" 
                                           class="btn {% if holiday.isRecurring %}btn-secondary{% else %}btn-success{% endif %}" 
                                           onclick="return confirm('Are you sure you want to toggle recurring status for \"{{ holiday.name }}\"?')"
                                           title="Toggle recurring">
                                            <i class="ti ti-{{ holiday.isRecurring ? 'x' : 'repeat' }} me-1"></i> 
                                            {{ holiday.isRecurring ? 'Non-recurring' : 'Recurring' }}
                                        </a>
                                        <a href="{{ path('app_admin_kaaba_school_holidays', { delete: holiday.id }) }}" 
                                           class="btn btn-danger" 
                                           onclick="return confirm('Are you sure you want to delete \"{{ holiday.name }}\"?')"
                                           title="Delete holiday">
                                            <i class="ti ti-trash me-1"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <div class="alert alert-info text-center py-4">
                <div class="mb-3">
                    <i class="ti ti-beach text-primary" style="font-size: 3rem;"></i>
                </div>
                <h5 class="alert-heading">No School Holidays Configured</h5>
                <p class="mb-3">Add holidays to define when the school will be closed.</p>
                <a href="{{ path('app_admin_kaaba_school_holidays', { create: 1 }) }}" class="btn btn-primary">
                    <i class="ti ti-plus me-2"></i>Add First Holiday
                </a>
            </div>
            {% endif %}
        </div>
    </div>
{% endblock %}