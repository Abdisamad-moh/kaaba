{% extends 'admin_base2.html.twig' %}

{% block title %}Test SMS Results{% endblock %}

{% block body %}
<div class="container mt-4">

    <div class="alert alert-success">
        <strong>{{ sentCount }}</strong> test SMS sent.
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Results</h5>
        </div>

        <div class="card-body p-0">
            <table class="table table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Gateway Response</th>
                    </tr>
                </thead>
                <tbody>
                    {% for r in results %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td>{{ r.name }}</td>
                            <td>{{ r.phone }}</td>
                            <td>
                                {% if r.status == 'success' %}
                                    <span class="badge bg-success">Sent</span>
                                {% else %}
                                    <span class="badge bg-danger">{{ r.status }}</span>
                                {% endif %}
                            </td>
                            <td><code>{{ r.response }}</code></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_admin_bulk_sms_test') }}" class="btn btn-primary">
            Back
        </a>
    </div>

</div>
{% endblock %}
