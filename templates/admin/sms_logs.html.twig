{% extends 'admin_base2.html.twig' %}

{% block title %}SMS Logs{% endblock %}

{% block body %}

<div class="container mt-4">
    <h4 class="mb-3">SMS Logs</h4>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Receiver</th>
                <th>Phone</th>
                <th>Message</th>
                <th>Status</th>
                <th>Gateway Response</th>
                <th>Sent At</th>
            </tr>
        </thead>
        <tbody>
            {% for log in logs %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td>{{ log.receiverName }}</td>
                    <td>{{ log.phoneNumber }}</td>
                    <td style="white-space: pre-wrap;">{{ log.message }}</td>
                    <td>{{ log.messageStatus }}</td>
                    <td>{{ log.gatewayResponse }}</td>
                    <td>{{ log.createdAt|date('Y-m-d H:i') }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

</div>

{% endblock %}
