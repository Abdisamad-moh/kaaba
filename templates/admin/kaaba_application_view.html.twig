                                {% elseif application.literacylevel == 'limited' %}{{ 'I have limited proficiency in reading and writing'|trans }}
                                {% elseif application.literacylevel == 'moderate' %}{{ 'I have moderate proficiency in reading and writing'|trans }}
                                {% elseif application.literacylevel == 'proficient' %}{{ 'I am proficient in reading and writing'|trans }}
