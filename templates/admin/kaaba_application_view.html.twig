                                <div class="col-md-9">
                                    <p>{{ application.district.name ?? 'N/A' }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                      
                        <div class="col-md-6">
                            <div class="form-group row">
                                <label class="form-label text-end col-md-3">Village:</label>
                                <div class="col-md-9">
