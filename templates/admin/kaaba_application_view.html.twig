{% extends 'admin_base2.html.twig' %}

{% block title %}Application Review - {{ application.full_name }}{% endblock %}
{% block head %}
    {{ parent() }}
    <meta name="csrf-token" content="{{ csrf_token('edit_rejection_reason') }}">
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .badgia {
            white-space: normal;
            display: inline-block;
            word-break: break-word;
            text-align: left;
        }
        .document-link {
            text-decoration: none;
            transition: all 0.3s ease;
        }
        .document-link:hover {
            transform: translateY(-2px);
        }
        .status-badge {
            font-size: 0.9rem;
            padding: 0.5rem 1rem;
        }

.edit-rejection-reason {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
}

#rejection-reason-section {
    position: relative;
}

#rejection-reason-section .btn {
    position: absolute;
    top: 10px;
    right: 10px;
}
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
        <div class="card-body px-4 py-3">
            <div class="row align-items-center">
                <div class="col-9">
                    <h4 class="fw-semibold mb-8">Application Review</h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a class="text-muted text-decoration-none" href="{{ path('app_admin_kaaba_applications') }}">Applications</a>
                            </li>
                            <li class="breadcrumb-item" aria-current="page">Application Review</li>
                        </ol>
                    </nav>
                </div>
                <div class="col-3">
                    <div class="text-center mb-n5">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header text-bg-primary d-flex justify-content-between align-items-center">
