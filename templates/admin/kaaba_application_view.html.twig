<!-- Status Information Section -->
<div class="card-body">
    <h5 class="card-title mb-0">Application Status</h5>
</div>
<hr class="m-0"/>
<div class="card-body">
    <div class="row">
        <div class="col-12">
            <div class="d-flex align-items-center mb-3">
                <strong class="me-3">Current Status:</strong>
                <span class="status-badge badge 
                    {% if application.status.name == 'accepted' or application.status.name == 'approved' %}bg-success
                    {% elseif application.status.name == 'rejected' %}bg-danger
                    {% elseif application.status.name == 'applied' %}bg-primary
                    {% elseif application.status.name == 'shortlisted' %}bg-info text-white
                    {% elseif application.status.name == 'waitlisted' %}bg-warning text-white
                    {% else %}bg-secondary{% endif %}">
                    {% if application.status.name == 'accepted' %}approved
                    {% else %}
                        {{ application.status.name }}
                    {% endif %}
