{% extends 'admin_base2.html.twig' %}

{% block title %}Application Review - {{ application.full_name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .badgia {
            white-space: normal;
            display: inline-block;
            word-break: break-word;
            text-align: left;
        }
        .document-link {
            text-decoration: none;
            transition: all 0.3s ease;
        }
        .document-link:hover {
            transform: translateY(-2px);
        }
        .status-badge {
            font-size: 0.9rem;
            padding: 0.5rem 1rem;
        }
    </style>
{% endblock %}

