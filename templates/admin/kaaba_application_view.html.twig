                                {% if application.numeracylevel == 'no_skills' %}bg-danger
                                {% elseif application.numeracylevel == 'limited' %}bg-warning text-dark
                                {% elseif application.numeracylevel == 'moderate' %}bg-info
                                {% elseif application.numeracylevel == 'proficient' %}bg-success
                                {% else %}bg-secondary{% endif %}">
                                {% if application.numeracylevel == 'no_skills' %}{{ 'I do not possess basic numeracy skills'|trans }}
                                {% elseif application.numeracylevel == 'limited' %}{{ 'I have limited proficiency in numeracy'|trans }}
                                {% elseif application.numeracylevel == 'moderate' %}{{ 'I have moderate proficiency in numeracy'|trans }}
                                {% elseif application.numeracylevel == 'proficient' %}{{ 'I am proficient in numeracy'|trans }}
                                {% else %}{{ application.numeracylevel }}{% endif %}
