</div>

<!-- Status Information Section -->
<div class="card-body">
    <h5 class="card-title mb-0">Application Status</h5>
</div>
<hr class="m-0"/>
<div class="card-body">
    <div class="row">
        <div class="col-12">
            <div class="d-flex align-items-center mb-3">
                <strong class="me-3">Current Status:</strong>
                <span class="status-badge badge 
                    {% if application.status.name == 'accepted' or application.status.name == 'approved' %}bg-success
                    {% elseif application.status.name == 'rejected' %}bg-danger
                    {% elseif application.status.name == 'applied' %}bg-primary
                    {% elseif application.status.name == 'shortlisted' %}bg-info text-white
                    {% elseif application.status.name == 'waitlisted' %}bg-warning text-white
                    {% else %}bg-secondary{% endif %}">
                    {% if application.status.name == 'accepted' %}approved
                    {% else %}
                        {{ application.status.name }}
                    {% endif %}
                </span>
            </div>

            {# Rejection Reason - only show for rejected status #}
            {% if application.status.name == 'rejected' %}
                <div class="alert alert-danger mt-3" id="rejection-reason-section">
                    <div class="d-flex align-items-start">
                        <i class="ti ti-alert-circle text-danger me-2 mt-1 fs-5"></i>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong>Rejection Reason:</strong>
                                <button type="button" 
                                        class="btn btn-outline-dark btn-sm edit-rejection-reason"
                                        data-application-id="{{ application.id }}"
                                        data-current-reason="{{ application.rejectionreason ?? '' }}"
                                        data-applicant-name="{{ application.fullname }}">
                                    <i class="ti ti-edit me-1"></i>
                                    Edit Reason
                                </button>
                            </div>
                            <p class="mb-0 mt-1" id="rejection-reason-text">
                                {{ application.rejectionreason ?? 'No reason provided' }}
                            </p>
                            {% if application.rejecteddate %}
                                <small class="text-muted">Rejected on: {{ application.rejecteddate|date('d-m-Y H:i') }}</small>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>


                </div>

              <!-- Action Buttons -->
<hr class="m-0" />
<div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <a href="{{ path('app_admin_kaaba_applications') }}" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1 fs-5"></i>
                Back to Applications
            </a>
        </div>
       
    </div>
</div>

            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Edit rejection reason functionality
    document.querySelectorAll('.edit-rejection-reason').forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            
            const applicationId = this.getAttribute('data-application-id');
            const currentReason = this.getAttribute('data-current-reason');
            const applicantName = this.getAttribute('data-applicant-name');
            
            // Show SweetAlert with textarea for editing rejection reason
            Swal.fire({
                title: 'Edit Rejection Reason',
                html: `
                    <p>Editing rejection reason for <strong>${applicantName}</strong>:</p>
                    <div class="mt-3">
                        <label for="editRejectionReason" class="form-label">Rejection Reason:</label>
                        <textarea id="editRejectionReason" class="form-control" rows="4" placeholder="Enter rejection reason...">${currentReason}</textarea>
                    </div>
                `,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Update Reason',
                cancelButtonText: 'Cancel',
                showLoaderOnConfirm: true,
                preConfirm: () => {
                    const newReason = document.getElementById('editRejectionReason').value;
                    
                    return fetch('{{ path("app_admin_kaaba_application_edit_rejection_reason") }}', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            applicationId: applicationId,
                            rejectionReason: newReason,
                            _token: '{{ csrf_token("edit_rejection_reason") }}'
                        })
                    })
               // Temporarily add this to see the actual response
.then(response => {
    console.log('Response status:', response.status);
    console.log('Response headers:', response.headers);
    return response.text().then(text => {
        console.log('Response text:', text.substring(0, 500));
        // Then try to parse as JSON if possible
        try {
            return JSON.parse(text);
        } catch (e) {
            throw new Error('Got HTML response: ' + text.substring(0, 200));
        }
    });
})
                    .then(data => {
                        if (data.success) {
                            // Update the rejection reason text on the page
                            const reasonText = document.getElementById('rejection-reason-text');
                            if (reasonText) {
                                reasonText.textContent = newReason || 'No reason provided';
                            }
                            return data;
                        } else {
                            throw new Error(data.message || 'Failed to update rejection reason');
                        }
                    })
                    .catch(error => {
                        console.error('Edit rejection reason error:', error);
                        Swal.showValidationMessage(
                            `Request failed: ${error.message}`
                        );
                    });
                },
                allowOutsideClick: () => !Swal.isLoading()
            }).then((result) => {
                if (result.isConfirmed && result.value) {
                    Swal.fire({
                        title: 'Success!',
                        text: result.value.message,
                        icon: 'success',
                        confirmButtonText: 'OK'
                    });
                }
            });
        });
    });

    // Your existing update status functionality...
    document.querySelectorAll('.update-status-btn').forEach(button => {
        button.addEventListener('click', function (e) {
            e.preventDefault();

            const applicationId = this.getAttribute('data-application-id');
            const statusAction = this.getAttribute('data-status-action');
            const applicantName = this.getAttribute('data-applicant-name');

            // Define dynamic SweetAlert titles and colors
            let actionText = '';
            let title = '';
            let icon = 'question';
            let confirmColor = '#3085d6';

            switch(statusAction) {
                case 'shortlisted':
                    actionText = 'shortlist';
                    title = 'Shortlist Application';
                    icon = 'info';
                    confirmColor = '#198754'; // green
                    break;
                case 'rejected':
                    actionText = 'reject';
                    title = 'Reject Application';
                    icon = 'warning';
                    confirmColor = '#d33'; // red
                    break;
            }

            Swal.fire({
                title: title,
                html: `Are you sure you want to <strong>${actionText}</strong> the application for <strong>${applicantName}</strong>?`,
                icon: icon,
                showCancelButton: true,
                confirmButtonColor: confirmColor,
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, update it!',
                cancelButtonText: 'Cancel',
                showLoaderOnConfirm: true,
         preConfirm: () => {
    const newReason = document.getElementById('editRejectionReason').value;
    
    // Get CSRF token - try multiple methods
    let csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
    if (!csrfToken) {
        csrfToken = document.querySelector('#csrf-token-edit-reason')?.value;
    }
    if (!csrfToken) {
        csrfToken = '{{ csrf_token("edit_rejection_reason") }}';
    }
    
    return fetch('{{ path("app_admin_kaaba_application_edit_rejection_reason") }}', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        credentials: 'include', // Important for sending cookies/session
        body: JSON.stringify({
            applicationId: applicationId,
            rejectionReason: newReason,
            _token: csrfToken
        })
    })
    .then(response => {
        // Check if we got HTML instead of JSON
        const contentType = response.headers.get('content-type');
        if (contentType && contentType.includes('text/html')) {
            return response.text().then(html => {
                // Check if this is a login page redirect
                if (html.includes('login') || html.includes('signin') || html.includes('form-signin')) {
                    throw new Error('Authentication required. Please log in again.');
                }
                throw new Error('Server returned HTML instead of JSON. This might be an authentication or server error.');
            });
        }
        
        if (!response.ok) {
            // Try to parse as JSON first, if that fails, throw generic error
            return response.text().then(errorText => {
                try {
                    const errorData = JSON.parse(errorText);
                    throw new Error(errorData.message || errorData.debug || `HTTP error! status: ${response.status}`);
                } catch (e) {
                    throw new Error(`HTTP error! status: ${response.status}. Response: ${errorText.substring(0, 100)}`);
                }
            });
        }
        return response.json();
    })
    .then(data => {
        if (data.success) {
            const reasonText = document.getElementById('rejection-reason-text');
            if (reasonText) {
                reasonText.textContent = newReason || 'No reason provided';
            }
            return data;
        } else {
            throw new Error(data.message || 'Failed to update rejection reason');
        }
    })
    .catch(error => {
        console.error('Edit rejection reason error:', error);
        Swal.showValidationMessage(`Request failed: ${error.message}`);
    });
},
                allowOutsideClick: () => !Swal.isLoading()
            });
        });
    });
});
</script>
{% endblock %}