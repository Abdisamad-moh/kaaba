{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Get CSRF token
            function getCsrfToken() {
                return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || 
                       '{{ csrf_token("edit_status_reason") }}';
            }

            // Helper function to get modal configuration
            function getReasonModalConfig(reasonType) {
                const config = {
                    shortlist: {
                        title: 'Edit Shortlist Reason',
                        icon: 'info',
                        confirmColor: '#0dcaf0',
                        label: 'Shortlist Reason:',
                        placeholder: 'Enter shortlist reason...'
                    },
                    approve: {
                        title: 'Edit Approval Reason',
                        icon: 'success',
                        confirmColor: '#198754',
                        label: 'Approval Reason:',
                        placeholder: 'Enter approval reason...'
                    },
                    reject: {
                        title: 'Edit Rejection Reason',
                        icon: 'warning',
                        confirmColor: '#dc3545',
                        label: 'Rejection Reason:',
                        placeholder: 'Enter rejection reason...'
                    }
                };
                return config[reasonType] || config.reject;
            }

            // Dynamic edit reason functionality
            document.querySelectorAll('.edit-reason-btn').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    const applicationId = this.getAttribute('data-application-id');
                    const reasonType = this.getAttribute('data-reason-type');
                    const currentReason = this.getAttribute('data-current-reason');
                    const applicantName = this.getAttribute('data-applicant-name');
                    
                    const config = getReasonModalConfig(reasonType);
                    
                    // Show SweetAlert for editing reason
                    Swal.fire({
                        title: config.title,
                        html: `
                            <p>Editing ${reasonType} reason for <strong>${applicantName}</strong>:</p>
                            <div class="mt-3">
                                <label for="editReason" class="form-label">${config.label}</label>
                                <textarea id="editReason" class="form-control" rows="4" 
                                    placeholder="${config.placeholder}">${currentReason}</textarea>
                            </div>
                        `,
                        icon: config.icon,
                        showCancelButton: true,
                        confirmButtonColor: config.confirmColor,
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Update Reason',
                        cancelButtonText: 'Cancel',
                        showLoaderOnConfirm: true,
                        preConfirm: () => {
                            const newReason = document.getElementById('editReason').value;
                            
                            return fetch('{{ path("app_admin_kaaba_application_edit_status_reason") }}', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-Requested-With': 'XMLHttpRequest'
                                },
                                body: JSON.stringify({
                                    applicationId: applicationId,
                                    reasonType: reasonType,
                                    reason: newReason,
                                    _token: getCsrfToken()
                                })
                            })
                            .then(response => {
                                // Handle different response types
                                const contentType = response.headers.get('content-type');
                                if (contentType && contentType.includes('text/html')) {
                                    return response.text().then(html => {
                                        if (html.includes('login') || html.includes('signin')) {
                                            throw new Error('Authentication required. Please log in again.');
                                        }
                                        throw new Error('Server returned HTML instead of JSON.');
                                    });
                                }
                                
                                if (!response.ok) {
                                    return response.text().then(errorText => {
                                        try {
                                            const errorData = JSON.parse(errorText);
                                            throw new Error(errorData.message || `HTTP error! status: ${response.status}`);
                                        } catch (e) {
                                            throw new Error(`HTTP error! status: ${response.status}`);
                                        }
                                    });
                                }
                                return response.json();
                            })
                            .then(data => {
                                if (data.success) {
                                    // Find and update the specific reason section
                                    const reasonSection = document.querySelector(
                                        `.status-reason-section[data-reason-type="${reasonType}"]`
                                    );
                                    if (reasonSection) {
                                        const reasonText = reasonSection.querySelector('.reason-text');
                                        if (reasonText) {
                                            reasonText.textContent = newReason || 'No reason provided';
                                        }
                                    }
                                    return data;
                                } else {
                                    throw new Error(data.message || 'Failed to update reason');
                                }
                            })
                            .catch(error => {
                                console.error(`Edit ${reasonType} reason error:`, error);
                                Swal.showValidationMessage(`Request failed: ${error.message}`);
                            });
                        },
                        allowOutsideClick: () => !Swal.isLoading()
                    }).then((result) => {
                        if (result.isConfirmed && result.value) {
                            Swal.fire({
                                title: 'Success!',
                                text: result.value.message,
                                icon: 'success',
                                confirmButtonText: 'OK'
                            });
                        }
                    });
                });
            });
            
            // Keep your existing update status functionality if needed
        });
    </script>
{% endblock %}