                                {% elseif application.numeracylevel == 'limited' %}{{ 'I have limited proficiency in numeracy'|trans }}
                                {% elseif application.numeracylevel == 'moderate' %}{{ 'I have moderate proficiency in numeracy'|trans }}
                                {% elseif application.numeracylevel == 'proficient' %}{{ 'I am proficient in numeracy'|trans }}
                                {% else %}{{ application.numeracylevel }}{% endif %}
                            </span>
                        {% else %}
