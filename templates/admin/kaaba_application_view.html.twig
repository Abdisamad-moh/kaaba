{% extends 'admin_base2.html.twig' %}

{% block title %}Application Review -
	{{ application.full_name }}
{% endblock %}
{% block head %}
    {{ parent() }}
    <meta name="csrf-token" content="{{ csrf_token('edit_status_reason') }}">
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		.badgia {
			white-space: normal;
			display: inline-block;
			word-break: break-word;
			text-align: left;
		}
		.document-link {
			text-decoration: none;
			transition: all 0.3s ease;
		}
		.document-link:hover {
			transform: translateY(-2px);
		}
		.status-badge {
			font-size: 0.9rem;
			padding: 0.5rem 1rem;
		}

		.edit-rejection-reason {
			font-size: 0.75rem;
			padding: 0.25rem 0.5rem;
		}

		#rejection-reason-section {
			position: relative;
		}

		#rejection-reason-section .btn {
			position: absolute;
			top: 10px;
			right: 10px;
		}
	</style>
{% endblock %}

{% block body %}
	<div class="container-fluid">
		<div class="card bg-info-subtle shadow-none position-relative overflow-hidden mb-4">
			<div class="card-body px-4 py-3">
				<div class="row align-items-center">
					<div class="col-9">
						<h4 class="fw-semibold mb-8">Application Review</h4>
						<nav aria-label="breadcrumb">
							<ol class="breadcrumb">
								<li class="breadcrumb-item">
									<a class="text-muted text-decoration-none" href="{{ path('app_admin_kaaba_applications') }}">Applications</a>
								</li>
								<li class="breadcrumb-item" aria-current="page">Application Review</li>
							</ol>
						</nav>
					</div>
					<div class="col-3">
						<div class="text-center mb-n5"></div>
					</div>
				</div>
			</div>
		</div>

		<div class="card">
			<div class="card-header text-bg-primary d-flex justify-content-between align-items-center">
				<h5 class="mb-0 text-white">Application Details</h5>

			</div>

			<form class="form-horizontal">
				<div
					class="form-body">
					<!-- Personal Information Section -->
					<div class="card-body">
						<h5 class="card-title mb-0">Personal Information</h5>
					</div>
					<hr class="m-0"/>
					<div class="card-body">
						<div class="row">
							<div class="col-md-6">
								<div class="form-group row">
									<label class="form-label text-end col-md-3">Full Name:</label>
									<div class="col-md-9">
										<p class="fw-semibold">{{ application.fullname }}</p>
									</div>
								</div>
							</div>
							<div class="col-md-6">
								<div class="form-group row">
									<label class="form-label text-end col-md-3">Gender:</label>
									<div class="col-md-9">
										<p>{{ application.gender.name ?? 'N/A' }}</p>
									</div>
								</div>
							</div>
						</div>

						<div class="row">
							<div class="col-md-6">
								<div class="form-group row">
									<label class="form-label text-end col-md-3">Date of Birth:</label>
									<div class="col-md-9">
										<p>{{ application.dateofbirth ? application.dateofbirth|date('d-m-Y') : 'N/A' }}</p>
									</div>
								</div>
							</div>
							<div class="col-md-6">
								<div class="form-group row">
									<label class="form-label text-end col-md-3">Phone:</label>
									<div class="col-md-9">
										<p>{{ application.phone }}</p>
									</div>
								</div>
							</div>
						</div>

						<div class="row">
							<div class="col-md-6">
								<div class="form-group row">
									<label class="form-label text-end col-md-3">Email:</label>
									<div class="col-md-9">
										<p>{{ application.email ?? 'N/A' }}</p>
									</div>
								</div>
							</div>
							<div class="col-md-6">
								<div class="form-group row">
									<label class="form-label text-end col-md-3">Nationality:</label>
									<div class="col-md-9">
										<p>{{ application.nationality.name ?? 'N/A' }}</p>
									</div>
								</div>
							</div>
						</div>

						<div class="row">
							<div class="col-md-6">
								<div class="form-group row">
									<label class="form-label text-end col-md-3">Disability Status:</label>
									<div class="col-md-9">
										<p>{{ application.disability ?? 'N/A' }}</p>
									</div>
								</div>
							</div>
							<div class="col-md-6">
								<div class="form-group row">
									<label class="form-label text-end col-md-3">Application Date:</label>
									<div class="col-md-9">
										<p>{{ application.applicationdate|date('d-m-Y') }}</p>
									</div>
								</div>
							</div>
						</div>

						{% if application.disability == 'Yes' or application.disabilityType %}
							<div class="row">
								<div class="col-md-6">
									<div class="form-group row">
										<label class="form-label text-end col-md-3">Disability Type:</label>
										<div class="col-md-9">
											<p>{{ application.disabilityType ?? 'N/A' }}</p>
										</div>
									</div>
								</div>
								{% if application.disabilityType == 'Other' and application.disabilityExplanation %}
									<div class="col-md-6">
										<div class="form-group row">
											<label class="form-label text-end col-md-3">Disability Explanation:</label>
											<div class="col-md-9">
												<p>{{ application.disabilityExplanation ?? 'N/A' }}</p>
											</div>
										</div>
									</div>
								{% else %}
									<div
										class="col-md-6"><!-- Empty column to maintain layout -->
									</div>
								{% endif %}
							</div>
						{% endif %}
					</div>

					<!-- Address Information Section -->
					<div class="card-body">
						<h5 class="card-title mb-0">Address Information</h5>
					</div>
					<hr class="m-0"/>
					<div class="card-body">
						<div class="row">
							<div class="col-md-6">
								<div class="form-group row">
									<label class="form-label text-end col-md-3">Region:</label>
									<div class="col-md-9">
										<p>{{ application.region.name ?? 'N/A' }}</p>
									</div>
								</div>
							</div>
							<div class="col-md-6">
								<div class="form-group row">
									<label class="form-label text-end col-md-3">District:</label>
									<div class="col-md-9">
										<p>{{ application.district.name ?? 'N/A' }}</p>
									</div>
								</div>
							</div>
						</div>

						<div class="row">

							<div class="col-md-6">
								<div class="form-group row">
									<label class="form-label text-end col-md-3">Village:</label>
									<div class="col-md-9">
										<p>{{ application.village ?? 'N/A' }}</p>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- Scholarship Information Section -->
					<div class="card-body">
						<h5 class="card-title mb-0">Scholarship Information</h5>
					</div>
					<hr class="m-0"/>
					<div class="card-body">
						<div class="row">
							<div class="col-md-6">
								<div class="form-group row">
									<label class="form-label text-end col-md-3">Scholarship:</label>
									<div class="col-md-9 mb-3">
										<p class="fw-semibold" style="padding: 0 !important; margin: 0 !important;">{{ application.scholarship.title ?? 'N/A' }}</p>
										{% if application.scholarship %}
											<small class="text-muted badge bg-info-subtle">Closing Date:
												{{ application.scholarship.closingDate|date('d-m-Y') }}</small>
										{% endif %}
									</div>
								</div>
							</div>
							{% if application.scholarship.type != 'l' %}
								<div class="col-md-6">
									<div class="form-group row">
										<label class="form-label text-end col-md-3">Institute:</label>
										<div class="col-md-9">
											<p>{{ application.institute.name ?? 'N/A' }}</p>
										</div>
									</div>
								</div>
							{% endif %}
						</div>

						<div
							class="row">
							{# Only show Course if scholarship type is NOT 'l' #}
							{% if application.scholarship.type != 'l' %}
								<div class="col-md-6">
									<div class="form-group row">
										<label class="form-label text-end col-md-3">Course:</label>
										<div class="col-md-9">
											<p>{{ application.course.name ?? 'N/A' }}</p>
										</div>
									</div>
								</div>
							{% endif %}

						</div>
					</div>


					{# Conditional Section: Literacy & Numeracy for type 'l', Academic Qualification for other types #}
					{% if application.scholarship.type == 'l' %}
						<!-- Literacy & Numeracy Section -->
						<div class="card-body">
							<h5 class="card-title mb-0">Literacy & Numeracy Assessment</h5>
						</div>
						<hr class="m-0"/>
						<div class="card-body">
							<div class="row">
								<div class="col-md-6">
									<div class="form-group row">
										<label class="form-label text-end col-md-3">Literacy Level:</label>
										<div class="col-md-9">
											<p>
												{% if application.literacylevel %}
													<span class="badge literacy-badge
																																													                                {% if application.literacylevel == 'no_skills' %}bg-danger
																																													                                {% elseif application.literacylevel == 'limited' %}bg-warning text-dark
																																													                                {% elseif application.literacylevel == 'moderate' %}bg-info
																																													                                {% elseif application.literacylevel == 'proficient' %}bg-success
																																													                                {% else %}bg-secondary{% endif %}">
														{% if application.literacylevel == 'no_skills' %}
															{{ 'I do not possess reading or writing skills'|trans }}
														{% elseif application.literacylevel == 'limited' %}
															{{ 'I have limited proficiency in reading and writing'|trans }}
														{% elseif application.literacylevel == 'moderate' %}
															{{ 'I have moderate proficiency in reading and writing'|trans }}
														{% elseif application.literacylevel == 'proficient' %}
															{{ 'I am proficient in reading and writing'|trans }}
														{% else %}
															{{ application.literacylevel }}
														{% endif %}
													</span>
												{% else %}
													N/A
												{% endif %}
											</p>
										</div>
									</div>
								</div>
								<div class="col-md-6">
									<div class="form-group row">
										<label class="form-label text-end col-md-3">Numeracy Level:</label>
										<div class="col-md-9">
											<p>
												{% if application.numeracylevel %}
													<span class="badge literacy-badge
																																													                                {% if application.numeracylevel == 'no_skills' %}bg-danger
																																													                                {% elseif application.numeracylevel == 'limited' %}bg-warning text-dark
																																													                                {% elseif application.numeracylevel == 'moderate' %}bg-info
																																													                                {% elseif application.numeracylevel == 'proficient' %}bg-success
																																													                                {% else %}bg-secondary{% endif %}">
														{% if application.numeracylevel == 'no_skills' %}
															{{ 'I do not possess basic numeracy skills'|trans }}
														{% elseif application.numeracylevel == 'limited' %}
															{{ 'I have limited proficiency in numeracy'|trans }}
														{% elseif application.numeracylevel == 'moderate' %}
															{{ 'I have moderate proficiency in numeracy'|trans }}
														{% elseif application.numeracylevel == 'proficient' %}
															{{ 'I am proficient in numeracy'|trans }}
														{% else %}
															{{ application.numeracylevel }}
														{% endif %}
													</span>
												{% else %}
													N/A
												{% endif %}
											</p>
										</div>
									</div>
								</div>
							</div>

							<div class="row">
								<div class="col-md-6">
									<div class="form-group row">
										<label class="form-label text-end col-md-3">Recent Education:</label>
										<div class="col-md-9">
											<p>{{ application.recenteducation ?? 'N/A' }}</p>
										</div>
									</div>
								</div>
								<div class="col-md-6">
									<div class="form-group row">
										<label class="form-label text-end col-md-3">Literacy & Numeracy Qualification:</label>
										<div class="col-md-9">
											<p>{{ application.literacynumeracyqualification ?? 'N/A' }}</p>
										</div>
									</div>
								</div>
							</div>
						</div>
					{% else %}
						<!-- Academic Qualification Section -->
						<div class="card-body">
							<h5 class="card-title mb-0">Academic Qualification</h5>
						</div>
						<hr class="m-0"/>
						<div class="card-body">
							<div class="row">
								<div class="col-md-6">
									<div class="form-group row">
										<label class="form-label text-end col-md-3">Certificate Type:</label>
										<div class="col-md-9">
											<p>
												{% if application.secondaryschool == 'Secondary Certificate' %}
													<span class="badge bg-primary">{{ application.secondaryschool ?? 'N/A' }}</span>
												{% elseif application.secondaryschool == 'Primary Certificate' %}
													<span class="badge bg-info">{{ application.secondaryschool ?? 'N/A' }}</span>
												{% elseif application.secondaryschool == 'Other Certificates' %}
													<span class="badge bg-secondary">{{ application.secondaryschool ?? 'N/A' }}</span>
												{% else %}
													{{ application.secondaryschool ?? 'N/A' }}
												{% endif %}
											</p>
										</div>
									</div>
								</div>
								<div class="col-md-6">
									<div class="form-group row">
										<label class="form-label text-end col-md-3">Graduation Year:</label>
										<div class="col-md-9">
											<p>{{ application.secondarygraduationyear ?? 'N/A' }}</p>
										</div>
									</div>
								</div>
							</div>

							<div class="row">
								<div class="col-md-6">
									<div class="form-group row">
										<label class="form-label text-end col-md-3">Grade/Score:</label>
										<div class="col-md-9">
											<p>{{ application.secondarygrade ?? 'N/A' }}</p>
										</div>
									</div>
								</div>
								<div
									class="col-md-6"><!-- Empty column for layout balance -->
								</div>
							</div>
						</div>
					{% endif %}

					<!-- Documents Section -->
					<div class="card-body">
						<h5 class="card-title mb-0">Supporting Documents</h5>
					</div>
					<hr class="m-0"/>
					<div class="card-body">
						<div class="row">
							<div class="col-md-6">
								<div class="form-group row">
									<label class="form-label text-end col-md-3">Identity Type:</label>
									<div class="col-md-9">
										<p>{{ application.identitytype.name ?? 'N/A' }}</p>
									</div>
								</div>
							</div>
							<div class="col-md-6">
								<div class="form-group row">
									<label class="form-label text-end col-md-3">Identity Attachment:</label>
									<div class="col-md-9">
										{% if application.identityattachment %}
											<a href="{{ path('app_application_attachments', {'filename': application.identityattachment}) }}" target="_blank" class="btn btn-primary btn-sm document-link">
												<i class="ti ti-file-text me-1"></i>
												View Identity Document
											</a>
										{% else %}
											<p class="text-muted">No identity attachment</p>
										{% endif %}
									</div>
								</div>
							</div>
						</div>

						<div class="row">
							<div class="col-md-6">
								<div class="form-group row">
									<label class="form-label text-end col-md-3">Certificate Attachment:</label>
									<div class="col-md-9">
										{% if application.certificateattachment %}
											<a href="{{ path('app_application_attachments', {'filename': application.certificateattachment}) }}" target="_blank" class="btn btn-info btn-sm document-link">
												<i class="ti ti-certificate me-1"></i>
												View Certificate
											</a>
										{% else %}
											<p class="text-muted">No certificate attachment</p>
										{% endif %}
									</div>
								</div>
							</div>

						</div>

						<!-- Declaration Section -->
						<div class="card-body">
							<h5 class="card-title mb-0">Declaration</h5>
						</div>
						<hr class="m-0"/>
						<div class="card-body">
							<div class="row">
								<div class="col-md-6">
									<div class="form-group row">
										<label class="form-label text-end col-md-3">Declaration Accepted:</label>
										<div class="col-md-9">
											<div class="d-flex align-items-center">
												<i class="ti ti-check text-success me-2 fs-5"></i>
												<span class="fw-semibold text-success">Yes</span>
											</div>
											<small class="text-muted">Applicant accepted the declaration</small>
										</div>
									</div>
								</div>
								<div class="col-md-6">
									<div class="form-group row">
										<label class="form-label text-end col-md-3">Accepted on:</label>
										<div class="col-md-9">
											<p>{{ application.applicationdate|date('d-m-Y') }}</p>
										</div>
									</div>
								</div>
							</div>

							<div class="row">
								<div class="col-md-6">
									<div class="form-group row">
										<label class="form-label text-end col-md-3">Declaration Statement:</label>
										<div class="col-md-9">
											<div class="border rounded-2 p-3 bg-light">
												<p class="mb-0" style="font-size: 14px; line-height: 1.5;">
													I hereby affirm that all information provided in this application form is true, accurate, and complete to the best of my knowledge. I further express my earnest commitment to fully engage with the learning opportunity offered through this scholarship. Due to financial constraints, I have been unable to pursue studies at other institutions, and I am therefore sincerely motivated to benefit from this program.
												</p>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>

					<!-- Status Information Section -->
<div class="card-body">
    <h5 class="card-title mb-0">Application Status</h5>
</div>
<hr class="m-0"/>
<div class="card-body">
    <div class="row">
        <div class="col-12">
            <div class="d-flex align-items-center mb-3">
                <strong class="me-3">Current Status:</strong>
                <span class="status-badge badge
                    {% if application.status.name|lower in ['approved', 'accepted'] %}bg-success
                    {% elseif application.status.name|lower == 'rejected' %}bg-danger
                    {% elseif application.status.name|lower == 'applied' %}bg-primary
                    {% elseif application.status.name|lower == 'shortlisted' %}bg-info text-white
                    {% elseif application.status.name|lower == 'waitlisted' %}bg-warning text-white
                    {% else %}bg-secondary{% endif %}">
                    {% if application.status.name|lower == 'approved' %}approved
                    {% else %}
                        {{ application.status.name|lower }}
                    {% endif %}
                </span>
            </div>

            {# Shortlist Reason - only show for shortlisted status #}
            {% if application.status.name|lower == 'shortlisted' %}
                <div class="alert alert-info mt-3 status-reason-section" data-reason-type="shortlist">
                    <div class="d-flex align-items-start">
                        <i class="ti ti-info-circle text-info me-2 mt-1 fs-5"></i>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong>Shortlist Reason:</strong>
                                <button type="button" class="btn btn-outline-dark btn-sm edit-reason-btn" 
                                    data-application-id="{{ application.id }}" 
                                    data-reason-type="shortlist"
                                    data-current-reason="{{ application.shortlistreason ?? '' }}" 
                                    data-applicant-name="{{ application.fullname }}">
                                    <i class="ti ti-edit me-1"></i>
                                    Edit Reason
                                </button>
                            </div>
                            <p class="mb-0 mt-1 reason-text">
                                {{ application.shortlistreason ?: 'No reason provided' }}
                            </p>
                            {% if application.shortlisteddate %}
                                <small class="text-muted">Shortlisted on: {{ application.shortlisteddate|date('d-m-Y H:i') }}</small>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Approval Reason - only show for approved status #}
            {% if application.status.name|lower == 'approved' %}
                <div class="alert alert-success mt-3 status-reason-section" data-reason-type="approve">
                    <div class="d-flex align-items-start">
                        <i class="ti ti-check text-success me-2 mt-1 fs-5"></i>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong>Approval Reason:</strong>
                                <button type="button" class="btn btn-outline-dark btn-sm edit-reason-btn" 
                                    data-application-id="{{ application.id }}" 
                                    data-reason-type="approve"
                                    data-current-reason="{{ application.approvedreason ?? '' }}" 
                                    data-applicant-name="{{ application.fullname }}">
                                    <i class="ti ti-edit me-1"></i>
                                    Edit Reason
                                </button>
                            </div>
                            <p class="mb-0 mt-1 reason-text">
                                {{ application.approvedreason ?: 'No reason provided' }}
                            </p>
                            {% if application.accepteddate %}
                                <small class="text-muted">Approved on: {{ application.accepteddate|date('d-m-Y H:i') }}</small>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}

            {# Rejection Reason - only show for rejected status #}
            {% if application.status.name|lower == 'rejected' %}
                <div class="alert alert-danger mt-3 status-reason-section" data-reason-type="reject">
                    <div class="d-flex align-items-start">
                        <i class="ti ti-alert-circle text-danger me-2 mt-1 fs-5"></i>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong>Rejection Reason:</strong>
                                <button type="button" class="btn btn-outline-dark btn-sm edit-reason-btn" 
                                    data-application-id="{{ application.id }}" 
                                    data-reason-type="reject"
                                    data-current-reason="{{ application.rejectionreason ?? '' }}" 
                                    data-applicant-name="{{ application.fullname }}">
                                    <i class="ti ti-edit me-1"></i>
                                    Edit Reason
                                </button>
                            </div>
                            <p class="mb-0 mt-1 reason-text">
                                {{ application.rejectionreason ?: 'No reason provided' }}
                            </p>
                            {% if application.rejecteddate %}
                                <small class="text-muted">Rejected on: {{ application.rejecteddate|date('d-m-Y H:i') }}</small>
                            {% endif %}
                        </div>
                    </div>
                </div>
