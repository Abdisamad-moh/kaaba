<section class="bg-white big-section">
    <div class="container position-relative" id="contact-us">
        <div class="row justify-content-center text-center">
            <div class="col-12 md-mb-40px">
                <h3 class="text-dark-gray fw-500 ls-minus-1px">Feedback and Support</h3>
                <p class="text-dark-gray opacity-7">Submit complaints, ask questions, or track applications with full transparency</p>
            </div>
        </div>
        <div class="col-lg-10 offset-xl-1">
            <form action="#" method="post" class="row row-cols-1 row-cols-md-2 justify-content-center">
                <div class="col mb-30px">
                    <input class="border-color-dark-gray placeholder-dark-gray form-control required" type="text" name="name" placeholder="Your name*" />
                </div>
                <div class="col mb-30px">
                    <input class="border-color-dark-gray placeholder-dark-gray form-control" type="tel" name="phone" placeholder="Your phone" />
                </div>
                <div class="col mb-30px">
                    <input class="border-color-dark-gray placeholder-dark-gray form-control required" type="email" name="email" placeholder="Your email address*" />
                </div>
                <div class="col sm-mb-30px">
                    <input class="border-color-dark-gray placeholder-dark-gray form-control" type="text" name="subject" placeholder="Your subject" />
                </div>
                <div class="col-md-12">
                    <textarea class="border-color-dark-gray placeholder-dark-gray form-control" cols="40" rows="4" name="comment" placeholder="Your message"></textarea>
                    <div class="text-center">
                        <input type="hidden" name="redirect" value="">
                        <button class="btn btn-medium btn-dark-gray mt-30px btn-round-edge submit fw-700">Send message</button>
                        <div class="form-results mt-20px d-none"></div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>



{% endblock %}