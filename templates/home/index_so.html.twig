{% extends 'base.html.twig' %}

{% block title %}Mashruuca Rajo Kaaba{% endblock %}
{% block stylesheets %}
    {{ parent() }}

<style>
    :root {
        --yellow: #FFC107;
        --yellow-light: #FFF3CD;
        --yellow-dark: #E6AC00;
        --green: #28A745;
        --green-light: #D4EDDA;
        --green-dark: #1E7E34;
        --red: #DC3545;
        --red-light: #F8D7DA;
        --red-dark: #C82333;
        --gray: #6C757D;
        --gray-light: #F8F9FA;
        --gray-dark: #343A40;
        --border-radius: 16px;
        --shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Updated header styling */
    #eligibility h1 {
        font-size: 3rem !important;
        font-weight: 800 !important;
        background: linear-gradient(90deg, var(--yellow), var(--green), var(--red)) !important;
        -webkit-background-clip: text !important;
        background-clip: text !important;
        color: transparent !important;
        margin-bottom: 15px !important;
        letter-spacing: -0.5px !important;
        position: relative !important;
        display: inline-block !important;
        padding-bottom: 15px !important;
    }

    #eligibility h1::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 150px;
        height: 4px;
        background: linear-gradient(90deg, var(--yellow), var(--green), var(--red));
        border-radius: 2px;
    }

    #eligibility .subtitle {
        font-size: 1.2rem !important;
        color: var(--gray) !important;
        max-width: 700px !important;
        margin: 25px auto 0 !important;
        font-weight: 400 !important;
        line-height: 1.6 !important;
    }

    /* Components container spacing */
    #eligibility .components-container {
        margin-top: 30px !important;
        margin-bottom: 40px !important;
    }

    /* Component Card Styles - Updated borders */
    .component-card {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--shadow);
        overflow: hidden;
        transition: var(--transition);
        height: 100%;
        position: relative;
    }

    /* Different border colors for each card */
    .component-card:first-of-type {
        border-top: 5px solid var(--yellow) !important;
    }

    .component-card:nth-of-type(2) {
        border-top: 5px solid var(--green) !important;
    }

    .component-card:nth-of-type(3) {
        border-top: 5px solid var(--red) !important;
    }

    .component-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
    }

    /* Card header adjustments */
    .card-header {
        padding: 25px 30px 20px 30px !important;
        background: white;
        position: relative;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .card-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        font-size: 1.8rem;
        color: white;
    }

    /* Icon colors */
    .component-card:first-of-type .card-icon {
        background: linear-gradient(135deg, var(--yellow), var(--yellow-dark)) !important;
    }

    .component-card:nth-of-type(2) .card-icon {
        background: linear-gradient(135deg, var(--green), var(--green-dark)) !important;
    }

    .component-card:nth-of-type(3) .card-icon {
        background: linear-gradient(135deg, var(--red), var(--red-dark)) !important;
    }

    .card-title {
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 8px;
    }

    /* Title colors */
    .component-card:first-of-type .card-title {
        color: var(--yellow-dark) !important;
    }

    .component-card:nth-of-type(2) .card-title {
        color: var(--green-dark) !important;
    }

    .component-card:nth-of-type(3) .card-title {
        color: var(--red-dark) !important;
    }

    .card-subtitle {
        font-size: 1rem;
        line-height: 1.5;
        color: var(--gray) !important;
    }

    .card-body {
        padding: 25px 30px 30px 30px !important;
    }

    /* Tag Styles - Updated */
    .tag-container {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 20px !important;
    }

    .tag {
        padding: 8px 16px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 2px solid transparent;
        background: var(--yellow-light) !important;
        color: var(--yellow-dark) !important;
white-space: nowrap !important;
    }

    .tag.bg-green-light,
    .tag:nth-child(2) {
        background: var(--green-light) !important;
        color: var(--green-dark) !important;
        border-color: var(--green) !important;
    }

    .tag.bg-red-light,
    .tag:nth-child(3) {
        background: var(--red-light) !important;
        color: var(--red-dark) !important;
        border-color: var(--red) !important;
    }

    /* Requirement Item Styles */
    .requirements-list {
        margin-bottom: 20px !important;
    }

    .requirement-item {
        display: flex;
        align-items: flex-start;
        margin-bottom: 15px !important;
        padding: 15px;
        border-radius: 10px;
        transition: var(--transition);
        background: var(--gray-light) !important;
    }

    .requirement-item:hover {
        background: rgba(0, 0, 0, 0.02);
        transform: translateX(5px);
    }

    .requirement-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        flex-shrink: 0;
        color: white;
        font-size: 1rem;
        font-weight: bold;
    }

    /* Icon color classes */
    .requirement-icon.bg-yellow-gradient,
    .requirement-icon:nth-child(1) {
        background: linear-gradient(135deg, var(--yellow), var(--yellow-dark)) !important;
    }

    .requirement-icon.bg-green-gradient {
        background: linear-gradient(135deg, var(--green), var(--green-dark)) !important;
    }

    .requirement-icon.bg-red-gradient {
        background: linear-gradient(135deg, var(--red), var(--red-dark)) !important;
    }

    /* Note Box Styles - Updated */
    .note-box {
        padding: 20px !important;
        border-radius: 12px;
        margin-top: 20px !important;
        border-left: 4px solid var(--yellow) !important;
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #fff9e6, #fff3cd) !important;
    }

    /* Specific note box colors */
    .component-card:nth-of-type(2) .note-box {
        border-left-color: var(--green) !important;
        background: linear-gradient(135deg, #d4edda, #c3e6cb) !important;
    }

    .component-card:nth-of-type(3) .note-box {
        border-left-color: var(--red) !important;
        background: linear-gradient(135deg, #f8d7da, #f5c6cb) !important;
    }

    .note-title {
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 1.1rem;
        color: #856404 !important;
        font-weight: 700 !important;
    }

    /* Note title colors */
    .component-card:nth-of-type(2) .note-title {
        color: var(--green-dark) !important;
    }

    .component-card:nth-of-type(3) .note-title {
        color: var(--red-dark) !important;
    }

    .note-text {
        font-size: 0.95rem;
        line-height: 1.5;
        color: #856404 !important;
    }

    /* Note text colors */
    .component-card:nth-of-type(2) .note-text {
        color: var(--green-dark) !important;
    }

    .component-card:nth-of-type(3) .note-text {
        color: var(--red-dark) !important;
    }

    /* Track Card Styles */
    .track-container {
        display: grid !important;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)) !important;
        gap: 15px !important;
        margin-top: 20px !important;
        margin-bottom: 20px !important;
    }

    .track-card {
        background: white;
        border-radius: 10px;
        padding: 20px;
        border: 2px solid var(--yellow-light);
        transition: var(--transition);
    }

    .track-card:hover {
        border-color: var(--yellow);
        transform: translateY(-3px);
    }

    .track-title {
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--yellow-dark) !important;
        font-weight: 600 !important;
    }

    .track-card:nth-child(2) .track-title {
        color: var(--red-dark) !important;
    }

    .track-desc {
        font-size: 0.9rem;
        line-height: 1.5;
        color: var(--gray) !important;
    }

    /* Shimmer animation for note boxes */
    .note-box::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
        transform: translateX(-100%);
    }

    .note-box:hover::before {
        animation: shimmer 1.5s infinite;
    }

    @keyframes shimmer {
        100% {
            transform: translateX(100%);
        }
    }

    /* Add footer styling */
    #eligibility + footer {
        text-align: center;
        padding: 30px 0 !important;
        color: var(--gray);
        font-size: 0.9rem;
        border-top: 1px solid rgba(0, 0, 0, 0.08);
        margin-top: 30px;
    }

    #eligibility + footer .footer-highlight {
        color: var(--yellow-dark);
        font-weight: 600;
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
        #eligibility h1 {
            font-size: 2.2rem !important;
        }
        
        #eligibility .subtitle {
            font-size: 1.1rem !important;
            padding: 0 15px !important;
        }
        
        .card-header, .card-body {
            padding: 20px !important;
        }
        
        .tag-container {
            justify-content: center;
        }
        
        .track-container {
            grid-template-columns: 1fr !important;
        }
        
        #eligibility .components-container {
            margin-top: 20px !important;
        }
    }
</style>
{% endblock %}

{% block body %}
	<!-- start banner -->
		<section class="cover-background full-screen bg-dark-gray ipad-top-space-margin position-relative section-dark md-h-auto">

			<div id="particles-style-01" class="h-100 position-absolute left-0px top-0 w-100" style="background: #1212;"></div>
			<div class="container h-100">
				<div class="row align-items-center justify-content-center h-100">
					<div class="col-xl-7 col-lg-8 col-md-10 text-white position-relative text-center text-lg-start">
						<div class="fs-90 sm-fs-80 xs-fs-70 fw-600 mb-20px ls-minus-4px overflow-hidden">
							<div class="d-inline-block" data-anime='{ "translateY": [100, 0], "easing": "easeOutCubic", "duration": 900 }'>
								Mashruuca Rajo Kaaba
							</div>
						</div>
						<div class="fs-30 fw-300 mb-30px w-80 sm-w-100 d-block mx-auto mx-lg-0 overflow-hidden">
							<span class="d-inline-block lh-32 text-white" data-anime='{ "translateY": [100, 0], "easing": "easeOutCubic", "duration": 900, "delay": 300 }'>Kobcinta haweenka iyada oo loo marayo waxbarasho iyo xirfado.</span>
						</div>
						<div class="overflow-hidden pt-5px">
							<a href="#about-us" class="btn btn-extra-large btn-yellow btn-rounded btn-box-shadow btn-switch-text d-inline-block me-15px xs-m-10px align-middle fw-600" data-anime='{ "translateY": [100, 0], "easing": "easeOutCubic", "duration": 900, "delay": 500 }'>
								<span>
									<span class="btn-double-text" data-text="Bilow">Bilow
</span>
									<span>
										<i class="feather icon-feather-arrow-right"></i>
									</span>
								</span>
							</a>

						</div>
					</div>
					<div class="col-xl-5 col-lg-4">
						<div class="outside-box-right-7 position-relative text-center" data-anime='{ "opacity": [0, 1], "translateY": [100, 0], "easing": "easeOutQuad", "duration": 1200, "delay": 200 }'>
							<!--  <img class="w-100" src="https://placehold.co/724x792" alt="">-->
							<!-- <img class="w-100 position-absolute left-minus-2px top-minus-5px animation-float" src="https://placehold.co/724x792" alt="">-->
							<img class="sm-w-50 w-100" src="{{ asset('assets/images/hero-logo.png') }}" alt="" style="max-width: 80% !important;">
						</div>
					</div>
				</div>
			</div>
		</section>
		<!-- end banner -->

		<!-- start section -->
		<section class="about-us-section" id="about-us">
			<div class="container">
				<div class="row mb-8 align-items-center">
				
					<div class="col-xl-12 col-lg-12 text-center" data-anime='{ "el": "childs", "translateY": [30, 0], "opacity": [0,1], "duration": 600, "delay": 0, "staggervalue": 300, "easing": "easeOutQuad" }'>
						<h2 class="text-dark-gray fw-600 ls-minus-3px alt-font highlight-separator-small">Nagu Saabsan</h2>
						<p class="w-100">Wasaaradda Waxbarashada iyo Sayniska (MoES), iyada oo ay u sii marayso Unugga Hirgelinta Mashruuca (PIU), waxay hadda kormeeraysaa hirgelinta Mashruuca “Somaliland Empowering Women through Education and Skills” – Rajo Kaaba (Lambarka Mashruuca: P176898). Mashruucan waxaa loo sameeyay in lagu taageero haweenka Soomaaliyeed, gaar ahaan da’da u dhaxaysa 15 ilaa 35 sano, iyada oo loo marayo kor u qaadidda fursadaha waxbarasho tayo leh iyo tababbar xirfadeed.</p>


					</div>
				</div>

			</div>
		</section>
		<!-- end section -->


		<section class="bg-light background-position-center-top overlap-height number-section">
			<div class="container">
				<div class="row align-items-center justify-content-center mb-2 sm-mb-50px position-relative">

					<div class="col-lg-5 offset-lg-1 last-paragraph-no-margin" data-anime='{ "el": "childs", "opacity": [0, 1], "rotateY": [-90, 0], "rotateZ": [-10, 0], "translateY": [80, 0], "translateZ": [50, 0], "staggervalue": 200, "duration": 900, "delay": 300, "easing": "easeOutCirc" }'>
						<span class="text-base-color fw-600 mb-15px text-uppercase d-block">Ujeeddooyinka</span>
						<h2 class="fw-600 text-dark-gray w-90 lg-w-100 text-dark-gray fw-700 ls-minus-2px">Ujeeddooyinka Mashruuca Rajo Kaaba:</h2>

					</div>
				</div>

				<div class="row">

					<div class="col-xxl-4 col-lg-4" data-anime='{ "el": "childs", "translateY": [30, 0], "opacity": [0,1], "duration": 300, "delay": 0, "staggervalue": 300, "easing": "easeOutQuad" }'>
						<div class="mb-60px sm-mb-30px last-paragraph-no-margin">
							<span class="d-inline-block fs-15 text-uppercase fw-700 text-black mb-5px">In la xoojiyo haweenka iyo gabdhaha dhallinyarada ah iyada oo loo marayo waxbarashada aasaasiga ah iyo horumarinta xirfadaha:</span>
							<p>Mashruucu wuxuu u oggolaanayaa gabdhaha iyo haweenka dhallinyarada ah in ay helaan waxbarasho aasaasi ah oo ku saabsan akhris-qoris iyo xisaab, xirfado nololeed iyo bulsho, iyo tababbar xirfadeed heer gelitaan ah. Ujeeddadu waa in la dhiirrigeliyo ka-qaybgalka dhaqaale iyo in la hagaajiyo fursadaha nolosha ee muddada dheer, gaar ahaan kuwa si taariikhi ah uga maqnaa waxbarashada rasmiga ah iyo suuqyada shaqada.</p>
						</div>

					</div>
					<div class="col-xxl-3 col-lg-3 " data-anime='{ "el": "childs", "translateY": [30, 0], "opacity": [0,1], "duration": 300, "delay": 0, "staggervalue": 300, "easing": "easeOutQuad" }'>
						<div class="mb-60px sm-mb-30px last-paragraph-no-margin">
							<span class="d-inline-block fs-15 text-uppercase fw-700 text-black mb-5px">In la ballaariyo fursadaha loo heli karo Barashada Xirfadaha Farsamada iyo Teknolojiyadda (TVET):</span>
							<p>Mashruucu wuxuu kor u qaadayaa helitaanka barnaamijyada TVET, isagoo si gaar ah diiradda u saaraya dhallinyarada, gaar ahaan haweenka, iyada oo la bixinayo xirfado la jaanqaadaya baahida suuqyada shaqada, lana xoojinayo awoodda hay’adaha waxbarashada si ay u daboolaan baahiyaha shaqo ee dalka.</p>
						</div>
					</div>
					<div class="col-xxl-2 col-lg-2 " data-anime='{ "el": "childs", "translateY": [30, 0], "opacity": [0,1], "duration": 300, "delay": 0, "staggervalue": 300, "easing": "easeOutQuad" }'>
						<div class="mb-60px sm-mb-30px last-paragraph-no-margin">
							<span class="d-inline-block fs-15 text-uppercase fw-700 text-black mb-5px">In la xoojiyo tayada tababarka macallimiinta heerka dugsiga hoose:</span>
							<p>Mashruucu wuxuu kor u qaadayaa heerarka waxbaridda si loo hagaajiyo natiijooyinka waxbarasho ee ardayda dalka oo dhan.
</p>
						</div>
					</div>
					<div class="col-xxl-3 col-lg-3 " data-anime='{ "el": "childs", "translateY": [30, 0], "opacity": [0,1], "duration": 300, "delay": 0, "staggervalue": 300, "easing": "easeOutQuad" }'>
						<div class="mb-60px sm-mb-30px last-paragraph-no-margin">
							<span class="d-inline-block fs-15 text-uppercase fw-700 text-black mb-5px">In la horumariyo adeegyada caafimaadka hooyada iyo dhallaanka:</span>
							<p>Mashruucu wuxuu xoojinayaa nidaamka caafimaadka iyada oo la horumarinayo awoodda hay’adaha waxbarashada kalkaalinta iyo umulisooyinka. Tani waxay gacan ka geysan doontaa kor u qaadidda tayada adeegyada caafimaadka iyo natiijooyinka caafimaad ee gobollada aan si wanaagsan loo adeegsan.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>
		<!-- end section -->

<!-- Eligibility section start-->
<section class="bg-white" id="eligibility">
